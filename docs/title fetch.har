          "content": {
            "mimeType": "text/html",
            "size": 78874,
            "text": "<script id=\"ST.Cloud.JoinModal\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        Community Registration\r\n    </div>\r\n\r\n    <div class=\"st-cloud-registration-modal\">\r\n        <p>Welcome to the Synergy Community!  Your email address and basic user information are automatically entered for you in the Synergy Community.</p>\r\n\r\n        {{#districtMessage}}<p>{{.}}</p>{{/districtMessage}}\r\n\r\n        <p>To complete the user registration and begin enjoying the features of sharing and downloading content created by other users, including Reports,\r\n        ST Queries, Workflows and more, please select your primary job roles from the list below.  You will be able to modify these roles from within community.</p>\r\n\r\n        <div class=\"st-roles-autocomplete roles-container\">\r\n            <div class=\"st-dropdown input-group input\">\r\n                <div class=\"form-control st-widget-input\">\r\n                    <span class=\"roles-list\"></span>\r\n                    <input autocomplete=\"off\" class=\"form-control\" name=\"filter\" />\r\n                </div>\r\n                <div class=\"st-dropdown-btn input-group-addon\">\r\n                    <span class=\"caret\"></span>\r\n                </div>\r\n            </div>\r\n            <div class=\"error-mandatory-msg\">Roles is a required field</div>\r\n        </div>\r\n\r\n        <br />\r\n        <button type=\"button\" class=\"btn btn-lg btn-warning\" data-action=\"Cloud.SubmitRegistration\">Complete Synergy Community Registration</button>\r\n    </div>\r\n\r\n    <div class=\"controls\">\r\n        <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">I will register later</button>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Cloud.RoleItem\" type=\"text/html\">\r\n    <label class=\"st-autocomplete-item\">\r\n        <input type=\"checkbox\" autocomplete=\"off\" value=\"{{value}}\" /> <span class=\"description\">{{desc}}</span>\r\n    </label>\r\n</script>\r\n\r\n<script id=\"ST.CloudGrid\" type=\"text/html\">\r\n    <div class=\"panel panel-default Collapsible ST_CLOUD_GRID\" data-boid=\"{{@PRIMARY_OBJECT}}\" data-guid=\"{{@GUID}}\" style=\"{{#@WIDTH}}min-width:{{.}};{{/@WIDTH}}\">\r\n        <div class=\"panel-heading no-select\">\r\n            <span class=\"title\">{{{@LABEL}}}</span>\r\n            <div class=\"btn-group btn-group-xs pull-right\"></div>\r\n            <div style=\"clear:both\"></div>\r\n        </div>\r\n        <div class=\"panel-body\">\r\n            <div class=\"scrolling-table-container\">\r\n                <div class=\"scrolling-table-header\">\r\n                    <table class=\"table table-responsive table-bordered table-striped\">\r\n                        <thead>\r\n                            <tr>\r\n                                <th data-action=\"CloudGrid.ClearSelectedRows\"></th>\r\n                                {{#COLUMNS}}\r\n                                {{#REV_ITEM}}\r\n                                <th>{{@LABEL}}</th>\r\n                                {{/REV_ITEM}}\r\n                                {{/COLUMNS}}\r\n\r\n                                {{#@SHOW_RATINGS}}\r\n                                <th>Rating</th>\r\n                                {{/@SHOW_RATINGS}}\r\n\r\n                                {{#@SHOW_DOWNLOADS}}\r\n                                <th>Downloads</th>\r\n                                {{/@SHOW_DOWNLOADS}}\r\n                            </tr>\r\n                        </thead>\r\n                    </table>\r\n                </div>\r\n                <div class=\"scrolling-table-content\" style=\"{{#@HEIGHT}}height:{{.}};{{/@HEIGHT}}\">\r\n                    <table class=\"table table-responsive table-bordered table-striped\">\r\n                        <tbody></tbody>\r\n                        <tfoot>\r\n                            <tr>\r\n                                <td colspan=\"100\" style=\"text-align:center; vertical-align:middle; padding: 32px;\">\r\n                                    <img src=\"Images/ST/loading.gif\" alt=\"Loading\" /><br />\r\n                                    <span>Please Wait...</span>\r\n                                </td>\r\n                            </tr>\r\n                        </tfoot>\r\n                    </table>\r\n\r\n                    <button type=\"button\" class=\"btn btn-default\" style=\"width:100%;\" data-action=\"CloudGrid.GetMoreResults\">\r\n                        More...\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Cloud.RatingLevels\" type=\"text/html\">\r\n    {{#ratingsBreakdown}}\r\n    <div class=\"rating-breakdown\" style=\"display:table; width:100%;\">\r\n        <div class=\"st-rating-levels\" style=\"display:table-cell\">\r\n            {{#levels}}\r\n                {{#RatingLevel}}\r\n                <div class=\"rating-level\" data-level=\"{{levelValue}}\" data-toggle=\"tooltip\" title=\"{{tooltip}}\" data-action=\"Cloud.Rating.Modal.FilterCommentsByLevel\">\r\n                    <div style=\"padding-right:3px;\" >{{displayTitle}}</div>\r\n                    <div>\r\n                        <div class=\"progress-bar\">\r\n                            <span class=\"progress-indicator\" style=\"width:{{ratingPctValue}}%\"></span>\r\n                        </div>\r\n                    </div>\r\n                    <div>&nbsp;{{ratingPctValue}}%</div>\r\n                </div>\r\n                {{/RatingLevel}}\r\n            {{/levels}}\r\n            <div>\r\n                <div class=\"see-all-reviews\" data-action=\"Cloud.Rating.Modal.SeeAllReviews\" style=\"display:table-cell\">See All Reviews</div>\r\n            </div>\r\n        </div>\r\n        <div class=\"community-rating\" style=\"display:table-cell; vertical-align: middle\">\r\n            {{>ST.Controls.Rating}}\r\n            <div class=\"rating-total\">\r\n                {{ratingTotalMessage}}\r\n            </div>\r\n        </div>\r\n    </div>\r\n    {{/ratingsBreakdown}}\r\n</script>\r\n\r\n\r\n<script id=\"ST.Cloud.Comments\" type=\"text/html\">\r\n    {{#otherUserComments}}\r\n    {{#CommentInfo}}\r\n    <div class=\"comment\" data-guid=\"{{guid}}\" style=\"padding-bottom:5px\">\r\n        <div class=\"comment-header\">\r\n            {{>ST.Controls.Rating}} <div class=\"comment-title\" style=\"font-weight:bold; display:inline-block\">{{#commentTitle}}{{.}}{{/commentTitle}}{{^commentTitle}}{{defaultCommentTitle}}{{/commentTitle}}</div>\r\n        </div>\r\n        <div class=\"user-info\">\r\n            By {{userName}} on {{timestamp}}\r\n        </div>\r\n        <div class=\"comment-body\">    \r\n            {{comment}}\r\n        </div>\r\n    </div>\r\n    {{/CommentInfo}}\r\n    {{/otherUserComments}}\r\n    {{^otherUserComments}}\r\n    <div>(No user ratings)</div>\r\n    {{/otherUserComments}}\r\n</script>\r\n\r\n<script id=\"ST.Cloud.Rating.Modal\" type=\"text/html\">\r\n    <div class=\"st-rating-modal\" data-boid=\"{{boid}}\" data-identity=\"{{identity}}\" data-clicked-src-name=\"{{srcName}}\" style=\"width:600px\">\r\n        <div class=\"my-ratings\">\r\n            {{#myCommentInfo}}\r\n            <h4 class=\"my-rating-title\">My Rating</h4>\r\n            {{>ST.Controls.Rating}}<br />\r\n            <div class=\"my-comment-area hidden\">\r\n                <textarea class=\"myComment\" placeholder=\"Write a comment\" style=\"width:100%\">{{comment}}</textarea><br />\r\n                <input class=\"myCommentTitle\" autocomplete=\"off\" value=\"{{commentTitle}}\" placeholder=\"Write a headline for your comment\" style=\"width:100%\"/><br /><br />\r\n                <button type=\"button\" class=\"btn btn-success\" data-action=\"Cloud.Rating.Modal.PostReview\" data-boid=\"{{boid}}\" data-identity=\"{{identity}}\"> \r\n                    {{#comment}}\r\n                    Update Review\r\n                    {{/comment}}\r\n                    {{^comment}}\r\n                    Post Review\r\n                    {{/comment}}\r\n                </button>\r\n            </div>\r\n            {{/myCommentInfo}}\r\n        </div>\r\n        <hr/>\r\n        {{>ST.Cloud.Rating.Modal.CommunityRatings}}\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Cloud.Rating.Modal.CommunityRatings\" type=\"text/html\">\r\n    <div class=\"community-ratings\">\r\n        <h4 class=\"community-ratings-title\">Community Ratings</h4>\r\n        <div>\r\n            {{>ST.Cloud.RatingLevels}}\r\n        </div>\r\n        <hr />\r\n        <div class=\"comment-list\">\r\n            <div class=\"comments\" style=\"height:200px; overflow-y: scroll;\">\r\n                {{>ST.Cloud.Comments}}\r\n            </div>\r\n            <br />\r\n            <div class=\"more\">\r\n                <button id=\"ShowMoreCommentsBtn\" type=\"button\" class=\"btn btn-default\" data-action=\"Cloud.Rating.Modal.ShowMoreComments\">Show More...</button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n\r\n<script id=\"ST.Cloud.Rating.Popover\" type=\"text/html\">\r\n    {{#ratingsBreakdown}}\r\n    <div class=\"rating-popover\">\r\n        <div class=\"st-rating-levels\">\r\n            <div class=\"rating-total\">\r\n                {{ratingTotalMessage}}\r\n            </div>\r\n            {{#levels}}\r\n            {{#RatingLevel}}\r\n            <div class=\"rating-level\" data-level=\"{{levelValue}}\" data-toggle=\"tooltip\" title=\"{{tooltip}}\">\r\n                <div style=\"padding-right:3px;\">{{displayTitle}}</div>\r\n                <div>\r\n                    <div class=\"progress-bar\">\r\n                        <span class=\"progress-indicator\" style=\"width:{{ratingPctValue}}%\"></span>\r\n                    </div>\r\n                </div>\r\n                <div>&nbsp;{{ratingPctValue}}%</div>\r\n            </div>\r\n            {{/RatingLevel}}\r\n            {{/levels}}\r\n        </div>\r\n        <div style=\"padding-top:10px\">\r\n            <button type=\"button\" class=\"btn btn-success\" data-action=\"Cloud.ShowRatingModalFromPopover\" data-boid=\"{{primaryObjectID}}\" src-identity=\"{{srcIdentity}}\">\r\n                See more detail\r\n            </button>\r\n        </div>\r\n    </div>\r\n    {{/ratingsBreakdown}}\r\n</script>\r\n\r\n<script id=\"ST.Modal.OAuth\" type=\"text/html\">\r\n    <div class=\"title\">Authentication</div>\r\n    <div class=\"st-modal-content\" style=\"width: 600px;\">\r\n        <iframe class=\"oauth-login-frame\" src=\"{{src}}\" aria-label=\"Authorization Form\"></iframe>\r\n    </div>\r\n</script><script type=\"text/html\" id=\"ST.Controls.IACLoader\">\r\n    <div class=\"dropdown REV_BUTTON\" style=\"display:inline-block; margin-left:5px\">\r\n        <button type=\"button\" data-toggle=\"dropdown\" class=\"btn btn-default loading\" disabled=\"disabled\">\r\n            <i class=\"glyphicon glyphicon-export\" role=\"presentation\"></i>\r\n            <span>Actions</span>\r\n        </button>\r\n    </div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"ST.Controls.ReportIAC\">\r\n    {{#IACData}}\r\n    <div class=\"dropdown btn-group\" style=\"margin-top: 0\">\r\n        <button type=\"button\" data-toggle=\"dropdown\" class=\"btn btn-default toggle-tooltip iac-button\" data-placement=\"right\" title=\"Actions\">\r\n            <i class=\"glyphicon glyphicon-export\" role=\"presentation\"></i>\r\n            <span class=\"sr-only\">Actions</span>\r\n        </button>\r\n        {{>ST.Controls.IACContainer}}\r\n    </div>\r\n    {{/IACData}}\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"ST.Controls.IAC\">\r\n    {{#IACData}}\r\n    <div class=\"dropdown REV_BUTTON\" style=\"display:inline-block; margin-left:5px\">\r\n        <button type=\"button\" data-toggle=\"dropdown\" class=\"btn btn-default toggle-tooltip\" data-placement=\"right\" title=\"Actions\">\r\n            <i class=\"glyphicon glyphicon-export\" role=\"presentation\"></i>\r\n            <span>Actions</span>\r\n        </button>\r\n        {{>ST.Controls.IACContainer}}\r\n    </div>\r\n    {{/IACData}}\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"Analytics.IntegratedActions\">\r\n    {{#IACData}}\r\n    <div class=\"dropdown analytics-ia\" style=\"display:inline-block; margin-left:5px\">\r\n        <button type=\"button\" data-toggle=\"dropdown\" class=\"btn btn-link toggle-tooltip\" data-placement=\"right\" title=\"Actions\">\r\n            <i class=\"glyphicon glyphicon-export\" role=\"presentation\"></i>\r\n        </button>\r\n        {{>ST.Controls.IACContainer}}\r\n    </div>\r\n    {{/IACData}}\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"ST.Controls.GridIAC\">\r\n    {{#IACData}}\r\n    <div class=\"dropdown st-grid-iac\" style=\"display:inline-block; margin-left:5px\">\r\n        <button type=\"button\" data-toggle=\"dropdown\" class=\"btn btn-xs btn-default toggle-tooltip\" data-placement=\"right\" title=\"Actions\" data-action=\"IAC.ShowListDropdown\">\r\n            <i class=\"glyphicon glyphicon-export\" role=\"presentation\"></i>\r\n        </button>\r\n        {{>ST.Controls.IACContainer}}\r\n    </div>\r\n    {{/IACData}}\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"ST.Controls.IACContainer\">\r\n    <div class=\"integrated-actions-container dropdown-menu sticky ignore-click\" data-action=\"IAC.CloseListDropdown\">\r\n        <div class=\"iac-filter\">\r\n            <div class=\"input-group\">\r\n                <span class=\"input-group-addon\" role=\"presentation\"><i class=\"fa fa-filter\"></i></span>\r\n                <input autocomplete=\"off\" class=\"form-control\" type=\"text\" aria-label=\"Action Filter\" />\r\n            </div>\r\n        </div>\r\n        <div class=\"iac-categories\">\r\n            {{#reports.length}}\r\n            <div class=\"iac-category\">\r\n                <h2>\r\n                    <i class=\"fa fa-file-text\" role=\"presentation\"></i>\r\n                    Reports\r\n                </h2>\r\n                <div class=\"iac-list scrolling-container\" style=\"border: 1px solid #ddd;\">\r\n                    <ul>\r\n                        {{#reports}}\r\n                        <li data-boid=\"{{primaryObjectGU}}\" data-view-id=\"{{viewGU}}\" data-action-name=\"{{actionGU}}\"><a href=\"#\" data-action=\"IAC.LaunchReportAction\">{{{description}}}</a></li>\r\n                        {{/reports}}\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            {{/reports.length}}\r\n            {{#processes.length}}\r\n            <div class=\"iac-category\">\r\n                <h2><i class=\"far fa-clock\" role=\"presentation\"></i> Processes</h2>\r\n                <div class=\"iac-list scrolling-container\">\r\n                    <ul>\r\n                        {{#processes}}\r\n                        <li data-boid=\"{{primaryObjectGU}}\" data-view-id=\"{{viewGU}}\" data-action-name=\"{{actionGU}}\">\r\n                            <span class=\"iac-icon\"><img alt=\"{{iconAlt}}\" src=\"Images/{{iconSrc}}\" width=\"16\" /></span>\r\n                            <a href=\"#\" data-action=\"IAC.LaunchAction\">{{description}}</a>\r\n                        </li>\r\n                        {{/processes}}\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            {{/processes.length}}\r\n        </div>\r\n\r\n        <div class=\"clearfix\" style=\"font-weight: bold;display: block;padding: 5px 10px;\">\r\n            {{#isReport}}\r\n            <label class=\"custom-checkbox-item checked pull-left\">\r\n                <input name=\"iac_printFirst\" type=\"checkbox\" class=\"custom-checkbox\" checked=\"checked\">\r\n                <span class=\"custom-checkbox-mark\"></span>\r\n                <span class=\"desc\">Print This Report</span>\r\n            </label>\r\n            {{/isReport}}\r\n\r\n            {{^isInChecklist}}\r\n            <div class=\"btn-group dropdown pull-right\">\r\n                <button type=\"button\" class=\"btn btn-default icon-btn\" data-toggle=\"dropdown\" data-action=\"IAC.ToggleListDropdown\">\r\n                    <span class=\"glyphicon glyphicon-check\" role=\"presentation\"></span>\r\n                    <span>Save As List</span>\r\n                </button>\r\n                <div class=\"dropdown-menu ignore-click\" style=\"padding: 5px 10px\" data-action=\"EatClick\">\r\n                    <div class=\"form-group\">\r\n                        <label for=\"cl_listName\">List Name</label>\r\n                        <input class=\"form-control\" name=\"cl_listName\" />\r\n                    </div>\r\n\r\n                    <div class=\"form-group\">\r\n                        <label for=\"cl_description\">Description</label>\r\n                        <textarea class=\"form-control\" name=\"cl_description\"></textarea>\r\n                    </div>\r\n\r\n                    <button type=\"button\" class=\"btn btn-primary pull-right\" data-action=\"IAC.SaveList\">Create</button>\r\n                </div>\r\n            </div>\r\n            {{/isInChecklist}}\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"ST.View.IACContainer\">\r\n    <div class=\"integrated-actions-container dropdown-menu sticky\">\r\n        <div class=\"iac-filter\">\r\n            <div class=\"input-group\">\r\n                <span class=\"input-group-addon\" role=\"presentation\"><i class=\"fa fa-filter\"></i></span>\r\n                <input autocomplete=\"off\" class=\"form-control\" type=\"text\" aria-label=\"Action Filter\" />\r\n            </div>\r\n        </div>\r\n        <div class=\"iac-categories\">\r\n            {{#reports.length}}\r\n            <div class=\"iac-category\">\r\n                <h2 class=\"flexbox horizontal middle padded\">\r\n                    <span><i class=\"far fa-file-text\" role=\"presentation\"></i></span>\r\n                    <span class=\"auto\">Reports</span>\r\n                    {{#ST.ReportBrowserViewGU}}\r\n                    <a href=\"#\" data-action=\"IAC.LaunchReportBrowser\" data-toggle=\"tooltip\" title=\"Report Browser\">\r\n                        <img src=\"{{ST.ReportBrowserIcon}}\" height=\"24\" />\r\n                    </a>\r\n                    {{/ST.ReportBrowserViewGU}}\r\n                </h2>\r\n                <div class=\"iac-list scrolling-container\" style=\"border: 1px solid #ddd;\">\r\n                    <ul>\r\n                        {{#reports}}\r\n                        <li data-boid=\"{{primaryObjectGU}}\" data-view-id=\"{{viewGU}}\" data-action-name=\"{{actionGU}}\" class=\"layout-table\" style=\"width: 100%\">\r\n                            <a href=\"#\" class=\"layout-column top\" data-action=\"IAC.PrintReport\">\r\n                                {{{description}}}\r\n                            </a>\r\n                            <a href=\"#\"class=\"layout-column top right\" data-action=\"IAC.OpenReportDetached\" title=\"Open Detached\" data-toggle=\"tooltip\">\r\n                                <i class=\"glyphicon glyphicon-new-window\"></i>\r\n                            </a>\r\n                        </li>\r\n                        {{/reports}}\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            {{/reports.length}}\r\n            {{#processes.length}}\r\n            <div class=\"iac-category\">\r\n                <h2><i class=\"far fa-clock\" role=\"presentation\"></i> Processes</h2>\r\n                <div class=\"iac-list scrolling-container\">\r\n                    <ul>\r\n                        {{#processes}}\r\n                        <li data-boid=\"{{primaryObjectGU}}\" data-view-id=\"{{viewGU}}\" data-action-name=\"{{actionGU}}\">\r\n                            <span class=\"iac-icon\"><img alt=\"{{iconAlt}}\" src=\"Images/{{iconSrc}}\" width=\"16\" /></span>\r\n                            <a href=\"#\" data-action=\"IAC.LaunchEntityAction\">{{description}}</a>\r\n                        </li>\r\n                        {{/processes}}\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            {{/processes.length}}\r\n        </div>\r\n    </div>\r\n</script>\r\n<script id=\"ST.Modal.Signature\" type=\"text/html\">\r\n    <div class=\"title\">Enter Signature: {{title}}</div>\r\n    <div class=\"sig-content\"></div>\r\n</script>\r\n\r\n<script id=\"ST.SignatureRequest\" type=\"text/html\">\r\n    <div class=\"panel panel-default sig-panel\" id=\"GetSignatureContent\">\r\n        <!-- ko if: !inModal -->\r\n        <h2 class=\"panel-heading\" id=\"SignatureTitle\" data-bind=\"text: title\"></h2>\r\n        <!-- /ko -->\r\n        <div class=\"panel-body\">\r\n            <div class=\"alert alert-info\">\r\n                <i class=\"fa fa-info\"></i>\r\n                <span data-bind=\"html: message\"></span>\r\n            </div>\r\n\r\n            <div class=\"sig-content layout-table\" style=\"width: 100%\">\r\n                <div class=\"sig-documents layout-column\">\r\n                    <ul class=\"list-group\" data-bind=\"foreach: documents\">\r\n                        <li class=\"list-group-item clearfix\" data-bind=\"visible: docGU, css: { error: error, rejected: acceptState() === 'R' }\">\r\n                            <span class=\"sig-document-name nowrap\" data-bind=\"visible: showDocumentURL\">\r\n                                <a target=\"_blank\" data-bind=\"attr: { href: documentURL }, text: name\"></a>\r\n                            </span>\r\n                            <div class=\"sig-document-comment clearfix\" data-bind=\"text: comment\"></div>\r\n                            <div class=\"btn-group btn-group-xs radio-list accept-reject\" data-value=\"\">\r\n                                <!-- ko foreach: lookupItems -->\r\n                                <label class=\"btn btn-default\" data-toggle=\"tooltip\" data-bind=\"attr: { title: desc }\" style=\"display: block; white-space: normal\">\r\n                                    <input type=\"radio\" name=\"docAcceptReject\" data-bind=\"value: code, checked: $parent.acceptState\" />\r\n                                    <span data-bind=\"text: desc\"></span>\r\n                                </label>\r\n                                <!-- /ko -->\r\n                                <!-- ko if: !lookupItems.length -->\r\n                                <label class=\"btn btn-default\" data-toggle=\"tooltip\" title=\"{{#Translate}}AcceptDocument{{/Translate}}\">\r\n                                    <input type=\"radio\" name=\"docAcceptReject\" value=\"A\" data-bind=\"checked: acceptState\" />\r\n                                    <i class=\"far fa-square-check\" role=\"presentation\"></i>\r\n                                    <span>{{#Translate}}Accept{{/Translate}}</span>\r\n                                </label>\r\n                                <label class=\"btn btn-default hidden\">\r\n                                    <input type=\"radio\" name=\"docAcceptReject\" value=\"\" data-bind=\"checked: acceptState\" />\r\n                                    <span class=\"sr-only\">{{#Translate}}NoSelection{{/Translate}}</span>\r\n                                </label>\r\n                                <label class=\"btn btn-default btn-reject\" data-toggle=\"tooltip\" title=\"{{#Translate}}RejectDocument{{/Translate}}\" data-bind=\"visible: allowDecline\">\r\n                                    <input type=\"radio\" name=\"docAcceptReject\" value=\"R\" data-bind=\"checked: acceptState\" />\r\n                                    <i class=\"fa fa-ban\" role=\"presentation\"></i>\r\n                                    <span>{{#Translate}}Reject{{/Translate}}</span>\r\n                                </label>\r\n                                <!-- /ko -->\r\n                            </div>\r\n                            <div class=\"sig-doc-reason\">\r\n                                <label class=\"sr-only\" for=\"reject-reason\">{{#Translate}}RejectReason{{/Translate}}</label>\r\n                                <input class=\"form-control\" name=\"reject-reason\" data-bind=\"value: reason\" placeholder=\"{{#Translate}}EnterReason{{/Translate}}\" />\r\n                            </div>\r\n\r\n                            <span class=\"error-indicator\" data-toggle=\"tooltip\" data-bind=\"attr: { title: error }, visible: error\"><span>!</span></span>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            <div class=\"sig-content layout-table\" style=\"width: 100%\">\r\n                <div class=\"sig-canvas-container layout-column no-select\" data-bind=\"signature: signature\">\r\n                    <div class=\"sig-form-group\" data-bind=\"css: { error: error }\">\r\n                        <canvas class=\"bg-canvas\" role=\"presentation\"></canvas>\r\n                        <canvas class=\"sig-canvas\" role=\"presentation\" width=\"300\" height=\"150\"></canvas>\r\n                        <button type=\"button\" class=\"btn btn-link btn-clear\" data-bind=\"click: clearSignature\">{{#Translate}}Clear{{/Translate}}</button>\r\n                        <label class=\"control-label sr-only\" for=\"Signature\">{{#Translate}}Signature{{/Translate}}:</label>\r\n                        <input class=\"form-control sig-text\" name=\"Signature\" placeholder=\"{{#Translate}}TypeSignature{{/Translate}}\" />\r\n                        <input type=\"hidden\" id=\"SignatureData\" />\r\n\r\n                        <span class=\"error-indicator\" data-toggle=\"tooltip\" data-bind=\"attr: { title: error }, visible: error\"><span>!</span></span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"sig-disclaimer\" data-bind=\"text: disclaimer\"></div>\r\n\r\n            <div class=\"form-group center\">\r\n                <button type=\"button\" data-bind=\"click: submitSignature, attr: { disabled: saving }\" class=\"btn btn-primary btnOkay\">\r\n                    <img class=\"loadingIcon\" src=\"Images/PXP/OEN_ajax-loader.gif\" width=\"16\" height=\"16\" alt=\"loading...\" data-bind=\"visible: saving\" />\r\n                    {{#Translate}}Submit{{/Translate}}\r\n                </button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n<script type=\"text/html\" id=\"KO.VideoConference.UpcomingMeetings\">\r\n    <div class=\"st-vidconf flexbox vertical\" data-bind=\"foreach: meetings\">\r\n        <div class=\"meeting flexbox vertical auto\" data-bind=\"visible: !dismissed(), css: { fade: loading, 'in-progress': IsStarted }\">\r\n            <div class=\"flexbox horizontal padded\">\r\n                <div class=\"auto\" style=\"font-weight: bold\" data-bind=\"text: MeetingName\"></div>\r\n                <div>\r\n                    <button type=\"button\" class=\"btn btn-link\" data-bind=\"click: dismiss\">\r\n                        <span class=\"fa fa-times\"></span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n            <div class=\"flexbox horizontal padded auto\" style=\"align-items: center\">\r\n                <span class=\"fa fa-video\" style=\"color: var(--st-color-link-fg); background-color: var(--st-color-link-bg); font-size: 36px\"></span>\r\n                <div class=\"auto\">\r\n                    <table>\r\n                        <tbody>\r\n                            <tr>\r\n                                <th>Host:</th>\r\n                                <td data-bind=\"text: OrganizerName\"></td>\r\n                            </tr>\r\n                            <tr>\r\n                                <th>Start Time:</th>\r\n                                <td data-bind=\"text: StartTime\"></td>\r\n                            </tr>\r\n                            <tr>\r\n                                <th>Duration:</th>\r\n                                <td data-bind=\"text: Duration\"></td>\r\n                            </tr>\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n                <div>\r\n                    <div class=\"flexbox horizontal padded\">\r\n                        <div>\r\n                            <button type=\"button\" class=\"btn btn-primary btn-image\" data-bind=\"click: join\">\r\n                                <span class=\"fa fa-video\"></span>\r\n                                <span data-bind=\"text: JoinText\"></span>\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"auto\" style=\"align-items: center\">\r\n                <!-- ko if: IsStarted -->\r\n                <div class=\"btn-group dropdown pull-right\">\r\n                    <button type=\"button\" class=\"btn btn-default\" data-bind=\"click: function() { $data.dismissFor(2) }\">\r\n                        Remind me in 2 minutes\r\n                    </button>\r\n                    <ul class=\"dropdown-menu list-group pull-right\">\r\n                        <li><a class=\"list-group-item\" href=\"#\" data-bind=\"click: function() { $data.dismissFor(1); }\">1 minute</a></li>\r\n                        <li><a class=\"list-group-item\" href=\"#\" data-bind=\"click: function() { $data.dismissFor(5); }\">5 minutes</a></li>\r\n                        <li><a class=\"list-group-item\" href=\"#\" data-bind=\"click: function() { $data.dismissFor(10); }\">10 minutes</a></li>\r\n                    </ul>\r\n                    <button type=\"button\" class=\"btn btn-default\" data-toggle=\"dropdown\" style=\"border-left: 0px\">\r\n                        <span class=\"caret\"></span>\r\n                    </button>\r\n                </div>\r\n                <!-- /ko -->\r\n                <!-- ko if: !IsStarted -->\r\n                <div class=\"btn-group dropdown pull-right\">\r\n                    <button type=\"button\" class=\"btn btn-default\" data-bind=\"click: function() { $data.dismissUntil(2) }\">\r\n                        Remind me 2 minutes before the meeting starts\r\n                    </button>\r\n                    <ul class=\"dropdown-menu list-group pull-right\">\r\n                        <li><a class=\"list-group-item\" href=\"#\" data-bind=\"click: function() { $data.dismissUntil(1); }\">1 minute before</a></li>\r\n                        <li><a class=\"list-group-item\" href=\"#\" data-bind=\"click: function() { $data.dismissUntil(5); }\">5 minutes before</a></li>\r\n                        <li><a class=\"list-group-item\" href=\"#\" data-bind=\"click: function() { $data.dismissUntil(10); }\">10 minutes before</a></li>\r\n                    </ul>\r\n                    <button type=\"button\" class=\"btn btn-default\" data-toggle=\"dropdown\" style=\"border-left: 0px\">\r\n                        <span class=\"caret\"></span>\r\n                    </button>\r\n                </div>\r\n                <!-- /ko -->\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script><script id=\"ST.FeedbackButton\" type=\"text/html\">\r\n    <div id=\"Feedback\" class=\"feedback-tab fade\">\r\n        <div class=\"docking-widget\" role=\"presentation\">\r\n            <span data-loc=\"0\" data-action=\"SetFeedbackLocation\"><i class=\"glyphicon glyphicon-chevron-up\"></i></span>\r\n\r\n            <span class=\"hidden\" data-loc=\"1\" data-action=\"SetFeedbackLocation\"><i class=\"glyphicon glyphicon-chevron-right\"></i></span>\r\n            <span data-loc=\"2\" data-action=\"SetFeedbackLocation\" data-toggle=\"tooltip\" title=\"Move to the middle right\"><i class=\"glyphicon glyphicon-chevron-right vertical-align\"></i></span>\r\n            <span data-loc=\"3\" data-action=\"SetFeedbackLocation\" data-toggle=\"tooltip\" title=\"Move to the lower right\"><i class=\"glyphicon glyphicon-chevron-right\"></i></span>\r\n\r\n            <span data-loc=\"4\" data-action=\"SetFeedbackLocation\"><i class=\"glyphicon glyphicon-chevron-down\"></i></span>\r\n\r\n            <span class=\"hidden\" data-loc=\"5\" data-action=\"SetFeedbackLocation\" data-toggle=\"tooltip\" title=\"Move to the upper left\"><i class=\"glyphicon glyphicon-chevron-left\"></i></span>\r\n            <span data-loc=\"6\" data-action=\"SetFeedbackLocation\" data-toggle=\"tooltip\" title=\"Move to the middle left\"><i class=\"glyphicon glyphicon-chevron-left vertical-align\"></i></span>\r\n            <span data-loc=\"7\" data-action=\"SetFeedbackLocation\" data-toggle=\"tooltip\" title=\"Move to the lower left\"><i class=\"glyphicon glyphicon-chevron-left\"></i></span>\r\n        </div>\r\n        <div class=\"btn-feedback\">\r\n            <div data-action=\"ShowFeedbackModal\" role=\"button\" aria-label=\"Feedback\">\r\n                <img alt=\"Feedback\" src=\"Images/ST/ST_Feedback.png\" />\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"st-modal modal st-feedback-modal\" tabindex=\"-1\" role=\"dialog\" data-bind=\"stModal: sendingFeedback\" style=\"display: none\">\r\n            <div class=\"modal-dialog\" style=\"display:inline-block; min-width: 400px\" data-bind=\"jqDraggable: { handle: '.modal-header' }\">\r\n                <div class=\"modal-content\">\r\n                    <div class=\"modal-header\">\r\n                        <div class=\"pull-right\">\r\n                            <button type=\"button\" class=\"btn btn-default close\" data-bind=\"click: closeModal\">\r\n                                <span role=\"presentation\">&times;</span>\r\n                                <span class=\"sr-only\">Close Dialog</span>\r\n                            </button>\r\n                        </div>\r\n\r\n                        <h4 class=\"modal-title\">Synergy Feedback</h4>\r\n                    </div>\r\n                    <div class=\"modal-body\" data-bind=\"with: feedbackModal\">\r\n                        <div class=\"content flexbox vertical\" style=\"padding: 5px 10px; min-height: 400px\">\r\n                            <address class=\"feedback-message\" data-bind=\"text: disclaimer\"></address>\r\n                            <div class=\"auto\">\r\n                                <label for=\"feedback_value\">Tell us about your Synergy experience:</label>\r\n                                <sup data-bind=\"visible: allowImages\" style=\"color: var(--st-color-link-fg);background-color: var(--st-color-link-bg);cursor:pointer\" data-toggle=\"popover\" title=\"More Information\"\r\n                                     data-content=\"You can also paste an image from the clipboard to add it to the list.\"> ? </sup>\r\n                                <textarea id=\"feedback_value\" name=\"feedback\" style=\"width:100%;min-height:200px\" class=\"form-control\" data-bind=\"value: feedback\" placeholder=\"Fd\"></textarea>\r\n                            </div>\r\n                            <div class=\"feedback-attachments flexbox horizontal padded\" data-bind=\"visible: allowImages\">\r\n                                <div>\r\n                                    <label class=\"feedback-upload-btn flexbox vertical middle\">\r\n                                        <span style=\"font-size: 32px\" class=\"fa fa-plus\" role=\"presentation\"></span>\r\n                                        <span style=\"font-size: 12px\">Upload Image</span>\r\n                                        <input type=\"file\" class=\"sr-only\" data-bind=\"imageData: newAttachment\" />\r\n                                    </label>\r\n                                </div>\r\n                                <div>\r\n                                    <span role=\"button\" class=\"feedback-screenshot-btn btn btn-primary flexbox vertical middle\" data-bind=\"click: takeScreenshot\">\r\n                                        <span style=\"font-size: 32px\" class=\"fa fa-plus\" role=\"presentation\"></span>\r\n                                        <span style=\"font-size: 12px\">Add Screenshot</span>\r\n                                    </span>\r\n                                </div>\r\n                                <ul class=\"flexbox horizontal auto\" style=\"overflow-x: auto\" data-bind=\"foreach: attachments\">\r\n                                    <li style=\"padding-left: 5px\">\r\n                                        <span class=\"attachment-controls flexbox horizontal\">\r\n                                            <button type=\"button\" class=\"btn btn-xs btn-link\" data-bind=\"click: $parent.editingAttachment.bind($parent, $data)\">\r\n                                                <span class=\"fa fa-edit\" role=\"presentation\"></span>\r\n                                                <span class=\"sr-only\">Edit</span>\r\n                                            </button>\r\n                                            <button type=\"button\" class=\"btn btn-xs btn-link\" data-bind=\"click: $parent.removeAttachment.bind($parent, $data)\">\r\n                                                <span class=\"fa fa-times\" role=\"presentation\"></span>\r\n                                                <span class=\"sr-only\">Delete</span>\r\n                                            </button>\r\n                                        </span>\r\n                                        <img data-bind=\"attr: { src: data }\" width=\"64\" height=\"64\" />\r\n                                    </li>\r\n                                </ul>\r\n                            </div>\r\n                            <div data-bind=\"visible: allowImages\">\r\n                                When uploading screenshots, please ensure any sensitive information has been redacted by selecting the <em>Blackout</em> button\r\n                                and drawing a rectangle over the area.\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"modal-footer\">\r\n                        <button type=\"button\" class=\"btn btn-success\" data-bind=\"click: function() { feedbackModal().send() }\">\r\n                            <span class=\"loader fa fa-spinner fa-spin\"></span>\r\n                            Send Feedback\r\n                        </button>\r\n                        <button type=\"button\" class=\"btn btn-default btnCancel\" data-dismiss=\"modal\">Close</button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- ko with: feedbackModal -->\r\n        <div class=\"st-modal modal st-feedback-attachment-modal\" tabindex=\"-1\" role=\"dialog\" data-bind=\"stModal: attachmentModalOpts\" style=\"display: none\">\r\n            <div class=\"modal-dialog\" data-bind=\"jqDraggable: { handle: '.modal-header' }\">\r\n                <div class=\"modal-content auto flexbox vertical\" style=\"min-width: 90vw; min-height: 90vh\">\r\n                    <div class=\"modal-header\">\r\n                        <div class=\"pull-right\">\r\n                            <button type=\"button\" class=\"btn btn-default close\" data-bind=\"click: closeAttachmentModal\">\r\n                                <span role=\"presentation\">&times;</span>\r\n                                <span class=\"sr-only\">Close Dialog</span>\r\n                            </button>\r\n                        </div>\r\n\r\n                        <h4 class=\"modal-title\">Edit Attachment</h4>\r\n                    </div>\r\n                    <div class=\"modal-body auto flexbox vertical\" data-bind=\"with: attachmentModal\">\r\n                        <div class=\"content auto flexbox vertical\" style=\"padding: 5px 10px; min-height: 400px\">\r\n                            <address>\r\n                                When uploading screenshots, please ensure any sensitive information has been redacted by selecting the <em>Blackout</em> button\r\n                                and drawing a rectangle over the area.\r\n                            </address>\r\n                            <div class=\"feedback-screenshot-container no-select auto flexbox vertical\">\r\n                                <div class=\"feedback-screenshot-controls\">\r\n                                    <div class=\"btn-group radio-list\" data-bind=\"stRadioList: drawingMode\">\r\n                                        <label class=\"btn btn-default\">\r\n                                            <input type=\"radio\" value=\"Crop\" name=\"feedbackSSOpt\"/>\r\n                                            <span class=\"fa fa-crop\" role=\"presentation\"></span>\r\n                                            Crop\r\n                                        </label>\r\n                                        <label class=\"btn btn-default\">\r\n                                            <input type=\"radio\" value=\"Blackout\" name=\"feedbackSSOpt\"/>\r\n                                            <span class=\"fas fa-square\" role=\"presentation\"></span>\r\n                                            Blackout\r\n                                        </label>\r\n                                        <label class=\"btn btn-default\">\r\n                                            <input type=\"radio\" value=\"Highlight\" name=\"feedbackSSOpt\"/>\r\n                                            <span class=\"fas fa-highlighter\" role=\"presentation\"></span>\r\n                                            Highlight\r\n                                        </label>\r\n                                        <label class=\"btn btn-default\">\r\n                                            <input type=\"radio\" value=\"Outline\" name=\"feedbackSSOpt\"/>\r\n                                            <span class=\"far fa-square\" role=\"presentation\"></span>\r\n                                            Outline\r\n                                        </label>\r\n                                        <label class=\"btn btn-default\">\r\n                                            <input type=\"radio\" value=\"Draw\" name=\"feedbackSSOpt\"/>\r\n                                            <span class=\"fa fa-pencil\" role=\"presentation\"></span>\r\n                                            Draw\r\n                                        </label>\r\n                                        <label class=\"btn btn-default\">\r\n                                            <input type=\"radio\" value=\"Text\" name=\"feedbackSSOpt\"/>\r\n                                            <span class=\"fa fa-i-cursor\" role=\"presentation\"></span>\r\n                                            Text\r\n                                        </label>\r\n                                    </div>\r\n                                    <button type=\"button\" class=\"btn btn-link\" data-bind=\"click: clearEdits\">reset</button>\r\n                                </div>\r\n                                <div class=\"feedback-screenshot auto\"><canvas data-bind=\"saveElement: canvas\"></canvas></div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"modal-footer flexbox horizontal\">\r\n                        <div class=\"auto\"></div>\r\n                        <div>\r\n                            <button type=\"button\" class=\"btn btn-primary\" data-bind=\"click: closeAttachmentModal\">Done</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <!-- /ko -->\r\n</script>\r\n\r\n<script id=\"ST.Feedback.Tab\" type=\"text/html\">\r\n    <div id=\"Feedback\" class=\"feedback-tab\" data-action=\"ShowFeedbackModal\" data-original-title=\"\" title=\"\">\r\n        <img src=\"Images/ST/ST_Feedback.png\" />\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Feedback.OffscreenCanvas\" type=\"text/html\">\r\n    <div class=\"offscreen-canvas\" role=\"presentation\">\r\n        <video id=\"video\" autoplay></video>\r\n        <canvas id=\"canvas\"></canvas>\r\n    </div>\r\n</script>\r\n<script id=\"ST.Modal\" type=\"text/html\">\r\n    <div class=\"st-modal modal\" tabindex=\"-1\" role=\"dialog\">\r\n        <div class=\"modal-dialog\" style=\"display:inline-block\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header flexbox horizontal\">\r\n                    <h4 class=\"modal-title auto\">{{{title}}}</h4>\r\n                    <div class=\"flexbox horizontal middle\">\r\n                        {{#allowClose}}\r\n                        <button type=\"button\" class=\"btn btn-default close\" data-action=\"Modal.Close\">\r\n                            <span role=\"presentation\">&times;</span>\r\n                            <span class=\"sr-only\">Close Dialog</span>\r\n                        </button>\r\n                        {{/allowClose}}\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-loader\">\r\n                    <img src=\"Images/ST/loading.gif\" alt=\"Loading\" /><br />\r\n                    <span>Please wait...</span>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"content\">{{{body}}}</div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <div class=\"controls\">{{{controls}}}</div>\r\n                    <div class=\"modal-status text-center alert alert-danger hidden\" style=\"margin-top:10px;margin-bottom:0px\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.AppInfo\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        <b style=\"white-space: nowrap\">Edupoint Educational Systems, LLC.</b><br />\r\n        <span style=\"font-size: 0.8em\">Copyright (c) 2003-{{CurrYear}}</span>\r\n    </div>\r\n\r\n    <div class=\"st-modal-content\">\r\n        {{#AppInfo}}\r\n        {{#LicenseInfo}}\r\n        <table style=\"width:100%\">\r\n            <tr><th scope=\"col\">Customer:</th><td>{{CustName}}</td></tr>\r\n            <tr><th scope=\"col\">Schema Version:</th><td>{{Schema}}</td></tr>\r\n            <tr><th scope=\"col\">Locale:</th><td>{{Locale}}</td></tr>\r\n            <tr><th scope=\"col\">License:</th><td>{{LicenseKey}}</td></tr>\r\n        </table>\r\n        <hr />\r\n        {{/LicenseInfo}}\r\n        <b>Product Version Information:</b>\r\n        <table style=\"width:100%\">\r\n            <tr><th scope=\"col\">Synergy:</th><td>{{SynergyVersion}} ({{SynergyVersionDate}})</td></tr>\r\n            <tr><th scope=\"col\">Install Date:</th><td>{{SynergyVersionInstallDate}}</td></tr>\r\n            {{#CustomVersion}}\r\n            <tr><th scope=\"col\">Custom Version:</th><td>{{.}}</td></tr>\r\n            {{/CustomVersion}}\r\n            {{#CustomInstallDate}}\r\n            <tr><th scope=\"col\">Custom Install Date:</th><td>{{.}}</td></tr>\r\n            {{/CustomInstallDate}}\r\n            {{#Products}}\r\n            <tr><th scope=\"col\">{{Name}}</th><td>{{Date}} {{Time}} ({{Version}})</td></tr>\r\n            {{/Products}}\r\n        </table>\r\n        {{/AppInfo}}\r\n        <hr />\r\n        <div>\r\n            <button type=\"button\" class=\"btn btn-default\" data-action=\"NFA.ResetHelpTips\">\r\n                Restore Help Tips\r\n                <span class=\"loader fa fa-spinner fa-spin\"></span>\r\n            </button>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.ViewInfo\" type=\"text/html\">\r\n    <div class=\"title flexbox horizontal\">\r\n        <div class=\"flexbox horizontal padded\">\r\n            {{#ViewInfo}}{{#ImagePath.length}}\r\n            <div>\r\n                <img src=\"{{ImagePath}}\" height=\"48\" />\r\n            </div>\r\n            {{/ImagePath.length}}{{/ViewInfo}}\r\n            <div class=\"flexbox vertical auto\">\r\n                <b style=\"white-space: nowrap\">Edupoint Educational Systems, LLC.</b>\r\n                <span style=\"font-size: 0.8em\">Copyright (c) 2003-{{CurrYear}}</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"st-modal-content\">\r\n        <b>Support Information:</b>\r\n        {{#ViewInfo}}\r\n        <table class=\"st-support-table\" style=\"width:100%; margin-top: 10px\">\r\n            <tr><th>Name:</th><td>{{Name}}</td></tr>\r\n            <tr><th>Original Name:</th><td>{{OrigName}}</td></tr>\r\n            {{#PADLocations.length}}\r\n            <tr>\r\n                <th>PAD Location:</th>\r\n                <td>\r\n                    {{#PADLocations}}\r\n                    {{.}}<br />\r\n                    {{/PADLocations}}\r\n                </td>\r\n            </tr>\r\n            {{/PADLocations.length}}\r\n            <tr><th>Type:</th><td>{{Type}}</td></tr>\r\n            <tr><th>GUID:</th><td>{{GUID}}</td></tr>\r\n            <tr><th>Mode:</th><td>{{Mode}}</td></tr>\r\n        </table>\r\n\r\n        <div class=\"flexbox horizontal padded\">\r\n            <div class=\"auto\">\r\n                <button type=\"button\" class=\"btn btn-default\" data-action=\"View.ResetPreferences\" style=\"width: 100%\">\r\n                    Reset View Preferences\r\n                    <span class=\"loader fa fa-spinner fa-spin\"></span>\r\n                </button>\r\n            </div>\r\n            <div class=\"auto\">\r\n                <button type=\"button\" class=\"btn btn-default\" data-action=\"View.ResetHelpTips\" style=\"width: 100%\">\r\n                    Restore Help Tips\r\n                    <span class=\"loader fa fa-spinner fa-spin\"></span>\r\n                </button>\r\n            </div>\r\n        </div>\r\n        {{/ViewInfo}}\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.ViewErrors\" type=\"text/html\">\r\n    <div class=\"title\">{{ViewName}} Errors</div>\r\n    <div class=\"ErrorTable\">\r\n        <table class=\"table table-bordered table-striped table-rounded\">\r\n            <thead>\r\n                <tr>\r\n                    <th>View</th>\r\n                    <th>Tab</th>\r\n                    <th>Group</th>\r\n                    <th>Element</th>\r\n                    <th>Error</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#Errors}}\r\n                <tr>\r\n                    <td>{{view}}</td>\r\n                    <td>{{tab}}</td>\r\n                    <td>{{group}}</td>\r\n                    <td><a href=\"#{{id}}\" data-action=\"Validation.FocusToElement\">{{element}}</a></td>\r\n                    <td>{{description}}</td>\r\n                </tr>\r\n                {{/Errors}}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.JobResultFiles\" type=\"text/html\">\r\n    <div class=\"title\">{{JobID}}: Job Result Files</div>\r\n    <div class=\"ResultFileTable\" style=\"min-width: 400px;\">\r\n        <table class=\"table table-bordered table-striped table-rounded\">\r\n            <thead>\r\n                <tr>\r\n                    <th>Result</th>\r\n                    <th>Description</th>\r\n                    <th>File Type</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#Results}}\r\n                <tr>\r\n                    <td style=\"text-align: center\"><img src=\"{{IMGPATH}}\" data-action=\"JobQueue.ViewResultsFile\" data-guid=\"{{GUID}}\" data-jobgu=\"{{JobGU}}\" /></td>\r\n                    <td>{{Description}}</td>\r\n                    <td style=\"text-align: center\">{{FileType}}</td>\r\n                </tr>\r\n                {{/Results}}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.Message\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        {{#icon}}\r\n        <span class=\"{{.}}\"></span>\r\n        {{/icon}}\r\n        {{title}}\r\n    </div>\r\n    <div class=\"st-modal-content message-box\">\r\n        <div class=\"message-box-{{notificationType}}\" style=\"min-width: 300px; max-height: 600px; white-space: pre-wrap; overflow: auto;\">{{{message}}}</div>\r\n    </div>\r\n    <div class=\"controls\">\r\n        <div style=\"text-align: center\">\r\n            <button type=\"button\" class=\"btn btn-primary btnOkay\" data-dismiss=\"modal\">OK</button>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.Progress\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        {{#icon}}\r\n        <span class=\"{{.}}\"></span>\r\n        {{/icon}}\r\n        {{title}}\r\n    </div>\r\n    <div class=\"st-modal-content modal-progress\">\r\n        <div style=\"min-width: 300px; max-height: 600px; max-width: 500px; white-space: pre-wrap\">{{{message}}}</div>\r\n        <div class=\"spinner\">\r\n            <i class=\"fa fa-spinner fa-spin\"></i>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.Prompt\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        {{#icon}}\r\n        <span class=\"{{.}}\"></span>\r\n        {{/icon}}\r\n        {{title}}\r\n    </div>\r\n    <div class=\"st-modal-content\">\r\n        <div style=\"min-width: 300px; max-height: 600px; max-width: 500px; white-space: pre-wrap\">{{{prompt}}}</div>\r\n        <input type=\"text\" class=\"form-control\" autocomplete=\"off\" name=\"prompt\" style=\"width:100%\" />\r\n    </div>\r\n    <div class=\"controls\">\r\n        <div class=\"pull-right\">\r\n            <button type=\"button\" class=\"btn btn-{{confirmType}} btnOkay\" data-dismiss=\"modal\">{{okayText}}</button>\r\n            <button type=\"button\" class=\"btn btn-default btnCancel\" data-dismiss=\"modal\">{{cancelText}}</button>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.ChangeFocusOrgAwareError.View\" type=\"text/html\">\r\n    <li class=\"flexbox horizontal\" data-action=\"Focus.SelectView\" data-view-gu=\"{{GUID}}\" data-view-type=\"{{ViewType}}\" data-err-type=\"{{ErrorType}}\">\r\n        <img src=\"{{#TransformImagePath}}IconURL{{/TransformImagePath}}\" alt=\"{{IconALT}}\" height=\"48\" />\r\n        <a class=\"auto\" href=\"#\" data-action=\"Focus.SelectView\">{{{ViewName}}}</a>\r\n    </li>\r\n</script>\r\n\r\n<script id=\"ST.Modal.ChangeFocusOrgAwareError\" type=\"text/html\">\r\n    <div class=\"title\"><span class=\"fa fa-exclamation-triangle\"></span> Unsupported View</div>\r\n    <div class=\"st-modal-content st-focus-change\">\r\n        <div style=\"max-width: 400px\">\r\n            <p>The view, <em>{{ViewName}}</em>, you are trying to access is only available when your focus is set to an individual school</p>\r\n\r\n            <div class=\"flexbox horizontal padded\">\r\n                <div class=\"auto\"></div>\r\n                <div style=\"max-height: 190px; overflow: auto\">\r\n                    <ul class=\"list-group flexbox vertical\" style=\"margin: 0\">\r\n                        {{#LastVisitedView}}\r\n                        {{>ST.Modal.ChangeFocusOrgAwareError.View}}\r\n                        {{/LastVisitedView}}\r\n                        {{#HomeView}}\r\n                        {{>ST.Modal.ChangeFocusOrgAwareError.View}}\r\n                        {{/HomeView}}\r\n                    </ul>\r\n                </div>\r\n                <div class=\"auto\"></div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <div class=\"controls\" style=\"padding: 0\">\r\n        <label class=\"flexbox horizontal middle\" style=\"font-size: .8em;\">\r\n            <span><input name=\"remember\" class=\"form-control\" style=\"margin-top: 1px\" type=\"checkbox\" /></span>\r\n            <span style=\"margin-left: 5px\">Always perform this action</span>\r\n        </label>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.Confirmation\" type=\"text/html\">\r\n    <div class=\"title\">{{title}}</div>\r\n    <div class=\"st-modal-content\">\r\n        <div style=\"min-width: 300px; max-height: 600px; max-width: 500px; white-space: pre-wrap\">{{{message}}}</div>\r\n    </div>\r\n    <div class=\"controls\">\r\n        <div class=\"pull-right\">\r\n            <button type=\"button\" class=\"btn btn-{{confirmType}} btnOkay\" data-dismiss=\"modal\">{{okayText}}</button>\r\n            <button type=\"button\" class=\"btn btn-default btnCancel\" data-dismiss=\"modal\">{{cancelText}}</button>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.SaveUndoCancel\" type=\"text/html\">\r\n    <div class=\"title\">Save or Undo Changes</div>\r\n    <div class=\"st-modal-content\">\r\n        <div style=\"min-width: 300px; max-height: 600px; max-width: 500px; white-space: pre-wrap\">{{{message}}}</div>\r\n    </div>\r\n    <div class=\"controls\">\r\n        <div class=\"pull-right\">\r\n            <button type=\"button\" class=\"btn btn-success btnSave\" data-dismiss=\"modal\">{{saveText}}</button>\r\n            <button type=\"button\" class=\"btn btn-warning btnUndo\" data-dismiss=\"modal\">{{undoText}}</button>\r\n            <button type=\"button\" class=\"btn btn-default btnCancel\" data-dismiss=\"modal\">{{cancelText}}</button>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.UploadImage\" type=\"text/html\">\r\n    <div class=\"title\">File Upload</div>\r\n    <div class=\"st-modal-content\" style=\"width: 300px;\">\r\n        <form method=\"post\" action=\"ST_UploadFile.aspx\" target=\"Overlay\" enctype=\"multipart/form-data\">\r\n            <label>\r\n                {{{message}}}\r\n                <input name=\"file\" type=\"file\" />\r\n            </label>\r\n        </form>\r\n    </div>\r\n    <div class=\"controls\">\r\n        <div class=\"pull-right\">\r\n            <button type=\"button\" class=\"btn btn-primary\" data-action=\"UploadImageFromModal\">Upload</button>\r\n            <button type=\"button\" class=\"btn btn-default btnCancel\" data-dismiss=\"modal\">Cancel</button>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.ComboBox\" type=\"text/html\">\r\n    <div class=\"st-dropdown input-group\">\r\n        <button type=\"button\" name=\"{{Name}}\" class=\"form-control st-widget-input\"></button>\r\n        {{>ST.DropDown.List}}\r\n        <div class=\"st-dropdown-btn input-group-addon\">\r\n            <span class=\"caret\"></span>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Focus.WIDropDown\" type=\"text/html\">\r\n    <ul class=\"dropdown-menu\" role=\"menu\">\r\n        {{#Values}}\r\n        {{^IsCurrent}}\r\n        {{#OrgTypeCheck}}\r\n        <li data-value=\"{{Value}}\" data-display=\"{{InputDisp}}\" role=\"presentation\">\r\n            <a href=\"#\" data-action=\"Focus.SelectOrganization\">{{ListDisp}}</a>\r\n        </li>\r\n        {{/OrgTypeCheck}}\r\n        {{/IsCurrent}}\r\n        {{/Values}}\r\n    </ul>\r\n</script>\r\n\r\n<script id=\"ST.Focus.OrgTreeNode\" type=\"text/html\">\r\n    {{#LeafNode}}\r\n    <li data-guid=\"{{OrgGU}}\">\r\n        <span data-action=\"Focus.SetActiveNode\">{{OrgName}}</span>\r\n    </li>\r\n    {{/LeafNode}}\r\n    {{^LeafNode}}\r\n    <li class=\"parent collapsed\" data-guid=\"{{OrgGU}}\">\r\n        <span data-action=\"Focus.SetActiveNode\">{{OrgName}}</span>\r\n        <ul>\r\n            {{#Children}}\r\n            {{>ST.Focus.OrgTreeNode}}\r\n            {{/Children}}\r\n        </ul>\r\n    </li>\r\n    {{/LeafNode}}\r\n</script>\r\n\r\n<script id=\"ST.Modal.ChangeFocus\" type=\"text/html\">\r\n    <div class=\"title\">Change Focus</div>\r\n    <div class=\"st-modal-content\">\r\n        <div class=\"FocusTree\">\r\n            <div></div>\r\n        </div>\r\n        <table>\r\n            {{#YearList.Values.length}}\r\n            {{#YearList}}\r\n            <tr>\r\n                <th>Year:</th>\r\n                <td>{{>ST.ComboBox}}</td>\r\n            </tr>\r\n            {{/YearList}}\r\n            {{/YearList.Values.length}}\r\n\r\n            {{#OrganizationList.Values.length}}\r\n            {{#OrganizationList}}\r\n            <tr>\r\n                <th>\r\n                    <button type=\"button\" class=\"btn btn-default {{#ShowFocusTree}}active{{/ShowFocusTree}}\" data-action=\"Focus.ToggleFocusTree\" data-toggle=\"tooltip\" title=\"Toggle Focus Tree\">\r\n                        <span class=\"glyphicon glyphicon-tree-deciduous\" role=\"presentation\"></span>\r\n                        <span class=\"sr-only\">Toggle Focus Tree</span>\r\n                    </button>\r\n                    Organization:\r\n                </th>\r\n                <td>{{>ST.ComboBox}}</td>\r\n            </tr>\r\n            {{/OrganizationList}}\r\n            {{/OrganizationList.Values.length}}\r\n\r\n            <tr class=\"{{^ShowFocusTree}}hidden{{/ShowFocusTree}}\">\r\n                <td colspan=\"2\">\r\n                    <div class=\"org-tree line-tree scrolling-container\" style=\"max-height: 200px\"></div>\r\n                </td>\r\n            </tr>\r\n\r\n            {{#ShowInactiveSection}}\r\n            <tr>\r\n                <th>Show Students:</th>\r\n                <td style=\"padding-top:8px;\">\r\n                    <label><input type=\"radio\" name=\"inpShowStudents\" value=\"0\" /> Show Active Only</label><br />\r\n                    <label><input type=\"radio\" name=\"inpShowStudents\" value=\"1\" /> Show Inactive Only</label><br />\r\n                    <label><input type=\"radio\" name=\"inpShowStudents\" value=\"2\" /> Show Active and Inactive</label><br />\r\n                </td>\r\n            </tr>\r\n            {{/ShowInactiveSection}}\r\n        </table>\r\n    </div>\r\n    <div class=\"controls\">\r\n        {{#ThirdPartyApps.length}}\r\n        <div class=\"btn-group REV_MENU\" style=\"margin-top:1px\">\r\n            <div class=\"btn-group main-menu\">\r\n                <button class=\"btn btn-default dropdown-toggle\" data-toggle=\"dropdown\">\r\n                    Menu <span class=\"caret\"></span>\r\n                </button>\r\n\r\n                <ul class=\"dropdown-menu scrolling-container multi-column-dropdown\" role=\"menu\" style=\"height:auto;padding-right:32px\">\r\n                    {{#ThirdPartyApps}}\r\n                    {{>ST.MenuItem}}\r\n                    {{/ThirdPartyApps}}\r\n                </ul>\r\n            </div>\r\n        </div>\r\n        {{/ThirdPartyApps.length}}\r\n\r\n        <div class=\"pull-right\">\r\n            <button type=\"button\" class=\"btn btn-success btnOkay\" onclick=\"$(this).closest('.st-modal').stModal('result', true)\" data-dismiss=\"modal\">Save</button>\r\n            <button type=\"button\" class=\"btn btn-default btnCancel\" data-dismiss=\"modal\">Cancel</button>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.WaitOverlay\" type=\"text/html\">\r\n    <div class=\"WaitOverlay\">\r\n        <div>\r\n            <img src=\"Images/ST/loading.gif\" width=\"32px\" height=\"32px\" alt=\"Loading\" />\r\n            <div>Please Wait...</div>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Filters.Item\" type=\"text/html\">\r\n    <li class=\"list-group-item no-select\" data-guid=\"{{guid}}\">\r\n        <span class=\"glyphicon glyphicon-remove\" data-action=\"Filters.DeleteFilter\" role=\"presentation\"></span>\r\n        <label>\r\n            <input type=\"checkbox\" {{#checked}} checked=\"checked\" {{/checked}} />\r\n            <span class=\"sr-only\">Delete</span> {{name}}\r\n        </label>\r\n    </li>\r\n</script>\r\n\r\n<script id=\"ST.Modal.Exception\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        <i class=\"glyphicon glyphicon glyphicon-exclamation-sign\" role=\"presentation\"></i>\r\n        <b style=\"white-space: nowrap\">Application Error</b>\r\n    </div>\r\n\r\n    <div class=\"STException\">\r\n        <div>\r\n            {{{ExceptionMessage}}}\r\n        </div>\r\n\r\n        <button type=\"button\" class=\"btn btn-default pull-right\" data-action=\"ToggleExceptionDetails\">\r\n            <span class=\"glyphicon glyphicon-chevron-down\" role=\"presentation\"></span>\r\n            Details\r\n        </button>\r\n\r\n        <div class=\"details\">\r\n            {{#Errors}}\r\n            <div class=\"{{^Index}}active{{/Index}}\">\r\n                <h2 data-action=\"ShowExceptionPane\">{{ErrorTitle}}: <span class=\"message\">{{{ExceptionMessage}}}</span></h2>\r\n                <div class=\"stack\">\r\n                    <strong>{{{ErrorMessage}}}</strong>\r\n                    <p>\r\n                        {{#StackTrace}}\r\n                        {{{Text}}}\r\n                        {{/StackTrace}}\r\n                    </p>\r\n                </div>\r\n            </div>\r\n            {{/Errors}}\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Bookmark\" type=\"text/html\">\r\n    <span role=\"button\" class=\"btn btn-xs btn-link{{#Bookmarked}} bookmarked{{/Bookmarked}}\" data-action=\"Bookmark.ToggleBookmark\" data-delay='{ \"show\": 1000, \"hide\": 100 }' data-toggle=\"tooltip\" title=\"Toggle Bookmark\">\r\n        <span class=\"glyphicon glyphicon-bookmark\"></span>\r\n        <span class=\"sr-only\">Toggle Bookmark</span>\r\n    </span>\r\n</script>\r\n\r\n<script id=\"ST.Debug.ContextMenu\" type=\"text/html\">\r\n    <div class=\"panel panel-default open\">\r\n        <div style=\"text-align:center\">\r\n            <b>Debug</b>\r\n        </div>\r\n        <ul class=\"dropdown-menu\" style=\"display:block;position:static;\">\r\n            <li><a href=\"#\" data-action=\"Debug.LogXMLNode\">Print XML definition to console</a></li>\r\n            <li><a href=\"#\" data-action=\"Debug.LogXMLData\">Print XML data root to console</a></li>\r\n            <li><a href=\"#\" data-action=\"Debug.LogXMLGUID\">Print GUID to console</a></li>\r\n            <li><a href=\"#\" data-action=\"Debug.LogComplexControl\">Print STComplexControl data to console</a></li>\r\n        </ul>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Controls.Rating\" type=\"text/html\">\r\n    <span class=\"rating-control\">\r\n        <span class=\"fa fa-star-o star\" message=\"I hate it\" data-value=\"1\"></span>\r\n        <span class=\"fa fa-star-o star\" message=\"I don't like it\" data-value=\"2\"></span>\r\n        <span class=\"fa fa-star-o star\" message=\"It's okay\" data-value=\"3\"></span>\r\n        <span class=\"fa fa-star-o star\" message=\"I like it\" data-value=\"4\"></span>\r\n        <span class=\"fa fa-star-o star\" message=\"I love it\" data-value=\"5\"></span>\r\n    </span>\r\n    <div class=\"rating-control-message\">&nbsp;</div>\r\n</script>\r\n\r\n<script id=\"ST.Controls.TagInput\" type=\"text/html\">\r\n    <span class=\"tag-input form-control\">\r\n        {{#tags}}\r\n        <span class=\"tag\" data-action=\"TagInput.RemoveTag\">\r\n            <i class=\"fa fa-remove\"></i>\r\n            {{.}}\r\n        </span>\r\n        {{/tags}}\r\n\r\n        <input type=\"text\" autocomplete=\"off\" style=\"border-color: transparent; background-color: transparent;\" />\r\n    </span>\r\n</script>\r\n\r\n<script id=\"ST.Controls.TagInput.Tag\" type=\"text/html\">\r\n    <span class=\"tag\" data-action=\"TagInput.RemoveTag\">\r\n        <i class=\"fa fa-remove\"></i>\r\n        {{value}}\r\n    </span>\r\n</script>\r\n\r\n<script id=\"ST.DropDown.List\" type=\"text/html\">\r\n    <ul class=\"dropdown-menu\" role=\"menu\">\r\n        {{#AllowCheckbox}}\r\n        <li class=\"FindTools\" style=\"padding: 0\" role=\"presentation\"><button type=\"button\" class=\"btn btn-default\" style=\"width:100%\" data-action=\"CheckAllValues\">Check/Uncheck All</button></li>\r\n        {{/AllowCheckbox}}\r\n        {{#Values}}\r\n        <li data-value=\"{{Value}}\" data-display=\"{{InputDisp}}\" {{#Inactive}} class=\"hidden\" {{/Inactive}} role=\"presentation\">\r\n            {{^Inactive}}\r\n            {{#AllowCheckbox}}<input role=\"menuitem\" type=\"checkbox\" aria-label=\"{{ListDisp}}\" />{{/AllowCheckbox}}\r\n            {{/Inactive}}\r\n            {{#AllowHtml}}\r\n            <a role=\"menuitem\" href=\"#\" data-action=\"Dropdown.SelectItem\">{{{ListDisp}}}</a>\r\n            {{/AllowHtml}}\r\n            {{^AllowHtml}}\r\n            <a role=\"menuitem\" href=\"#\" data-action=\"Dropdown.SelectItem\">{{ListDisp}}</a>\r\n            {{/AllowHtml}}\r\n        </li>\r\n        {{/Values}}\r\n    </ul>\r\n</script>\r\n\r\n<script id=\"ST.LoadingOverlay\" type=\"text/html\">\r\n    <div class=\"loading-overlay\">\r\n        <div class=\"background\"></div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.DockPanel.ImageModal\" type=\"text/html\">\r\n    <div class=\"title\">{{title}}&nbsp;</div>\r\n\r\n    <div class=\"stdp-modal stdp-image-modal\">\r\n        <img src=\"{{src}}\" alt=\"{{alt}}\" style=\"height:{{height}}px;\" />\r\n    </div>\r\n</script>\r\n<script id=\"ST.NFA.Popover\" type=\"text/html\">\r\n    <div class=\"NFA-popover popover {{placement}}\" data-nfaGU=\"{{guid}}\">\r\n        <div class=\"arrow\"></div>\r\n        <div class=\"pull-left\">\r\n            <i class=\"fa fa-question-circle nfa-type-icon\"></i>\r\n            {{{title}}}\r\n        </div>\r\n        <button type=\"button\" class=\"btn btn-link pull-right\" data-action=\"NFA.ClosePopover\" data-force-show=\"{{forceShow}}\">\r\n            <i class=\"glyphicon glyphicon-remove\" role=\"presentation\"></i>\r\n            <span class=\"sr-only\">Close</span>\r\n        </button>\r\n        <div class=\"popover-content\" style=\"clear:both\">\r\n            <p>{{{content}}}</p>\r\n        </div>\r\n        <div class=\"popover-footer\">\r\n            <div class=\"btn-group bullet-list\">\r\n                {{#steps.length}}\r\n                {{^skipPrompt}}\r\n                <button type=\"button\" class=\"btn btn-link {{^hasPrev}}disabled{{/hasPrev}} {{#current}}active{{/current}}\" data-toggle=\"tooltip\" title=\"{{title}}\" data-action=\"NFA.SelectFirstStep\">\r\n                    <i class=\"no-loader fa fa-circle\" role=\"presentation\"></i>\r\n                    <span class=\"sr-only\">{{title}}</span>\r\n                    <span class=\"loader fa fa-spinner fa-spin\"></span>\r\n                </button>\r\n                {{/skipPrompt}}\r\n                {{#steps}}\r\n                <button type=\"button\" class=\"btn btn-link {{#current}}disabled{{/current}}\" data-toggle=\"tooltip\" title=\"{{title}}\" data-nfaitemgu=\"{{guid}}\" data-action=\"NFA.SelectStep\">\r\n                    <i class=\"no-loader fa fa-circle\" role=\"presentation\"></i>\r\n                    <span class=\"sr-only\">{{title}}</span>\r\n                    <span class=\"loader fa fa-spinner fa-spin\"></span>\r\n                </button>\r\n                {{/steps}}\r\n                {{/steps.length}}\r\n            </div>\r\n\r\n            <div class=\"pull-right\">\r\n                {{#hasPrev}}\r\n                <button type=\"button\" class=\"btn btn-default\" data-action=\"NFA.PrevStep\">\r\n                    Prev\r\n                    <span class=\"loader fa fa-spinner fa-spin\"></span>\r\n                </button>\r\n                {{/hasPrev}}\r\n                {{^isLast}}\r\n                <button type=\"button\" class=\"btn btn-default\" data-action=\"NFA.NextStep\">\r\n                    Next\r\n                    <span class=\"loader fa fa-spinner fa-spin\"></span>\r\n                </button>\r\n                {{/isLast}}\r\n                {{#isLast}}\r\n                <button type=\"button\" class=\"btn btn-default\" data-action=\"NFA.Dismiss\">Got It!</button>\r\n                {{/isLast}}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.Modal.Video\" type=\"text/html\">\r\n    <div class=\"st-modal-content\">\r\n        <video width=\"640\" height=\"480\" controls>\r\n            <source src=\"{{url}}&fmt=mp4\" type='video/mp4' />\r\n            <source src=\"{{url}}&fmt=mp4\" type='video/mp4; codecs=\"h.264 avc1.42E01E, mp4a.40.2\"' />\r\n            <source src=\"{{url}}&fmt=ogv\" type='video/ogg; codecs=\"theora, vorbis\"' />\r\n            <source src=\"{{url}}&fmt=webm\" type='video/webm; codecs=\"vp8, vorbis\"' />\r\n        </video>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.NFA.CloseDialog\" type=\"text/html\">\r\n    <div class=\"st-modal-content\">\r\n        <div style=\"width:200px; height:145px; white-space: pre-wrap\">\r\n            <button type=\"button\" class=\"btn btn-primary btnSnooze\" data-dismiss=\"modal\" style=\"width:100%\">Snooze</button>\r\n            <button type=\"button\" class=\"btn btn-default btnDontRemind\" data-dismiss=\"modal\" style=\"width:100%\">Don't Remind Me Again</button>\r\n        </div>\r\n    </div>\r\n</script><script id=\"KO.Announcements\" type=\"text/html\">\r\n    <div class=\"title\">District Notifications</div>\r\n    <div class=\"controls\">\r\n        <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n    </div>\r\n    \r\n    <div style=\"padding: 5px\">\r\n        <!-- ko if: signatureRequests().length > 0 -->\r\n        <div class=\"panel panel-default\" id=\"Signatures\" data-bind=\"with: signatureRequests\">\r\n            <h4 class=\"panel-heading\">\r\n                <span class=\"fas fa-edit\" role=\"presentation\"></span> Pending Signatures\r\n            </h4>\r\n            <div class=\"panel-body\">\r\n                <table class=\"table table-bordered table-striped no-ext\">\r\n                    <caption class=\"sr-only\">Pending Signatures</caption>\r\n                    <thead>\r\n                        <tr>\r\n                            <th scope=\"col\" style=\"width: 1px\">Date</th>\r\n                            <th scope=\"col\">Title</th>\r\n                            <th scope=\"col\" style=\"width: 1px\">Sign</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody data-bind=\"foreach: $data\">\r\n                        <tr>\r\n                            <td data-bind=\"text: date\"></td>\r\n                            <td data-bind=\"text: title\"></td>\r\n                            <td><button type=\"button\" class=\"btn btn-default\" style=\"white-space: nowrap\" data-bind=\"click: enterSignature\">Enter Signature</button></td>\r\n                        </tr>\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n        </div>\r\n        <!-- /ko -->\r\n\r\n        <!-- ko if: announcements.length > 0 || hasDismissedAnnouncements -->\r\n        <div class=\"panel panel-default\" id=\"Announcements\" data-bind=\"with: announcements\">\r\n            <h4 class=\"panel-heading clearfix\">\r\n                <span class=\"glyphicon glyphicon-bullhorn\" role=\"presentation\"></span>\r\n                District and School Announcements\r\n\r\n                <span class=\"pull-right clearfix\">\r\n                    <button type=\"button\" class=\"btn btn-default\" data-bind=\"click: function() { $root.toggleDismissed(); }\">\r\n                        <!-- ko if: $root.showAllMessages -->\r\n                        <span>Hide Dismissed Announcements</span>\r\n                        <!-- /ko -->\r\n                        <!-- ko if: !$root.showAllMessages() -->\r\n                        <span>Show Dismissed Announcements</span>\r\n                        <!-- /ko -->\r\n                    </button>\r\n                </span>\r\n            </h4>\r\n            <div class=\"panel-body\" data-bind=\"if: $parent.announcements.length > 0\" style=\"overflow: auto\">\r\n                <table class=\"table table-bordered table-striped no-ext\">\r\n                    <thead>\r\n                        <tr class=\"sr-only\">\r\n                            <th scope=\"col\">Urgency</th>\r\n                            <th scope=\"col\">Organization Name</th>\r\n                            <th scope=\"col\">Announcement</th>\r\n                            <th scope=\"col\">Actions</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody data-bind=\"foreach: $data\">\r\n                        <tr data-bind=\"attr: { 'class': cssClass }, visible: !dismissed() || $root.showAllMessages()\">\r\n                            <td class=\"TextCentered\" data-toggle=\"tooltip\" title=\"Urgent\" data-bind=\"visible: isUrgent\">\r\n                                <span class=\"glyphicon glyphicon-flag\" style=\"color:red\" role=\"presentation\"></span>\r\n                                <span class=\"sr-only\">Urgent</span>\r\n                            </td>\r\n                            <td class=\"TextCentered\" data-bind=\"visible: !isUrgent\">\r\n                                <span class=\"glyphicon glyphicon-flag\" style=\"color:green\" role=\"presentation\"></span>\r\n                            </td>\r\n                            <td data-bind=\"text: organization\"></td>\r\n                            <td class=\"ck-content\" data-bind=\"stAutoThumbnail, html: announcement\"></td>\r\n                            <td> \r\n                                <div data-bind=\"visible: allowDismiss && enableAnnouncementDismissal\">\r\n                                    <button type=\"button\" title=\"Dismiss the announcement\" data-bind=\"click: dismiss, visible: !dismissed()\" class=\"btn btn-default\">Dismiss</button>\r\n                                    <button type=\"button\" title=\"Recall the announcement\" data-bind=\"click: recall, visible: dismissed()\" class=\"btn btn-default\">Recall</button>\r\n                                </div>\r\n                            </td>\r\n                        </tr>\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n        </div>\r\n        <!-- /ko -->\r\n\r\n        <!-- ko if: surveys.length > 0 -->\r\n        <div class=\"panel panel-default\" id=\"Surveys\" data-bind=\"with: surveys\">\r\n            <h4 class=\"panel-heading\">\r\n                <img width=\"32\" height=\"32\" src=\"Images/GENESIS/SIS_SurveyDef.gif\" alt=\"survey\" />\r\n                Surveys\r\n            </h4>\r\n            <div class=\"panel-body\">\r\n                <table class=\"table table-bordered table-striped no-ext\">\r\n                    <thead>\r\n                        <tr>\r\n                            <th>Title</th>\r\n                            <th>Expiration</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody data-bind=\"foreach: $data\">\r\n                        <tr>\r\n                            <td><a target=\"_blank\" data-bind=\"attr: { href: url }, html: name\"></a></td>\r\n                            <td data-bind=\"text: endDate\"></td>\r\n                        </tr>\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n        </div>\r\n        <!-- /ko -->\r\n    </div>\r\n</script>\r\n\r\n<script id=\"KO.Signatures\" type=\"text/html\">\r\n    <div class=\"title\">Pending Signatures</div>\r\n    <div class=\"controls\">\r\n        <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n    </div>\r\n    \r\n    <div style=\"padding: 5px\">\r\n        <!-- ko if: signatureRequests().length > 0 -->\r\n        <div class=\"panel panel-default\" id=\"Signatures\" data-bind=\"with: signatureRequests\">\r\n            <h4 class=\"panel-heading\">\r\n                <span class=\"fas fa-edit\" role=\"presentation\"></span> Pending Signatures\r\n            </h4>\r\n            <div class=\"panel-body\">\r\n                <table class=\"table table-bordered table-striped no-ext\">\r\n                    <caption class=\"sr-only\">Pending Signatures</caption>\r\n                    <thead>\r\n                        <tr>\r\n                            <th scope=\"col\" style=\"width: 1px\">Date</th>\r\n                            <th scope=\"col\">Title</th>\r\n                            <th scope=\"col\" style=\"width: 1px\">Sign</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody data-bind=\"foreach: $data\">\r\n                        <tr>\r\n                            <td data-bind=\"text: date\"></td>\r\n                            <td data-bind=\"text: title\"></td>\r\n                            <td><button type=\"button\" class=\"btn btn-default\" style=\"white-space: nowrap\" data-bind=\"click: enterSignature\">Enter Signature</button></td>\r\n                        </tr>\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n        </div>\r\n        <!-- /ko -->\r\n    </div>\r\n</script>\r\n\r\n<script id=\"ST.SignatureLink\" type=\"text/html\">\r\n    <li>\r\n        <a href=\"#\" id=\"lnkSig\" data-toggle=\"tooltip\" data-action=\"ShowSignatures\" data-placement=\"bottom\" title=\"Signatures\">\r\n            <span class=\"fas fa-edit\" role=\"presentation\" style=\"margin-top: 2px\"></span>\r\n            <span class=\"sr-only\"> Signatures</span>\r\n            <div class=\"NotificationBox\">{{count}}</div>\r\n        </a>\r\n    </li>\r\n</script>\r\n\r\n<script id=\"ST.Announcements\" type=\"text/html\">\r\n    <div class=\"title\">District Notifications</div>\r\n    <div class=\"controls\">\r\n        <button type=\"button\" class=\"btn btn-default pull-left\" data-action=\"Announcements.ToggleDismissed\">\r\n            <span class=\"txtShow\">Show</span>\r\n            <span class=\"txtHide\">Hide</span>\r\n            Dismissed Messages\r\n        </button>\r\n        <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\r\n    </div>\r\n    \r\n    <div id=\"Announcements\">\r\n        <table class=\"table table-bordered table-striped table-rounded\">\r\n            <thead>\r\n                <tr>\r\n                    <th colspan=\"5\" style=\"font-size: 1.25em; padding: 10px; background-color: #428BCA !important; text-align: left;\">\r\n                        <span class=\"glyphicon glyphicon-bullhorn\" role=\"presentation\"></span>\r\n                        District and School Announcements\r\n                    </th>\r\n                </tr>\r\n                <tr class=\"sr-only\">\r\n                    <th scope=\"col\">Urgency</th>\r\n                    <th scope=\"col\">Organization Name</th>\r\n                    <th scope=\"col\">Announcement</th>\r\n                    <th scope=\"col\">Actions</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#Announcement}}\r\n                <tr data-guid=\"{{@ID}}\" class=\"{{@CssClass}}\">\r\n                    {{#@IsUrgent}}\r\n                    <td class=\"TextCentered\" data-toggle=\"tooltip\" title=\"Urgent\">\r\n                        <span class=\"glyphicon glyphicon-flag\" style=\"color:red\" role=\"presentation\"></span>\r\n                        <span class=\"sr-only\">Urgent</span>\r\n                    </td>\r\n                    {{/@IsUrgent}}\r\n                    {{^@IsUrgent}}\r\n                    <td class=\"TextCentered\"><span class=\"glyphicon glyphicon-flag\" style=\"color:green\" role=\"presentation\"></span></td>\r\n                    {{/@IsUrgent}}\r\n                    <td>{{@Organization}}</td>\r\n                    <td>{{{@Announcement}}}</td>\r\n                    <td>\r\n                        <button type=\"button\" title=\"Dismiss the announcement\" data-action=\"Announcements.Dismiss\" class=\"btn btn-default\">Dismiss</button>\r\n                        <button type=\"button\" title=\"Recall the announcement\" data-action=\"Announcements.Recall\" class=\"btn btn-default\">Recall</button>\r\n                    </td>\r\n                </tr>\r\n                {{/Announcement}}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n</script>\r\n"
          },
