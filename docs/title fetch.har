            "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<JSON_RESPONSE><![CDATA[{\"personGU\":\"809B951C-2CCD-4791-BCCE-B9411EB37B08\",\"showRecentAssignments\":true,\"showBadges\":false,\"students\":[{\"name\":\"Raymond\",\"photo\":\"Photos/80/809B951C-2CCD-4791-BCCE-B9411EB37B08_Photo.PNG\",\"sisNumber\":\"1025302\",\"studentGU\":\"809B951C-2CCD-4791-BCCE-B9411EB37B08\",\"schoolName\":\"Herbert Henry Dow High School\",\"agu\":\"0\",\"allowReportAbsences\":false,\"pastAttendanceData\":[],\"attendanceReasonOptions\":{\"Reasons\":[{\"ReasonGU\":\"D7964F74-CA77-428D-A69E-2C2171EE9CF6\",\"ReasonType\":6,\"Description\":\"Excused Absence\",\"ReasonTypeIcon\":\"<i class=\\\"fa att-icon\\\" data-type=\\\"EXC\\\"></i>\"},{\"ReasonGU\":\"8EEB90EE-1243-4C85-AF79-577F5E35BB21\",\"ReasonType\":5,\"Description\":\"Left Early\",\"ReasonTypeIcon\":\"<i class=\\\"fa att-icon\\\" data-type=\\\"POS\\\"></i>\"},{\"ReasonGU\":\"3C16FFB8-A857-4032-B5CD-4D5392FAA391\",\"ReasonType\":3,\"Description\":\"Tardy\",\"ReasonTypeIcon\":\"<i class=\\\"fa att-icon\\\" data-type=\\\"TAR\\\"></i>\"}],\"StartDate\":\"03/30/2026\",\"EndDate\":\"04/09/2026\",\"NotesAreMandatory\":false},\"messages\":[],\"assignments\":[{\"id\":\"electrochem whiteboard KDO\",\"title\":\"electrochem whiteboard KDO\",\"focusData\":\"{\\\"LoadParams\\\":{\\\"ControlName\\\":\\\"Gradebook_AssignmentDetails\\\",\\\"HideHeader\\\":true},\\\"FocusArgs\\\":{\\\"viewName\\\":null,\\\"studentGU\\\":\\\"809B951C-2CCD-4791-BCCE-B9411EB37B08\\\",\\\"schoolID\\\":-1,\\\"classID\\\":20254,\\\"markPeriodGU\\\":\\\"\\\",\\\"gradePeriodGU\\\":\\\"E4358065-2F41-4558-9629-386AB7009D5F\\\",\\\"subjectID\\\":-1,\\\"teacherID\\\":-1,\\\"assignmentID\\\":378352,\\\"standardIdentifier\\\":null,\\\"AGU\\\":\\\"0\\\",\\\"OrgYearGU\\\":\\\"2973E8BD-AFFF-4AB0-BED3-882607415DCE\\\",\\\"gradingPeriodGroup\\\":null}}\",\"courseTitle\":\"Smallfield, J  AP Advanced Chemistry H (1 hr)(3)\",\"pointsReceived\":0.0,\"pointsTotal\":0.0,\"dueDate