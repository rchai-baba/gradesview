          "cookies": [],
          "content": {
            "mimeType": "text/html",
            "size": 7110,
            "text": "<div class=\"hallpass-btn\" role=\"button\" :attr=\"{'active': hasActiveHallPass}\" :click=\"openHallPassDialog\" :visible=\"hallPassSetup\">\r\n    <a data-bind=\"text: hallPassBtnLabel\" href=\"javascript:;\"></a>\r\n    <span class=\"remaining\" data-bind=\"text: remainingTime\"></span>\r\n</div>\r\n\r\n<div class=\"hall-pass-dialog\">\r\n    <ko :let=\"{ shdApp: $data }\">\r\n        <st-ko-modal title=\"Hall Pass\" is-open=\"@dialogopen\">\r\n\r\n            <!-- ko if: !shdApp.hasCurrentHallPass()  -->\r\n            <div class=\"request-hallpass-btn\" data-bind=\"visible: shdApp.isStudent\" role=\"button\" :click=\"shdApp.openHallPassRequestDialog\">\r\n                <span>Request a Hall Pass</span>\r\n            </div>\r\n\r\n            <!-- ko if: shdApp.futurePasses().length -->\r\n            <span class=\"scheduled-passes-label\">Scheduled Passes</span>\r\n            <div class=\"future-passes\">\r\n                <!-- ko foreach: shdApp.futurePasses  -->\r\n                <div class=\"future-pass\" :style=\"{ 'background-color': room.color}\">\r\n                    <span class=\"remove-hall-pass pull-right glyphicon glyphicon-trash\" role=\"button\" :click=\"shdApp.removeFutureHallPass\" data-toggle=\"tooltip\" aria-label=\"Remove Hall Pass\" data-original-title=\"Remove Hall Pass\"></span>\r\n                    <img class=\"room-icon\" :attr=\"{ src: room.iconPath, alt: room.roomName }\">\r\n                    <div class=\"future-pass-details\">\r\n                        <span class=\"location-name\" :text=\"room.roomName\"></span>\r\n                        <span class=\"future-pass-time\" :text=\"dateTime\"></span>\r\n                        <span class=\"future-pass-status\" :text=\"status\"></span>\r\n                    </div>\r\n                </div>\r\n                <!-- /ko -->\r\n            </div>\r\n            <!-- /ko -->\r\n            <!-- /ko -->\r\n            <!-- ko if: shdApp.isStudent() -->\r\n            <!-- ko with: shdApp.currentHallPass() -->\r\n            <span class=\"queue-refresh-data-msg\" data-bind=\"text: shdApp.queueRefreshDataMsg, visible: shdApp.hasQueueHallPass\"></span>\r\n            <span class=\"header-pending-msg\" data-bind=\"text: shdApp.pendingMsg, visible: shdApp.hasPendingHallPass\"></span>\r\n            <div class=\"current-pass\" :style=\"{ 'background-color': room.color}\" :attr=\"{'status': shdApp.currentHallPassStatus}\">\r\n                <div class=\"current-pass-remove\" :click=\"shdApp.removeHallPass\">\r\n                    <i class=\"fa-solid fa-trash-can\"></i>\r\n                </div>\r\n                <img class=\"room-icon\" :attr=\"{ src: room.iconPath, alt: room.roomName }\">\r\n                <div class=\"current-pass-details\">\r\n                    <span class=\"location-name\" :text=\"room.roomName\"></span>\r\n                    <span class=\"date-time\" data-bind=\"text: dateTime\"></span>\r\n                    <span class=\"remaining\" data-bind=\"text: shdApp.remainingTime\"></span>\r\n                    <span class=\"queue-msg\" data-bind=\"text: shdApp.studentInQMsg, visible: shdApp.hasQueueHallPass\"></span>\r\n                    <span class=\"pending-msg\" data-bind=\"text: shdApp.pendingMsg, visible: shdApp.hasPendingHallPass\"></span>\r\n                </div>\r\n            </div>\r\n            <!-- /ko -->\r\n            <!-- /ko -->\r\n\r\n            <k12-hallpass-stuhallpasssummary data-bind=\"attr: {value: shdApp.ssyGU}\" svue=true></k12-hallpass-stuhallpasssummary>\r\n        </st-ko-modal>\r\n\r\n        <st-ko-modal title=\"Request Hall Pass\" is-open=\"@requestDialogOpen\">\r\n            <!-- ko with: shdApp.requestDialogOpen -->\r\n            <div style=\"min-height:400px\">\r\n                <wizard complete=\"@shdApp.createHallPass\">\r\n                    <wizard-step name=\"Location\" can-advance=\"@shdApp.canAdvanceRoom\" auto-advance=\"@shdApp.autoAdvance\">\r\n                        <div class=\"wizard-step-contents\">\r\n                            <h2>To Where?</h2>\r\n                            <div class=\"room-filters\">\r\n                                <input type=\"text\" placeholder=\"Search Room\" data-bind=\"textInput: shdApp.filterRoomName\" />\r\n                                <div class=\"room-lock-filter locked\" role=\"button\" :click=\"shdApp.filterRoomsLocked\" :attr=\"{'data-selected': shdApp.filterLockedOnly}\">\r\n                                    <i class=\"fa-solid fa-lock\"></i>\r\n                                </div>\r\n                                <div class=\"room-lock-filter unlocked\" role=\"button\" :click=\"shdApp.filterRoomsUnlocked\" :attr=\"{'data-selected': shdApp.filterUnlockedOnly}\">\r\n                                    <i class=\"fa-solid fa-unlock\"></i>\r\n                                </div>\r\n                            </div>\r\n                            <br />\r\n                            <span class=\"no-rooms\" data-bind=\"visible: shdApp.showNoRooms\">No rooms were found for the specified search criteria</span>\r\n                            <br />\r\n                            <!-- ko foreach: shdApp.rooms -->\r\n                            <div class=\"hall-pass-room\" :style=\"{ 'background-color': color}\" :click=\"roomClick\" :attr=\"{'data-selected': isSelectedRoom}\" :visible=\"isVisible\">\r\n                                <div class=\"approval-required\" :visible=\"approvalRequired\">\r\n                                    <i class=\"fa-solid fa-lock\"></i>\r\n                                </div>\r\n                                <div>\r\n                                    <img class=\"room-icon\" :attr=\"{ src: iconPath, alt: roomName }\">\r\n                                    <span class=\"location-name\" :text=\"roomName\"></span>\r\n                                </div>\r\n                            </div>\r\n                            <!-- /ko -->\r\n                        </div>\r\n                    </wizard-step>\r\n                    <wizard-step name=\"Duration\">\r\n                        <div class=\"wizard-step-contents\">\r\n\r\n                            <!-- ko with: shdApp.selectedRoom() -->\r\n                            <div class=\"selected-room\" :style=\"{ 'background-color': color}\">\r\n                                <img class=\"room-icon\" :attr=\"{ src: iconPath, alt: roomName }\">\r\n                                <span class=\"location-name\" :text=\"roomName\"></span>\r\n                            </div>\r\n                            <!-- /ko -->\r\n\r\n                            <h2>How Much Time?</h2>\r\n                            <br />\r\n                            <div class=\"time-select\">\r\n                                <div>\r\n                                    <input type=\"range\" class=\"slider\" style=\"min-width: 500px;\" data-bind=\"slider: { value: shdApp.timeValue, min: 1, max: shdApp.timeMax, step: 1 }\">\r\n                                    <br />\r\n                                    <div class=\"slider-value\">\r\n                                        <span :text=\"shdApp.timeValueDisplay\"></span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </wizard-step>\r\n                </wizard>\r\n            </div>\r\n            <!-- /ko -->\r\n\r\n        </st-ko-modal>\r\n    </ko>\r\n</div>\r\n"
          },
          "redirectURL": "",
          "headersSize": 317,
          "bodySize": 7427
        },
