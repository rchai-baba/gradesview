            "text": "{\"d\":{\"__type\":\"PXP.PXPInfo.PXPWebResponse\",\"Error\":null,\"Data\":{\"html\":\"\\u003cscript type=\\u0027text/javascript\\u0027\\u003ewindow.LoadRemoteStyleSheet(\\u0027schemes_PXP2_PXP2_Gradebook_css\\u0027, \\u0027/schemes/PXP2/PXP2_Gradebook.css?2026-03-29T12%3a03%3a23.0000000\\u0027);\\r\\n\\u003c/script\\u003e\\r\\n\\r\\n\\u003cscript type=\\\"text/javascript\\\"\\u003e\\r\\n    PXP.GBWI_Translation = {\\\"changeGradeText\\\":\\\"Change the grade for this assignment to see how it impacts your class grade\\\",\\\"classGradeText\\\":\\\"Class Grade Would Be:\\\",\\\"percentageText\\\":\\\"Percentage Would Be:\\\",\\\"resetButtonText\\\":\\\"RESET\\\",\\\"youScoreText\\\":\\\"If You Score:\\\",\\\"calcButton\\\":\\\"CALCULATE MAX SCORE\\\",\\\"gridTooltip\\\":\\\"Open the \\\\\\\"what if\\\\\\\" calculator for this assignment.\\\",\\\"calcText\\\":\\\"Calculate the best grade possible if all ungraded work was graded at full value.\\\",\\\"gradePill\\\":\\\"Grade Could Be:\\\"};\\n\\t\\r\\n\\u003c/script\\u003e\\r\\n\\r\\n\\u003cdiv class=\\\"detail-content\\\"\\u003e\\r\\n\\r\\n    \\u003cdiv class=\\\"row\\\"\\u003e\\r\\n        \\u003cdiv id=\\\"ctl00_CurrentGrade\\\" class=\\\"col-md-3\\\"\\u003e\\r\\n            \\u003cdiv class=\\\"gb-current-grade\\\" style=\\\"display: flex; text-align: center; justify-content: center; flex-wrap: wrap;\\\"\\u003e\\r\\n                \\u003cdiv id=\\\"current-grade\\\"\\u003e\\r\\n                    \\u003cdiv class=\\\"mark\\\"\\u003eA\\u003c/div\\u003e\\r\\n                    \\u003cdiv class=\\\"score\\\"\\u003e97.87%\\u003c/div\\u003e\\r\\n                \\u003c/div\\u003e\\r\\n                \\u003cdiv id=\\\"what-if-grade\\\"\\u003e\\r\\n                    \\u003cdiv class=\\\"pill-label\\\"\\u003eGrade Could Be:\\u003c/div\\u003e\\r\\n                    \\u003cdiv class=\\\"mark\\\"\\u003eN/A\\u003c/div\\u003e\\r\\n                    \\u003cdiv class=\\\"score\\\"\\u003eN/A\\u003c/d