          "content": {
            "mimeType": "text/html",
            "size": 5996,
            "text": "<script id=\"KO.StudentSummary\" type=\"text/html\">\r\n    <img class=\"pxp-home-loading\" src=\"Images/PXP/OEN_ajax-loader_gray.gif\" alt=\"loading\" data-bind=\"visible: loading$\" />\r\n    <!-- ko ifnot: loading$ -->\r\n    <!-- ko if: ST.UserType === UserType.Parent -->\r\n    <div class=\"pxp-student-summary Parent layout-table clearfix\">\r\n        <div class=\"layout-column\" style=\"width: 10%;\">\r\n            <div class=\"student-image\">\r\n                <img data-bind=\"attr: { src: 'Images/PXP/PXP2/parents_96.png', alt: 'Parent' }\" />\r\n            </div>\r\n        </div>\r\n        <div class=\"layout-column\" style=\"width: 90%\">\r\n            <div data-bind=\"bound: function(){ LoadPlugin($element, 'ep_VideoConferencesForStudents', {personGU: personGU, parentVUE: ST.UserType === UserType.Parent})}\"></div>\r\n        </div>\r\n    </div>\r\n    <!-- /ko -->\r\n    <div data-bind=\"foreach: students$\">\r\n        <div class=\"pxp-student-summary layout-table clearfix\" data-bind=\"attr: { 'data-agu': agu }\">\r\n            <div class=\"layout-column\" style=\"width: 10%;\">\r\n                <div class=\"student-image\">\r\n                    <img data-bind=\"attr: { src: photo, alt: name }\" />\r\n                </div>\r\n            </div>\r\n            <div class=\"layout-column\" style=\"width: 60%\">\r\n                <div class=\"student\">\r\n                    <h2 data-bind=\"text: name\"></h2>\r\n                    <div class=\"pull-right\" data-bind=\"visible: allowReportAbsences\">\r\n                        <button type=\"button\" class=\"btn btn-xs btn-primary badge-container\" style=\"margin-right: 0\" data-action=\"ATT.ShowAbsenceDialog\">\r\n                            <span class=\"glyphicon glyphicon-bell\" role=\"presentation\"></span>\r\n                            <span data-bind=\"text: PXP.Translations.ReportAbsence\"></span>\r\n                            <div data-toggle=\"tooltip\" title=\"{{#Translate}}PendingPastAbsences{{/Translate}}\" data-bind=\"text: pastAttendanceData.length, visible: pastAttendanceData.length\" class=\"btn-badge\"></div>\r\n                        </button>\r\n                    </div>\r\n                    <div class=\"info\">\r\n                        ID: <span data-bind=\"text: sisNumber\"></span><br />\r\n                        <span data-bind=\"text: schoolName\"></span>\r\n                    </div>\r\n                    <div data-bind=\"bound: function(){ LoadPlugin($element, 'ep_VideoConferencesForStudents', {personGU: studentGU, parent: ST.UserType === UserType.Parent})}\"></div>\r\n                    <h3 class=\"HideWhenNoMeetings\">Recent Events</h3>\r\n                    <div data-bind=\"css: { 'alerts': ST.UserType === UserType.Parent }\">\r\n                        <ul data-bind=\"foreach: messages$\">\r\n                            <li data-bind=\"css: { 'message-unread': !read$() }\">\r\n                                <!-- ko if: $data.messageType && $data.messageType === 'Synergy Assessment' -->\r\n                                <span>\r\n                                    <img data-bind=\"attr: { src: messageTypeIcon$, alt: module}\" />\r\n                                    <span class=\"alert-message\">\r\n                                        <span data-bind=\"html: subject\"></span>\r\n                                    </span>\r\n                                </span>\r\n                                <!-- /ko -->\r\n                                <!-- ko ifnot: $data.messageType && $data.messageType === 'Synergy Assessment' -->\r\n                                <a href=\"\" data-bind=\"click: $parent.viewMessage\">\r\n                                    <img data-bind=\"attr: { src: messageTypeIcon$, alt: module}\" />\r\n                                    <span class=\"alert-message\">\r\n                                        <span class=\"fa fa-paperclip\" data-bind=\"visible: hasAttachment\"></span>\r\n                                        <span data-bind=\"html: subject\"></span>\r\n                                    </span>\r\n                                </a>\r\n                                <!-- /ko -->\r\n                            </li>\r\n                        </ul>\r\n                    </div>\r\n                    <!-- ko if: $root.showBadges -->\r\n                    <pxp-badges params=\"config:{studentGu:studentGU}\"></pxp-badges>\r\n                    <!-- /ko -->\r\n                </div>\r\n            </div>\r\n            <div class=\"layout-column pxp-student-recent-assignments\" style=\"width: 30%;\" data-bind=\"visible: $root.showRecentAssignments\">\r\n                <div class=\"pxp-panel\">\r\n                    <h2 class=\"title\" data-bind=\"text: PXP.Translations.GBRecentHistory\"></h2>\r\n                    <div data-bind=\"css: { 'gb-student-assignments-grid': ST.UserType === UserType.Parent }\">\r\n                        <table class=\"table table-striped\">\r\n                            <tbody data-bind=\"foreach: assignments$\">\r\n                                <tr>\r\n                                    <td>\r\n                                        <div>\r\n                                            <a href=\"#\" data-bind=\"text: title, attr: { 'data-focus': focusData }\" data-action=\"GB.ShowAssignmentDetailsHome\"></a>\r\n                                        </div>\r\n                                        <div data-bind=\"text: courseTitle\"></div>\r\n                                        <div>Due Date: <span data-bind=\"text: dueDate\"></span></div>\r\n                                        <div data-bind=\"text: grade, visible: showGrade\"></div>\r\n                                    </td>\r\n                                </tr>\r\n                            </tbody>\r\n                            <tr data-bind=\"visible: assignments$().length === 0\">\r\n                                <div class=\"no-data\" data-bind=\"text: PXP.Translations.GBNoData, visible: assignments$().length === 0\"></div>\r\n                            </tr>\r\n                        </table>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <!-- /ko -->\r\n</script>"
          },
          "redirectURL": "",
          "headersSize": 0,
          "bodySize": 5996
        },
        "cache": {},
        "timings": {
