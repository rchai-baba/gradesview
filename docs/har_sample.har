          "content": {
            "mimeType": "text/html",
            "size": 6027,
            "text": "<script id=\"PXP.RequestCounselor.Modal\" type=\"text/html\">\r\n    <div class=\"modal fade co-modal\" data-keyboard=\"true\" data-backdrop=\"true\" tabindex=\"-1\" role=\"dialog\">\r\n        <div class=\"modal-dialog modal-lg\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\"><span aria-hidden=\"true\">&times;</span></button>\r\n                    <h4 class=\"modal-title\">{{#Translate}}RequestCounselorVisit{{/Translate}}</h4>\r\n                </div>\r\n                <div class=\"modal-body\">{{>PXP.RequestCounselor.Modal.Content}}</div>\r\n                <div class=\"modal-footer\" style=\"text-align: left\">{{>PXP.RequestCounselor.Modal.Footer}}</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.RequestCounselor.Embedded\" type=\"text/html\">\r\n    <h2>{{#Translate}}RequestCounselorVisit{{/Translate}}</h2>\r\n    {{>PXP.RequestCounselor.Modal.Content}}\r\n    {{>PXP.RequestCounselor.Modal.Footer}}\r\n</script>\r\n\r\n<script id=\"PXP.RequestCounselor.Modal.Content\" type=\"text/html\">\r\n    <!-- ko if: !counselorStaffGU -->\r\n    <div class=\"alert alert-info\" style=\"padding: 5px;\">\r\n        <i class=\"fas fa-info-circle\" role=\"presentation\"></i>\r\n        <span>\r\n            <span>{{#Translate}}MissingCounselor{{/Translate}}</span>\r\n        </span>\r\n    </div>\r\n    <!-- /ko -->\r\n    <!-- ko if: counselorStaffGU -->\r\n    <div class=\"alert alert-info\" style=\"padding: 5px;\">\r\n        <i class=\"fas fa-info-circle\" role=\"presentation\"></i>\r\n        <span>\r\n            <span data-bind=\"html: instructions\"></span>\r\n        </span>\r\n    </div>\r\n    <!-- ko if: adminCreated-->\r\n    <div>\r\n        <span>{{#Translate}}AppointmentScheduled{{/Translate}} </span>\r\n        <span style=\"font-weight: bold\" data-bind=\"text: requestDateTime\"></span>\r\n    </div>\r\n    <!-- /ko -->\r\n    <div class=\"flexbox vertical padded\">\r\n        <div>\r\n            <label class=\"sr-only\">{{#Translate}}SelectReason{{/Translate}}</label>\r\n            <select class=\"form-control\" data-bind=\"options: reasons, value: reason, optionsText: 'desc', optionsCaption: PXP.Translations.Counselor.SelectAReason, attr: { disabled: adminCreated }\"></select>\r\n        </div>\r\n        <!-- ko if: allowStudentsToChangeCounselor -->\r\n        <div>\r\n            <label class=\"sr-only\">{{#Translate}}SelectCounselor{{/Translate}}</label>\r\n            <select class=\"form-control\" data-bind=\"options: counselorList, value: counselor, optionsText: 'desc', optionsCaption: PXP.Translations.Counselor.SelectACounselor, attr: { disabled: adminCreated }\"></select>\r\n        </div>\r\n           <!-- /ko -->\r\n        <div>\r\n            <label>{{#Translate}}Note{{/Translate}}</label>\r\n            <textarea class=\"form-control\" style=\"min-height: 100px\" data-bind=\"value: note, attr: { disabled: adminCreated }\"></textarea>\r\n        </div>\r\n    </div>\r\n    <!-- /ko -->\r\n</script>\r\n\r\n<script id=\"PXP.RequestCounselor.Modal.Footer\" type=\"text/html\">\r\n    <div class=\"flexbox horizontal padded\">\r\n        <!-- ko if: !adminCreated && counselorStaffGU -->\r\n        <div class=\"auto\">\r\n            <button type=\"button\" class=\"btn btn-default\" data-bind=\"click: showDetails, visible: hasHistory\">{{#Translate}}ViewDetails{{/Translate}}</button>\r\n            <button type=\"button\" class=\"btn btn-danger\" data-bind=\"click: deleteRequest, visible: !!currentMeetingGU\">{{#Translate}}DeleteRequest{{/Translate}}</button>\r\n        </div>\r\n        <div><button type=\"button\" class=\"btn btn-primary\" data-bind=\"click: requestMeeting\">\r\n                 <span data-bind=\"text: requestButtonText\"></span></button></div>\r\n        <!-- /ko -->\r\n        <div><button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\" data-bind=\"click: close\">{{#Translate}}Close{{/Translate}}</button></div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.RequestCounselor.Details\" type=\"text/html\">\r\n    <div class=\"modal fade co-modal\" data-keyboard=\"true\" data-backdrop=\"true\" tabindex=\"-1\" role=\"dialog\">\r\n        <div class=\"modal-dialog modal-lg\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\"><span aria-hidden=\"true\">&times;</span></button>\r\n                    <h4 class=\"modal-title\">{{#Translate}}CurrentMeetings{{/Translate}}</h4>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"layout-table\" data-bind=\"foreach: history\">\r\n                        <div class=\"layout-row\">\r\n                            <div class=\"layout-column\">\r\n                                <span class=\"co-status\" data-bind=\"text: status\"></span>\r\n                                <div class=\"co-status-reason\" data-bind=\"text: statusReason\"></div>\r\n                            </div>\r\n                            <div class=\"layout-column\" data-bind=\"visible: assignedDateTime\">\r\n                                {{#Translate}}ScheduledFor{{/Translate}} <span data-bind=\"text: assignedDateTime\"></span>\r\n                            </div>\r\n                            <div class=\"layout-column\">\r\n                                {{#Translate}}RequestedOn{{/Translate}} <span data-bind=\"text: dateRequested\"></span>\r\n                            </div>\r\n                            <div class=\"layout-column\" data-bind=\"text: reason\"></div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\" style=\"text-align: left\">\r\n                    <div class=\"flexbox horizontal padded\">\r\n                        <div class=\"auto\"></div>\r\n                        <div><button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">{{#Translate}}Close{{/Translate}}</button></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n"
