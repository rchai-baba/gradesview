   # DistrictName,    # Greeting,    .oen-nav-header,    body .container>h1 {        color: #000000 !important;    }    ');\r\nwindow.LoadRemoteScript('GBResources_exceljs_min_js', '/resources/GBResources/exceljs_min.js?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteScript('GBResources_FileSaver_min_js', '/resources/GBResources/FileSaver_min.js?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteStyleSheet('schemes_PXP2_PXP2_LanguageBar_css', '/schemes/PXP2/PXP2_LanguageBar.css?2026-03-29T12%3a03%3a23.0000000');\r\nwindow.LoadRemoteScript('js_PXP_PXP2_LanguageBar_js', '/js/PXP/PXP2_LanguageBar.js?2026-03-29T12%3a03%3a23.0000000');\r\n//]]>\r\n</script>\r\n\r\n<div>\r\n\r\n\t<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"256D6A7C\" />\r\n</div>\r\n                <div style=\"position:absolute; right:100%;display:inline-block;opacity:0\" aria-hidden=\"true\">\r\n                    <input name=\"fake-username\" tabindex=\"-1\" />\r\n                    <input type=\"password\" name=\"fake-password\" tabindex=\"-1\" />\r\n                </div>\r\n\r\n                \r\n                <div id=\"MainDiv\" style=\"position: relative;\">\r\n                    \r\n    <div class=\"student-summary\">\r\n    </div>\r\n\r\n                </div>\r\n\r\n                \r\n            </form>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script id=\"PXP.Switch\" type=\"text/html\">\r\n    <span class=\"switch\">\r\n        <span class=\"on\">{{onText}}</span>\r\n        <span class=\"toggle\"></span>\r\n        <span class=\"off\">{{offText}}</span>\r\n    </span>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SummaryChart.popover\">\r\n    <table><tbody>\r\n        {{#items}}\r\n        <tr>\r\n            <th>{{name}}:</th><td>{{value}}</td>\r\n        </tr>\r\n        {{/items}}\r\n    </tbody></table>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SummaryChart\">\r\n    <div class=\"pxp-summary-chart\">\r\n        {{#items}}\r\n        <div class=\"row\" data-action=\"{{detailAction}}\" data-guid=\"{{guid}}\" data-heading=\"{{heading}}\">\r\n            <div class=\"title col-md-6 col-xs-6\">{{title}}</div>\r\n            <div class=\"bar-container col-md-6 col-xs-6\" data-toggle=\"popover\" data-content=\"{{popoverContent}}\" data-title=\"{{title}}\">\r\n                <div class=\"bar\">\r\n                    {{#segments}}\r\n                    <div class=\"segment\" style=\"background-color:{{color}}; width:{{width}}%\"></div>\r\n                    {{/segments}}\r\n                </div>\r\n            </div>\r\n        </div>\r\n        {{/items}}\r\n    </div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SummaryDetailsHeading\">\r\n    <h1 style=\"margin-bottom: 0\">\r\n        <span class=\"subtitle\">{{title}}</span>\r\n        <a href=\"#\" data-action=\"CloseSummaryDetails\">{{{heading}}}</a>\r\n    </h1>\r\n    <div class=\"btn btn-link dismiss-btn\" data-action=\"CloseSummaryDetails\">\r\n        <span><i class=\"glyphicon glyphicon-chevron-down\"></i></span>\r\n        <span>Dismiss</span>\r\n        <span><i class=\"glyphicon glyphicon-chevron-down\"></i></span>\r\n    </div>\r\n    <div class=\"loader\"><span>\r\n        <img src=\"Images/PXP/OEN_ajax-loader_gray.gif\" alt=\"loading\" />\r\n        Please Wait...\r\n    </span></div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SchoolTermDetailGrids\">\r\n    <div class=\"pxp-ring-chart\">\r\n        {{#extraFields.length}}\r\n        <ul>\r\n            {{#extraFields}}\r\n            <li><span>{{name}}:</span><span>{{value}}</span></li>\r\n            {{/extraFields}}\r\n        </ul>\r\n        {{/extraFields.length}}\r\n    </div>\r\n    <div class=\"summary-details-table\">\r\n        {{#Legend}}{{/Legend}}\r\n\r\n        {{#Schools}}\r\n        <h2>{{SchoolName}} {{Year}}</h2>\r\n        <table class=\"table table-striped\">\r\n            <caption class=\"sr-only\">Attendance Details: {{SchoolName}} {{Year}}</caption>\r\n            <thead>\r\n                <tr>\r\n                    {{#Headings}}\r\n                    <th {{#colspan}}colspan=\"{{colspan}}\"{{/colspan}}>{{columnTitle}}</th>\r\n                    {{/Headings}}\r\n                </tr>\r\n            </thead>\r\n            {{#Terms}}\r\n            <thead>\r\n                <tr><th colspan=\"100%\">{{TermName}}</th></tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#Rows}}\r\n                <tr>\r\n                    {{#Cells}}\r\n                    <td>{{{.}}}</td>\r\n                    {{/Cells}}\r\n                </tr>\r\n                {{/Rows}}\r\n            </tbody>\r\n            {{/Terms}}\r\n        </table>\r\n        {{/Schools}}\r\n    </div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SummaryDetails\">\r\n    <div class=\"pxp-ring-chart\">\r\n        {{#extraFields.length}}\r\n        <ul>\r\n            {{#extraFields}}\r\n            <li><span>{{name}}:</span><span>{{value}}</span></li>\r\n            {{/extraFields}}\r\n        </ul>\r\n        {{/extraFields.length}}\r\n    </div>\r\n    <div class=\"summary-details-table\">\r\n        {{#Legend}}{{/Legend}}\r\n        <table class=\"table table-striped\">\r\n            <thead>\r\n                <tr>\r\n                    {{#headings}}\r\n                    <th {{#colspan}}colspan=\"{{colspan}}\"{{/colspan}}>{{columnTitle}}</th>\r\n                    {{/headings}}\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#rows}}\r\n                <tr>\r\n                    {{#cells}}\r\n                    <td>{{{.}}}</td>\r\n                    {{/cells}}\r\n                </tr>\r\n                {{/rows}}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n</script>\r\n\r\n\r\n<script id=\"PXP.Announcements\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        District Announcements\r\n    </div>\r\n\r\n    <div class=\"st-modal-content\">\r\n    \r\n            <span style=\"font-style:italic\">\r\n                None\r\n            </span>\r\n        \r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.StackItem.Heading\" type=\"text/html\">\r\n    <span>\r\n        {{{heading_text}}}\r\n    </span>\r\n</script>\r\n\r\n<script id=\"PXP.StackItem\" type=\"text/html\">\r\n    <div class=\"content-stack-item\">\r\n        {{#title}}\r\n        <h2>{{title}}</h2>\r\n        {{/title}}\r\n        <div class=\"loader\"><span>\r\n            <img width=\"100px\" src=\"Images/PXP/OEN_ajax-loader_gray.gif\" alt=\"loading\" />\r\n            Please Wait...\r\n        </span></div>\r\n    </div>\r\n</script>\r\n\r\n<iframe id=\"keepAliveFrame\" class=\"collapse\"></iframe>\r\n\r\n\r\n\r\n<script type=\"text/javascript\">CURRENT_WEB_PORTAL='StudentVUE';</script><script type=\"text/javascript\">FOCUS_KEY='';</script><script type=\"text/javascript\">applicationRoot='/';</script>\r\n\r\n<div class=\"component-loader-container\" data-bind=\"attr: { 'data-bound': 'true' }\">\r\n    <render-direct params=\"config:$root.config,isAdmin: $root.isAdmin\"></render-direct>\r\n    <!-- ko if: $data.componentInjector -->\r\n    <div id=\"component-injector-container\" data-bind=\"foreach: $data.componentInjector\">\r\n        <!-- ko component: $data -->\r\n        <!-- /ko -->\r\n    </div>\r\n    <!-- /ko -->\r\n</div>\r\n<script>\r\n    window.security = {\"googleAccessToken\":\"\",\"google_API_KEY\":\"\",\"google_CLIENT_ID\":\"\",\"microsoft_CLIENT_ID\":\"\",\"requestParams\":{\"regenerateSessionId\":\"true\"},\"_metaData\":{\"EGB_STU_CONF_MEETING\":{\"conference_gu\":{\"labelName\":\"Conference_Gu\",\"toolTip\":\"\",\"maxLength\":-1,\"isRequired\":false,\"allowEditing\":true,\"isVisible\":true,\"isNumeric\":false,\"labelName_plural\":\"Conference_Gu\",\"extraData\":{},\"defaultValue\":\"\"},\"done\":{\"labelName\":\"Done\",\"toolTip\":\"\",\"maxLength\":-1,\"