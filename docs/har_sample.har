                           {{#summaryInfo}}\r\n                            <tr class=\"{{rowClass}}\">\r\n                                <th scope=\"row\">{{name}}:</th>\r\n                                <td>{{value}}</td>\r\n                            </tr>\r\n                            {{/summaryInfo}}\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n                {{/hasCategories}}\r\n                {{#showClassGrades}}\r\n                <div style=\"text-align: center; width: 50%\">\r\n                    <h3 class=\"mark-counts\">Class Grades</h3>\r\n                    <canvas class=\"mark-counts\"></canvas>\r\n                </div>\r\n                {{/showClassGrades}}\r\n                <div>&nbsp;</div>\r\n            </div>\r\n        </div>\r\n    </script>\r\n\r\n    <script id=\"GB.MessagesTable\" type=\"text/html\">\r\n        <table class=\"table pres-table\">\r\n            <tbody>\r\n                {{#items}}\r\n    <tr data-guid=\"{{courseID}}\">\r\n        <td style=\"vertical-align: middle\">\r\n            <span class=\"icon\">{{{icon}}}</span>\r\n            <b>{{type}}:</b>\r\n        </td>\r\n        <td>\r\n            <span class=\"course\">{{courseTitle}}</span>\r\n            <span class=\"title\">{{{title}}}</span>\r\n        </td>\r\n        <td style=\"vertical-align: middle\">\r\n            <span style=\"color: #888888\">Available:</span>\r\n            <span class=\"available\">{{available}}</span>\r\n        </td>\r\n    </tr>\r\n                {{/items}}\r\n            </tbody>\r\n        </table>\r\n    </script>\r\n\r\n\r\n\r\n\r\n    <div id=\"df\" class=\"DFHiden\" name=\"df\">\r\n        <div class=\"MB\">\r\n            <table style=\"height: 100%\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\r\n                <tr style=\"background-color: #99CCFF\">\r\n                    <td>\r\n                        <img src=\"Images/PXP/TchComment.gif\" alt=\"tch comment\" />\r\n                    </td>\r\n                    <td width=\"100%\">\r\n                        <div class=\"MBHead\">\r\n                            Teacher Comment\r\n                        </div>\r\n                    </td>\r\n                    <td>\r\n                        <div class=\"MBHead\">\r\n                            <input type=\"button\" name=\"btnCloseD\" value=\"Close\" id=\"btnCloseD\" class=\"BtnClose\" style=\"width: 80px;\" onclick=\"HideDetail()\" />\r\n                        </div>\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td colspan=\"3\" id=\"tdDetail\" name=\"tdDetail\"></td>\r\n                </tr>\r\n            </table>\r\n        </div>\r\n    </div>\r\n    <div class=\"Pop_Hide\" id=\"OVERLAY\" name=\"OVERLAY\">\r\n    </div>\r\n    <div class=\"spinnerModal\"></div>\r\n\r\n                </div>\r\n\r\n                \r\n            </form>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script id=\"PXP.Switch\" type=\"text/html\">\r\n    <span class=\"switch\">\r\n        <span class=\"on\">{{onText}}</span>\r\n        <span class=\"toggle\"></span>\r\n        <span class=\"off\">{{offText}}</span>\r\n    </span>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SummaryChart.popover\">\r\n    <table><tbody>\r\n        {{#items}}\r\n        <tr>\r\n            <th>{{name}}:</th><td>{{value}}</td>\r\n        </tr>\r\n        {{/items}}\r\n    </tbody></table>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SummaryChart\">\r\n    <div class=\"pxp-summary-chart\">\r\n        {{#items}}\r\n        <div class=\"row\" data-action=\"{{detailAction}}\" data-guid=\"{{guid}}\" data-heading=\"{{heading}}\">\r\n            <div class=\"title col-md-6 col-xs-6\">{{title}}</div>\r\n            <div class=\"bar-container col-md-6 col-xs-6\" data-toggle=\"popover\" data-content=\"{{popoverContent}}\" data-title=\"{{title}}\">\r\n                <div class=\"bar\">\r\n                    {{#segments}}\r\n                    <div class=\"segment\" style=\"background-color:{{color}}; width:{{width}}%\"></div>\r\n                    {{/segments}}\r\n                </div>\r\n            </div>\r\n        </div>\r\n        {{/items}}\r\n    </div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SummaryDetailsHeading\">\r\n    <h1 style=\"margin-bottom: 0\">\r\n        <span class=\"subtitle\">{{title}}</span>\r\n        <a href=\"#\" data-action=\"CloseSummaryDetails\">{{{heading}}}</a>\r\n    </h1>\r\n    <div class=\"btn btn-link dismiss-btn\" data-action=\"CloseSummaryDetails\">\r\n        <span><i class=\"glyphicon glyphicon-chevron-down\"></i></span>\r\n        <span>Dismiss</span>\r\n        <span><i class=\"glyphicon glyphicon-chevron-down\"></i></span>\r\n    </div>\r\n    <div class=\"loader\"><span>\r\n        <img src=\"Images/PXP/OEN_ajax-loader_gray.gif\" alt=\"loading\" />\r\n        Please Wait...\r\n    </span></div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SchoolTermDetailGrids\">\r\n    <div class=\"pxp-ring-chart\">\r\n        {{#extraFields.length}}\r\n        <ul>\r\n            {{#extraFields}}\r\n            <li><span>{{name}}:</span><span>{{value}}</span></li>\r\n            {{/extraFields}}\r\n        </ul>\r\n        {{/extraFields.length}}\r\n    </div>\r\n    <div class=\"summary-details-table\">\r\n        {{#Legend}}{{/Legend}}\r\n\r\n        {{#Schools}}\r\n        <h2>{{SchoolName}} {{Year}}</h2>\r\n        <table class=\"table table-striped\">\r\n            <caption class=\"sr-only\">Attendance Details: {{SchoolName}} {{Year}}</caption>\r\n            <thead>\r\n                <tr>\r\n                    {{#Headings}}\r\n                    <th {{#colspan}}colspan=\"{{colspan}}\"{{/colspan}}>{{columnTitle}}</th>\r\n                    {{/Headings}}\r\n                </tr>\r\n            </thead>\r\n            {{#Terms}}\r\n            <thead>\r\n                <tr><th colspan=\"100%\">{{TermName}}</th></tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#Rows}}\r\n                <tr>\r\n                    {{#Cells}}\r\n                    <td>{{{.}}}</td>\r\n                    {{/Cells}}\r\n                </tr>\r\n                {{/Rows}}\r\n            </tbody>\r\n            {{/Terms}}\r\n        </table>\r\n        {{/Schools}}\r\n    </div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"PXP.SummaryDetails\">\r\n    <div class=\"pxp-ring-chart\">\r\n        {{#extraFields.length}}\r\n        <ul>\r\n            {{#extraFields}}\r\n            <li><span>{{name}}:</span><span>{{value}}</span></li>\r\n            {{/extraFields}}\r\n        </ul>\r\n        {{/extraFields.length}}\r\n    </div>\r\n    <div class=\"summary-details-table\">\r\n        {{#Legend}}{{/Legend}}\r\n        <table class=\"table table-striped\">\r\n            <thead>\r\n                <tr>\r\n                    {{#headings}}\r\n                    <th {{#colspan}}colspan=\"{{colspan}}\"{{/colspan}}>{{columnTitle}}</th>\r\n                    {{/headings}}\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#rows}}\r\n                <tr>\r\n                    {{#cells}}\r\n                    <td>{{{.}}}</td>\r\n                    {{/cells}}\r\n                </tr>\r\n                {{/rows}}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n</script>\r\n\r\n\r\n<script id=\"PXP.Announcements\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        District Announcements\r\n    </div>\r\n\r\n    <div class=\"st-modal-content\">\r\n    \r\n            <span style=\"font-style:italic\">\r\n                None\r\n            </span>\r\n        \r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.StackItem.Heading\" type=\"text/html\">\r\n    <span>\r\n        {{{heading_text}}}\r\n    </span>\r\n</script>\r\n\r\n<script id=\"PXP.StackItem\" type=\"text/html\">\r\n    <div class=\"content-stack-item\">\r\n        {{#title}}\r\n        <h2>{{title}}</h2>\r\n        {{/title}}\r\n        <div class=\"loader\"><span>\r\n            <img width=\"100px\" src=\"Images/PXP/OEN_ajax-loader_gray.gif\" alt=\"loading\" />\r\n            Please Wait...\r\n        </span></div>\r\n    </div>\r\n</script>\r\n\r\n<iframe id=\"keepAliveFrame\" class=\"collapse\"></iframe>\r\n\r\n\r\n\r\n<script type=\"text/javascript\">CURRENT_WEB_PORTAL='StudentVUE';</script><script type=\"text/javascript\">FOCUS_KEY='';</script><script type=\"text/javascript\">applicationRoot='/';</script>\r\n\r\n<div class=\"component-loader-container\" data-bind=\"attr: { 'data-bound': 'true' }\">\r\n    <render-direct params=\"config:$root.config,isAdmin: $root.isAdmin\"></render-direct>\r\n    <!-- ko if: $data.componentInjector -->\r\n    <div id=\"component-injector-container\" data-bind=\"foreach: $data.componentInjector\">\r\n        <!-- ko component: $data -->\r\n        <!-- /ko -->\r\n    </div>\r\n    <!-- /ko -->\r\n</div>\r\n<script>\r\n    window.security = {\"googleAccessToken\":\"\",\"google_API_KEY\":\"\",\"google_CLIENT_ID\":\"\",\"microsoft_CLIENT_ID\":\"\",\"requestParams\":{\"AGU\":\"0\",\"studentGU\":\"809B951C-2CCD-4791-BCCE-B9411EB37B08\"},\"_metaData\":{\"EGB_STU_CONF_MEETING\":{\"conference_gu\":{\"labelName\":\"Conference_Gu\",\"toolTip\":\"\",\"maxLength\":-1,\"isRequired\":false,\"allowEditing\":true,\"isVisible\":true,\"isNumeric\":false,\"labelName_plural\":\"Conference_Gu\",\"extraData\":{},\"defaultValue\":\"\"},\"done\":{\"labelName\":\"Done\",\"toolTip\":\"\",\"maxLength\":-1,\"isRequired\":false,\"allowEditing\":true,\"isVisible\":true,\"isNumeric\":false,\"labelName_plural\":\"Dones\",\"extraData\":{},\"defaultValue\":\"\"},\"id\":{\"labelName\":\"Id\",\"toolTip\":\"\",\"maxLength\":10,\"isRequired\":false,\"allowEditing\":true,\"isVisible\":true,\"isNumeric\":true,\"labelName_plural\":\"Ids\",\"extraData\":{},\"defaultValue\"