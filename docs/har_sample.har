            "text": "{\"d\":{\"__type\":\"PXP.PXPInfo.PXPWebResponse\",\"Error\":null,\"Data\":{\"Classes\":[{\"Name\":\"IB Ana \\u0026 App HL2/AP Calc BC H\",\"TeacherName\":\"Jason Watkins\",\"ID\":20456,\"Children\":[],\"ClassDetailControl\":\"Gradebook_ClassDetails\",\"IsStandardsAvailable\":false,\"IsCurriculumModuleEnabled\":false,\"IsPostsViewLinkAvailable\":false},{\"Name\":\"Symphony Orchestra H\",\"TeacherName\":\"Amanda Thoms\",\"ID\":20436,\"Children\":[],\"ClassDetailControl\":\"Gradebook_ClassDetails\",\"IsStandardsAvailable\":false,\"IsCurriculumModuleEnabled\":false,\"IsPostsViewLinkAvailable\":false},{\"Name\":\"AP Advanced Chemistry H (1 hr)\",\"TeacherName\":\"Julie Smallfield\",\"ID\":20254,\"Children\":[],\"ClassDetailControl\":\"Gradebook_ClassDetails\",\"IsStandardsAvailable\":false,\"IsCurriculumModuleEnabled\":false,\"IsPostsViewLinkAvailable\":false},{\"Name\":\"Student Leadership\",\"TeacherName\":\"Chelsea Berg\",\"ID\":20448,\"Children\":[],\"ClassDetailControl\":\"Gradebook_RichContentClassDetails\",\"IsStandardsAvailable\":false,\"IsCurriculumModuleEnabled\":false,\"IsPostsViewLinkAvailable\":false},{\"Name\":\"IB Spanish Blue H\",\"TeacherName\":\"Lisa Bonotto\",\"ID\":20553,\"Children\":[],\"ClassDetailControl\":\"Gradebook_RichContentClassDetails\",\"IsStandardsAvailable\":false,\"IsCurriculumModuleEnabled\":false,\"IsPostsViewLinkAvailable\":false},{\"Name\":\"Economics and Personal Finance H\",\"TeacherName\":\"Garrit Pickelmann\",\"ID\":20452,\"Children\":[],\"ClassDetailControl\":\"Gradebook_RichContentClassDetails\",\"IsStandardsAvailable\":false,\"IsCurriculumModuleEnabled\":false,\"IsPostsViewLinkAvailable\":false},{\"Name\":\"American Literature A\",\"TeacherName\":\"Andrew Frye\",\"ID\":20435,\"Children\":[],\"ClassDetailControl\":\"Gradebook_RichContentClassDetails\",\"IsStandardsAvailable\":false,\"IsCurriculumModuleEnabled\":false,\"IsPostsViewLinkAvailable\":false}],\"Subjects\":[],\"StandardSubjects\":[],\"IsSubjectVie