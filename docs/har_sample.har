              "value": "keep-alive"
            },
            {
              "name": "Referer",
              "value": "https://mi-mps.edupoint.com/PXP2_Gradebook.aspx?AGU=0&studentGU=809B951C-2CCD-4791-BCCE-B9411EB37B08"
            },
            {
              "name": "Cookie",
              "value": "ASP.NET_SessionId=ox5qzixivbbpkoki4lvzbxnh; EES_LB_303=971095108.1.435786848.742113280"
            },
