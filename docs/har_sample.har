            "text": "<st-slot name=\"'activator'\"></st-slot>\r\n<div class=\"st-ko-modal-container\" :css=\"{ 'fixed-height': fixedHeight }\" data-bind=\"visible: isOpen\">\r\n    <div class=\"st-ko-modal flexbox vertical\" :modal=\"isOpen\" :css=\"{ open: isOpen }\">\r\n        <div class=\"st-ko-modal-header\">\r\n            <span class=\"st-ko-modal-header-title\" :visible=\"title\" :text=\"title\"></span>\r\n            <div class=\"st-ko-modal-header-actions\">\r\n                <span class=\"fa fa-close\" @click=\"function() { isOpen(false) }\"></span>\r\n            </div>\r\n        </div>\r\n        <div class=\"st-ko-modal-content flexbox vertical auto\">\r\n            <st-slot class=\"flexbox vertical auto\"></st-slot>\r\n        </div>\r\n    </div>\r\n</div>"
