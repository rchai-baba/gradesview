          "content": {
            "mimeType": "application/javascript",
            "size": 5544,
            "text": "\r\n\r\nfunction dateAdd(date, type, amount) {\r\n    var y = date.getFullYear(),\r\n        m = date.getMonth(),\r\n        d = date.getDate();\r\n    if (type === 'y') {\r\n        y += amount;\r\n    };\r\n    if (type === 'm') {\r\n        m += amount;\r\n    };\r\n    if (type === 'd') {\r\n        d += amount;\r\n    };\r\n    return new Date(y, m, d);\r\n}\r\n\r\nfunction formatDate(date) {\r\n    return pad(date.getMonth() + 1, 2) + '/' + pad(date.getDate(), 2) + '/' + date.getFullYear();\r\n}\r\n\r\nfunction pad(n, width, z) {\r\n    z = z || '0';\r\n    n = n + '';\r\n\r\n    return n.length >= width ? n : new Array(width - n.length + 1).join(z) + n;\r\n}\r\n\r\nfunction toUTC(dt) {\r\n    return Date.UTC(dt.getFullYear(), dt.getMonth(), dt.getDate(), dt.getHours(), dt.getMinutes(), dt.getSeconds(), dt.getMilliseconds());\r\n}\r\n\r\nfunction timeSpan(time) {\r\n    return {\r\n        milliseconds: time,\r\n        seconds: time / 1000,\r\n        minutes: time / (1000 * 60),\r\n        hours: time / (1000 * 60 * 60),\r\n        days: time / (1000 * 60 * 60 * 24)\r\n    };\r\n};\r\n\r\n\r\n/**********************************\r\n  Change the view type in the calendar view\r\n    view = view type 0,1,2\r\n    dt = date to change perspective \r\n**********************************/\r\nfunction ChangeView(view, dt) {\r\n    var post = false;\r\n    try {\r\n        $('#LB').val(\"\");\r\n\r\n        var hidCLVar = document.getElementById(\"CL\");\r\n        hidCLVar.value = view;\r\n\r\n        var hidPDVar = document.getElementById(\"PD\");\r\n        hidPDVar.value = dt;\r\n\r\n        var form = document.getElementById(\"aspnetForm\");\r\n        form.submit();\r\n    }\r\n    catch (e) { HandleException(e); return '' }\r\n}//ChangeView\r\n\r\n/**********************************\r\n  Change the month perspective\r\n    direction = FWD / BCK\r\n**********************************/\r\nfunction Scroll(direction) {\r\n    var post = false;\r\n    try {\r\n        var hidCLVar = document.getElementById(\"CL\");\r\n        if (hidCLVar) {\r\n            hidCLVar.value = \" \";\r\n        }\r\n\r\n        var hidPDVar = document.getElementById(\"PD\");\r\n        if (hidPDVar) {\r\n            hidPDVar.value = \" \";\r\n        }\r\n\r\n        var lbList = document.getElementById(\"LB\");\r\n        //\talert (lbList.options.length + \" - \" + lbList.selectedIndex);\r\n        if (direction == \"BCK\") {\r\n            if (lbList.selectedIndex > 0) {\r\n                lbList.selectedIndex--;\r\n                post = true;\r\n            }\r\n            else {\r\n                alert(\"You are already at the beginning of the calendar\");\r\n            }\r\n        }\r\n        else {\r\n            if (lbList.selectedIndex < lbList.options.length - 1) {\r\n                lbList.selectedIndex++;\r\n                post = true;\r\n            }\r\n            else {\r\n                alert(\"You are already at the end of the calendar\");\r\n            }\r\n        }\r\n\r\n        if (post) {\r\n            var form = document.getElementById(\"aspnetForm\");\r\n            form.submit();\r\n        }\r\n\r\n    }\r\n    catch (e) { HandleException(e); return '' }\r\n}//Scroll\r\n\r\n\r\n// Show the detail for a row in the msg field\r\nfunction ShowDetail(divID) {\r\n    try {\r\n        var detView = document.getElementById(\"df\");\r\n        var detViewTD = document.getElementById(\"tdDetail\");\r\n        var detailData = document.getElementById(divID);\r\n\r\n        var eOver = document.getElementById(\"OVERLAY\");\r\n        if (eOver) {\r\n            eOver.className = \"Overlay\";\r\n            eOver.onclick = HideDetail;\r\n            if (document.getElementById && !document.all) // Detect FF\r\n            {\r\n                eOver.style.left = window.pageXOffset + \"px\";\r\n                eOver.style.top = window.pageYOffset + \"px\";\r\n                eOver.style.height = (window.innerHeight + window.scrollMaxY) + \"px\";\r\n            }\r\n            else // Just assume otherwise (IE) at this stage.\r\n            {\r\n                eOver.style.left = document.body.scrollLeft + \"px\";\r\n                eOver.style.top = document.body.scrollTop + \"px\";\r\n                eOver.style.height = document.body.clientHeight;\r\n            }\r\n        }\r\n        detViewTD.innerHTML = detailData.innerHTML;\r\n        detView.className = \"MBOuter\";\r\n        if (document.getElementById && !document.all) // Detect FF\r\n        {\r\n            detView.style.top = window.pageYOffset + \"px\";\r\n        }\r\n        else {\r\n            detView.style.top = (getScrollXY()[1] + 20) + \"px\";\r\n        }\r\n    }\r\n    catch (e) { HandleException(e); return '' }\r\n}//ShowDetail\r\n\r\nfunction getScrollXY() {\r\n    var scrOfX = 0, scrOfY = 0;\r\n    if (typeof (window.pageYOffset) == 'number') {\r\n        //Netscape compliant\r\n        scrOfY = window.pageYOffset;\r\n        scrOfX = window.pageXOffset;\r\n    }\r\n    else if (document.body && (document.body.scrollLeft || document.body.scrollTop)) {\r\n        //DOM compliant\r\n        scrOfY = document.body.scrollTop;\r\n        scrOfX = document.body.scrollLeft;\r\n    }\r\n    else if (document.documentElement && (document.documentElement.scrollLeft || document.documentElement.scrollTop)) {\r\n        //IE6 standards compliant mode\r\n        scrOfY = document.documentElement.scrollTop;\r\n        scrOfX = document.documentElement.scrollLeft;\r\n    }\r\n    return [scrOfX, scrOfY];\r\n}//getScrollXY\r\n\r\n// Hide the detail for the given row\r\nfunction HideDetail() {\r\n    try {\r\n        var detView = document.getElementById(\"df\");\r\n        detView.className = \"DFHiden\";\r\n        var eOver = document.getElementById(\"OVERLAY\");\r\n        eOver.className = \"Pop_Hide\";\r\n    }\r\n    catch (e) { HandleException(e); return '' }\r\n}//HideDetail\r\n"
          },
