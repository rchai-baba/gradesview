          "content": {
            "mimeType": "text/html",
            "size": 4555,
            "text": "<script id=\"PXP.LeftNav\" type=\"text/html\">\r\n    <div class=\"list-group pxp-left-nav\" role=\"list\" data-bind=\"foreach: items\">\r\n        <a class=\"list-group-item\" role=\"listitem\" data-bind=\"progressMessage: `Loading ${description}`, css: { active: !!activeClass }, attr: { href: enabled ? url : '#', 'data-desc': description }\">\r\n            <!-- ko if: iconExists -->\r\n                <img class=\"icon-gs\" width=\"24\" height=\"24\" style=\"margin-right:4px\" role=\"presentation\" alt=\"gs icon\" data-bind=\"attr: { src: moduleIcon }\" />\r\n                <img class=\"icon\" width=\"24\" height=\"24\" style=\"margin-right:4px\" role=\"presentation\" alt=\"icon\" data-bind=\"attr: { src: moduleIcon.replace('_gs', '') }\" />\r\n            <!-- /ko -->\r\n            <span class=\"desc\" data-bind=\"html: description\"></span>\r\n            <span data-bind=\"html: notificationIcon\"></span>\r\n        </a>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.MobileHeader\" type=\"text/html\">\r\n    <header id=\"MobileHeader\" class=\"mobile-header\">\r\n        <div class=\"pull-right dropdown\">\r\n            <button type=\"button\" class=\"btn dropdown-toggle\" data-toggle=\"dropdown\"  aria-haspopup=\"true\" aria-expanded=\"false\">\r\n                <span class=\"fa fa-user-circle\" role=\"presentation\"></span>\r\n                <span class=\"sr-only\">Main Menu</span>\r\n                <span class=\"caret\" role=\"presentation\"></span>\r\n            </button>\r\n            <div class=\"dropdown-menu main-nav\">\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"layout-table middle\">\r\n            <div class=\"layout-column\" data-bind=\"if: enableBackButton\">\r\n                <a class=\"pxp-launch-btn-goback btn btn-default flexbox horizontal\" href=\"PXP2_LaunchPad.aspx\">\r\n                    <span class=\"fa fa-chevron-left\" role=\"presentation\"></span>\r\n                    <span>{{#Translate}}GoBack{{/Translate}}</span>\r\n                </a>\r\n            </div>\r\n            <div class=\"layout-column\" data-bind=\"if: students.length\">\r\n                <div class=\"btn-group dropdown\">\r\n                    <button type=\"button\" class=\"btn dropdown-toggle\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\r\n                        <span data-bind=\"text: currentStudent\"></span>\r\n                        <span class=\"caret\" role=\"presentation\"></span>\r\n                    </button>\r\n                    <ul class=\"dropdown-menu student-list\" data-bind=\"foreach: students\">\r\n                        <li>\r\n                            <div class=\"layout-table top\" data-bind=\"click: loadStudent\">\r\n                                <div class=\"student-photo layout-column\">\r\n                                    <img alt=\"Student Photo\" width=\"40\" height=\"50\" data-bind=\"attr: { src: photo }\">\r\n                                    <span class=\"student-id\" data-bind=\"text: 'ID: ' + sisNumber\"></span>\r\n                                </div>\r\n                                <div class=\"layout-column\">\r\n                                    <span class=\"student-name\" data-bind=\"text: name\"></span>\r\n                                    <div class=\"school\" data-bind=\"text: school\"></div>\r\n                                    <div class=\"phone\" data-bind=\"text: '(' + phone + ')'\"></div>\r\n                                </div>\r\n                            </div>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            <div class=\"layout-column\">\r\n                <div class=\"btn-group dropdown\">\r\n                    <button type=\"button\" class=\"btn dropdown-toggle btn-nav-dropdown\" data-toggle=\"dropdown\" aria-haspopup=\"true\" aria-expanded=\"false\">\r\n                        <span class=\"sr-only\">{{#Translate}}CurrentModule{{/Translate}}</span>\r\n                        <!-- ko with: activeModule -->\r\n                            <!-- ko if: iconExists -->\r\n                            <img class=\"icon\" width=\"24\" height=\"24\" style=\"margin-right:4px\" role=\"presentation\" alt=\"icon\" data-bind=\"attr: { src: moduleIcon.replace('_gs', '') }\" />\r\n                            <!-- /ko -->\r\n                            <span class=\"desc\" data-bind=\"html: description\"></span>\r\n                        <!-- /ko -->\r\n                        <span class=\"caret nav-dropdown-icon\" role=\"presentation\"></span>\r\n                    </button>\r\n                    <div class=\"dropdown-menu\">\r\n                        {{>PXP.LeftNav}}\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </header>\r\n</script>"
