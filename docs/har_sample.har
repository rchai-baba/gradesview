          "content": {
            "mimeType": "text/javascript",
            "size": 718,
            "text": "export default class StSlotVM extends KOBaseComponent {\r\n    constructor(params, componentInfo) {\r\n        super(params, componentInfo);\r\n        this.name = observableFromParam(params.name);\r\n        this.nodes = this.getNodes();\r\n    }\r\n\r\n    getNodes() {\r\n        const nodes = ko.contextFor(this.$componentInfo.element).$componentTemplateNodes;\r\n\r\n        if (!this.name()) return nodes;\r\n\r\n        const templateNode = nodes.find(n => n.nodeName === 'TEMPLATE');\r\n        const templateContents = templateNode?.content?.childNodes ?? [];\r\n        return templateContents;\r\n\r\n        //return nodes.find(n => n.nodeName === 'TEMPLATE' && n.getAttribute('name') === this.name())?.content.childNodes ?? [];\r\n    }\r\n}"
          },
