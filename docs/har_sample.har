            "text": ".st-ko-modal-container {\r\n    width: 100vw;\r\n    height: 100vh;\r\n    position: fixed;\r\n    top: 0;\r\n    left: 0;\r\n    display: flex;\r\n    z-index: 100;\r\n    background-color: rgba(0, 0, 0, 0.3);\r\n    align-items: center;\r\n    justify-content: center;\r\n}\r\n\r\n.st-ko-modal-container.fixed-height {\r\n    align-items: initial;\r\n}\r\n\r\n.st-ko-modal-container.fixed-height .st-ko-modal {\r\n    margin-top: 20px;\r\n    max-height: 90vh;\r\n}\r\n\r\nst-ko-modal .st-ko-modal {\r\n    width: 90%;\r\n    max-height: 85vh;\r\n    background-color: var(--st-panel-bg, var(--st-card-bg, #fff));\r\n    border-radius: 8px;\r\n    padding: 8px;\r\n    will-change: transform;\r\n}\r\n\r\nst-ko-modal .st-ko-modal.open {\r\n    animation: fadeInAndScale 150ms ease-in-out;\r\n}\r\n\r\nst-ko-modal .st-ko-modal-content {\r\n    overflow: auto;\r\n}\r\n\r\n@keyframes fadeInAndScale {\r\n    0% {\r\n        /*opacity: 0;*/\r\n        transform: scale(0.25);\r\n    }\r\n\r\n    100% {\r\n        /*opacity: 1;*/\r\n        transform: scale(1);\r\n    }\r\n}\r\n\r\n.st-ko-modal-header {\r\n    display: flex;\r\n    padding: 8px;\r\n}\r\n\r\n.st-ko-modal-header-title {\r\n    flex-grow: 1;\r\n    font-weight: bold;\r\n    font-size: 16px;\r\n}\r\n\r\n.st-ko-modal-header-actions > span {\r\n    cursor: pointer;\r\n}\r\n\r\n@media (min-width: 767px) {\r\n    st-ko-modal .st-ko-modal {\r\n        width: 75%;\r\n    }\r\n}\r\n"
