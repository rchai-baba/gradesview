            "text": "/*\r\n    GB MAIN PAGE LAYOUT\r\n*/\r\n#maincontent h2 {\r\n    background-color: var(--st-color-border);\r\n    color: var(--st-color-fg);\r\n    padding: 5px;\r\n    border-radius: 2px;\r\n}\r\n\r\n#gradebook-content .pres-table > div > .gb-class-row > div.class-item-lessemphasis,\r\n#gradebook-content .pres-table > div > .gb-class-row > div .class-item-lessemphasis {\r\n    font-size: 1.25rem;\r\n}\r\n\r\n.gb-view-selection {\r\n    padding: 4px;\r\n}\r\n\r\n    .gb-view-selection:not(.link) {\r\n        font-weight: bold;\r\n    }\r\n\r\n#GradebookHeader {\r\n    display: inline-block;\r\n}\r\n\r\n.course-content-header-link {\r\n    float: right;\r\n    padding: 12px;\r\n    color: #428bca;\r\n    font-size: 1.2em;\r\n}\r\n\r\n    .course-content-header-link:hover {\r\n        color: #2a6496;\r\n        cursor: pointer;\r\n    }\r\n\r\n.gradebook-class-selector {\r\n    float: right;\r\n}\r\n\r\n.gb-classdetail-missingassignments {\r\n    color: #FF0000;\r\n    font-size: 2rem;\r\n    text-align: center;\r\n}\r\n\r\n.gb-standards-grid-row-assignment-hd td.gb-standards-grid-cell-standard,\r\n.gb-standards-grid-row-assignment-hd td.gb-standards-grid-cell {\r\n    background: #dddddd;\r\n}\r\n\r\n.gb-standards-grid-row-assignment-last .gb-standards-grid-cell-standard,\r\n.gb-standards-grid-row-assignment-last .gb-standards-grid-cell {\r\n    border-bottom: 3px solid #dddddd;\r\n}\r\n\r\ntr.gb-standards-grid-row-parent-standard td.gb-standards-grid-cell-standard {\r\n    background: #e2e6ea;\r\n    font-weight: bold;\r\n}\r\n\r\ntr.gb-standards-grid-row-standard td.gb-standards-grid-cell-standard {\r\n    padding-left: 15px;\r\n}\r\n\r\n.gb-standards-assignment-small-only {\r\n    display: none;\r\n}\r\n\r\n.gb-standards-assignment {\r\n    width: 50%;\r\n    float: left;\r\n}\r\n\r\n.gb-standards-assignment-type {\r\n    width: 25%;\r\n    float: left;\r\n}\r\n\r\n.gb-standards-assignment-date {\r\n    width: 25%;\r\n    float: left;\r\n}\r\n\r\n.info-item-class-details {\r\n    font-size: 1.2rem;\r\n    font-weight: normal;\r\n}\r\n\r\nh1.title,\r\nh2.title,\r\nh1 .title,\r\nh2 .title {\r\n    font-size: 2rem;\r\n}\r\n\r\ntr.hover-highlight:hover {\r\n    background-color: #efefef;\r\n}\r\n\r\n.gb-class-header.teacher-header-row,\r\n.gb-class-header.header-row {\r\n    padding-left: 0px;\r\n}\r\n\r\n    .gb-class-header.teacher-header-row > div,\r\n    .gb-class-header.header-row > div {\r\n        padding: 8px;\r\n    }\r\n\r\n#gradebook-content .pres-table.table > div > .gb-class-row:not(.details) > div.gb-subjects-list {\r\n    border: 1px solid #efefef;\r\n    background-color: var(--st-color-bg);\r\n}\r\n\r\n.pxp-class-selector {\r\n    position: relative;\r\n    padding: 5px 5px 0 5px;\r\n    display: inline-block;\r\n    border: 1px solid #cccccc;\r\n    border-radius: 0.5em;\r\n    z-index: 5;\r\n    background-color: #ffffff;\r\n}\r\n\r\n    .pxp-class-selector > .current {\r\n        display: inline-block;\r\n    }\r\n\r\n        .pxp-class-selector > .current > * {\r\n            display: table-cell;\r\n            vertical-align: middle;\r\n        }\r\n\r\n        .pxp-class-selector > .current .split-btn {\r\n            padding: 10px;\r\n            vertical-align: middle;\r\n            border-left: 1px solid #cccccc;\r\n        }\r\n\r\n    .pxp-class-selector .class-item-info {\r\n        cursor: pointer;\r\n    }\r\n\r\n    .pxp-class-selector > ul > li {\r\n        position: relative;\r\n        display: block;\r\n        padding: 3px;\r\n        clear: both;\r\n    }\r\n\r\n    .pxp-class-selector.open > ul > li:hover {\r\n        background-color: #bbddff;\r\n        border-radius: 5px 5px 0 0;\r\n        cursor: pointer;\r\n    }\r\n\r\n    .pxp-class-selector > ul > li + li {\r\n        border-top: 1px solid #cccccc;\r\n    }\r\n\r\n    .pxp-class-selector:not(.open) > ul > li:not(.active) {\r\n        display: none;\r\n        visibility: hidden;\r\n    }\r\n\r\n    .pxp-class-selector li > button {\r\n        display: inline-block;\r\n        background-color: transparent;\r\n        border: 0 none;\r\n        border-left: 1px solid #cccccc;\r\n        float: right;\r\n        height: 60px;\r\n    }\r\n\r\n    .pxp-class-selector .class-item-name {\r\n        font-size: 1.5rem;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .pxp-class-selector .class-list {\r\n        left: auto;\r\n        right: 0;\r\n    }\r\n\r\n.gb-class-row.details {\r\n    max-height: 0px;\r\n    overflow: hidden;\r\n}\r\n\r\n    .gb-class-row.details.show-details {\r\n        max-height: 500px;\r\n    }\r\n\r\n.breadcrumb-term,\r\n.breadcrumb-text {\r\n    display: inline-block;\r\n}\r\n\r\n.class-item-info {\r\n    font-size: .9em;\r\n    white-space: nowrap;\r\n    padding: 0 5px 0 0;\r\n}\r\n\r\n    .class-item-info h2 {\r\n        border: 0 none;\r\n        color: #3276c0;\r\n        margin: 0;\r\n        font: bold large arial,helvetica,sans-serif;\r\n    }\r\n\r\n    .class-item-info .teacher-photo {\r\n        float: left;\r\n        margin: 5px;\r\n        text-align: center;\r\n    }\r\n\r\n        .class-item-info .teacher-photo img {\r\n            border-radius: 5px;\r\n        }\r\n\r\n    .class-item-info:after {\r\n        content: \"\";\r\n        display: table;\r\n        clear: both;\r\n    }\r\n\r\n.gb-class-header .teacher-multi-line {\r\n    display: flex;\r\n    flex-direction: row;\r\n}\r\n\r\n    .gb-class-header .teacher-multi-line > span.teacher {\r\n        display: flex;\r\n        flex-direction: column;\r\n        float: left;\r\n    }\r\n\r\n        .gb-class-header .teacher-multi-line > span.teacher > span,\r\n        .gb-class-header span.teacher.teacher-multi-line {\r\n            display: block;\r\n            float: left;\r\n        }\r\n\r\n    .gb-class-header .teacher-multi-line .teacher-room {\r\n        display: block;\r\n        float: right;\r\n    }\r\n\r\n.teacher-room {\r\n    font-size: 1.2rem;\r\n    margin-left: 10px;\r\n    display: inline;\r\n}\r\n\r\n.table {\r\n    margin-bottom: 40px;\r\n}\r\n\r\n.ScoreLegend table.info_tbl {\r\n    margin-bottom: 0px;\r\n}\r\n\r\n.ScoreLegend .column-header {\r\n    text-align: center;\r\n}\r\n\r\n.pxp-panel {\r\n    padding: 0 10px;\r\n}\r\n\r\n#gradebook-content #gb-classes,\r\n#gradebook-content #gb-status {\r\n    display: block;\r\n}\r\n\r\n#gb-assignments img.icon,\r\n#gb-messages .icon > img {\r\n    display: inline-block;\r\n    width: 32px;\r\n    vertical-align: middle;\r\n    padding: 2px;\r\n    border: 2px solid #d7dad7;\r\n    border-radius: 5px;\r\n}\r\n\r\nbody .gb-class-details,\r\nbody.AccessibilityMode #gradebook-content .data-table > tbody > tr.details:not(.show-details),\r\nbody #gradebook-content .data-table > .gb-class-table-header,\r\nbody:not(.AccessibilityMode) #gb-recent-history .data-table > thead,\r\nbody:not(.AccessibilityMode) #gb-messages .data-table > thead {\r\n    display: none;\r\n    visibility: hidden;\r\n}\r\n\r\n.table tr.details > td {\r\n    padding: 0px;\r\n}\r\n\r\n    .table tr.details > td > div {\r\n        max-height: 0;\r\n        overflow: hidden;\r\n        transition: max-height ease .5s;\r\n    }\r\n\r\n.table tr.details.show-details > td > div {\r\n    max-height: 500px;\r\n}\r\n\r\n.table tr.show-details .fa-plus:before {\r\n    content: \"\\f068\";\r\n}\r\n\r\n.table th {\r\n    white-space: nowrap;\r\n}\r\n\r\nspan.error {\r\n    color: red;\r\n}\r\n\r\n#UploadProgress.complete {\r\n    display: none;\r\n}\r\n\r\n.file-source-item {\r\n    width: 200px;\r\n    padding: 5px;\r\n    position: relative;\r\n}\r\n\r\n    .file-source-item img {\r\n        display: inline-block;\r\n        margin-right: 5px;\r\n        vertical-align: top;\r\n    }\r\n\r\n    .file-source-item div {\r\n        display: inline-block;\r\n    }\r\n\r\n    .file-source-item label {\r\n        display: block;\r\n    }\r\n\r\n    .file-source-item small {\r\n        display: block;\r\n    }\r\n\r\n    .file-source-item i {\r\n        display: inline-block;\r\n        position: absolute;\r\n        right: 5px;\r\n        top: 15px;\r\n    }\r\n/*\r\n    CLASSES AND CLASS DETAILS\r\n*/\r\n\r\n.inline {\r\n    display: inline;\r\n}\r\n\r\n#gradebook-content .pres-table {\r\n    white-space: nowrap;\r\n}\r\n\r\n#gradebook-content .data-table.table tr.details .layout-table {\r\n    width: 100%;\r\n    margin: 5px;\r\n}\r\n\r\n#gradebook-content .pres-table.table > div > .gb-class-row:not(.details) {\r\n    background-color: var(--st-color-bg);\r\n    \r\n}\r\n\r\n#gradebook-content .pres-table.table > div > .gb-class-row.data-row:not(.details) {\r\n    background-color: var(--st-color-bg);\r\n}\r\n\r\n\r\n.gb-class-row {\r\n    flex-wrap: wrap;\r\n    margin-left: 0px;\r\n    margin-right: 0px;\r\n    padding-left: 5px;\r\n}\r\n\r\n.flex-wrap {\r\n    flex-wrap: wrap;\r\n}\r\n\r\n.gb-class-row:nth-child(n+2) {\r\n    border-top: #ddd solid 1px;\r\n}\r\n\r\n.gb-class-row.details.show-details {\r\n    display: initial;\r\n}\r\n\r\n#gradebook-content .pres-table.table > div > .gb-class-row:not(.details) > div > div,\r\n#gradebook-content .pres-table.table > div > .gb-class-row:not(.details) > div {\r\n    margin-top: auto;\r\n    margin-bottom: auto;\r\n    flex: 1 1;\r\n}\r\n\r\n#gradebook-content .pres-table > div > .gb-class-row > div {\r\n    font-size: 1.25em;\r\n    vertical-align: middle;\r\n    font-weight: normal;\r\n    color: var(--st-color-fg);\r\n}\r\n\r\n#gradebook-content .pres-table .last-update {\r\n    display: block;\r\n    font-size: 12px;\r\n    text-align: center;\r\n}\r\n\r\n#gradebook-content .pres-table h3 {\r\n    text-align: center;\r\n}\r\n\r\n#gradebook-content .pres-table .subtitle {\r\n    display: block;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n#gradebook-content .pres-table .student-categories {\r\n    margin: 15px 10px;\r\n    width: 100%;\r\n    height: 200px;\r\n}\r\n\r\n#gradebook-content .pres-table .info-table .top-row div,\r\n#gradebook-content .pres-table .info-table .top-row div {\r\n    border-top: 0 none;\r\n}\r\n\r\n#gradebook-content .data-table .photo {\r\n    width: 1%;\r\n}\r\n\r\n#gradebook-content .data-table .teacher-photo {\r\n    width: 48px;\r\n    border-radius: 5px;\r\n}\r\n\r\n#gradebook-content .data-table .period {\r\n    font-size: 2em;\r\n    width: 1%;\r\n}\r\n\r\n#gradebook-content .data-table .course-title {\r\n    font-weight: bold;\r\n    display: block;\r\n    text-align: left;\r\n    padding-left: 0;\r\n    font-size: 1.2em;\r\n}\r\n\r\n#gradebook-content .data-table .subject-header {\r\n    text-align: left;\r\n    padding-left: 0;\r\n    font-size: .9em;\r\n}\r\n\r\n#gradebook-content .data-table .course-markperiod {\r\n    font-weight: normal;\r\n    text-align: left;\r\n    padding-left: 0;\r\n    font-size: 1.2em;\r\n}\r\n\r\n#gradebook-content .data-table .links {\r\n    display: inline-block;\r\n}\r\n\r\n#gradebook-content .data-table .mark {\r\n    min-width: 50px;\r\n    font-weight: bold;\r\n    font-size: 1.7em;\r\n    background-color: var(--st-color-row-light-bg);\r\n}\r\n\r\n#gradebook-content .data-table .mark,\r\n#gradebook-content .data-table .score {\r\n    text-align: center;\r\n    display: block;\r\n}\r\n\r\n#gradebook-content .data-table .score {\r\n    font-size: .8em;\r\n}\r\n\r\n#gradebook-content .data-table .data-row > div {\r\n    background-color: var(--st-color-bg) !important;\r\n}\r\n\r\n.gb-expand-all {\r\n    display: block;\r\n}\r\n\r\ncanvas.sparkline {\r\n    width: 100%;\r\n    min-width: 200px;\r\n    max-width: 500px;\r\n    height: 60px;\r\n}\r\n\r\ncanvas.mark-counts {\r\n    width: 150px;\r\n    height: 150px;\r\n}\r\n\r\n/*\r\n    CLASS DETAILS PANEL\r\n*/\r\n\r\n#gradebook-content-container, #class-details {\r\n    position: relative;\r\n    display: block;\r\n    overflow: hidden;\r\n}\r\n\r\n#assignment-details {\r\n    float: left;\r\n}\r\n\r\n.detail-content {\r\n    position: relative;\r\n}\r\n\r\n    .detail-content .heading .photo > img {\r\n        width: 64px;\r\n        border-radius: 5px;\r\n        margin: 5px;\r\n    }\r\n\r\n    .detail-content .heading .course-title {\r\n        font-weight: bold;\r\n        display: block;\r\n        min-width: 130px;\r\n    }\r\n\r\n    .detail-content .heading .teacher {\r\n        color: #888888;\r\n    }\r\n\r\n    .detail-content .heading .layout-column {\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .detail-content #current-grade {\r\n        display: inline-block;\r\n        background-color: #008c7d;\r\n        border-radius: 2em;\r\n        color: white;\r\n        font-size: 2.5em;\r\n        margin: 30px;\r\n        padding: 25px;\r\n        white-space: nowrap;\r\n        text-align: center;\r\n        min-width: 155px;\r\n        min-height: 175px;\r\n    }\r\n\r\n        .detail-content #current-grade .mark {\r\n            margin-top: 20px;\r\n            background-color: #008c7d;\r\n        }\r\n\r\n        .detail-content #current-grade .score {\r\n            font-size: 0.8em;\r\n        }\r\n\r\n#what-if-grade {\r\n    display: inline-block;\r\n    background-color: #bbddff;\r\n    border-radius: 2em;\r\n    color: #555;\r\n    font-size: 2.5em;\r\n    margin: 30px;\r\n    padding: 25px;\r\n    white-space: nowrap;\r\n    display: none;\r\n    position: relative;\r\n    text-align: center;\r\n}\r\n\r\n    #what-if-grade .pill-label {\r\n        font-size: 0.4em;\r\n    }\r\n\r\n#what-if-max-score {\r\n    text-align: center;\r\n    font-size: 0.8em;\r\n    white-space: normal;\r\n}\r\n\r\n.detail-content #category-graph {\r\n    padding: 15px;\r\n    flex-grow: 1;\r\n    flex-shrink: 1;\r\n    overflow: hidden;\r\n}\r\n\r\n.detail-content #assignment-graph {\r\n    margin-bottom: 15px;\r\n}\r\n\r\nbody:not(.AccessibilityMode) .detail-content #category-graph .data-table {\r\n    display: none;\r\n    visibility: hidden;\r\n}\r\n\r\n.detail-content canvas.bar-graph {\r\n    width: 100%;\r\n    height: 200px;\r\n}\r\n\r\nbody.AccessibilityMode .detail-content canvas.bar-graph {\r\n    display: none;\r\n    visibility: hidden;\r\n}\r\n\r\n.detail-content canvas.whisker-graph {\r\n    width: 100%;\r\n    height: 200px;\r\n}\r\n\r\nbody.AccessibilityMode .detail-content canvas.whisker-graph {\r\n    display: none;\r\n    visibility: hidden;\r\n}\r\n\r\nbody:not(.AccessibilityMode) .detail-content #assignment-graph .data-table {\r\n    display: none;\r\n    visibility: hidden;\r\n}\r\n\r\n/*\r\n    RECENT HISTORY TABLE\r\n*/\r\nbody.AccessibilityMode .gb-recent-history-container > .pres-table,\r\nbody:not(.AccessibilityMode) .gb-recent-history-container > .data-table {\r\n    display: none;\r\n    visibility: hidden;\r\n}\r\n\r\n#gb-recent-history .gb-recent-history-container {\r\n    padding: 0 20px 0 0;\r\n    overflow-y: auto;\r\n    max-height: 450px;\r\n    min-height: 100%;\r\n}\r\n\r\n#gb-recent-history .pres-table {\r\n    white-space: nowrap;\r\n}\r\n\r\n    #gb-recent-history .pres-table .course {\r\n        display: block;\r\n        color: #888888;\r\n    }\r\n\r\n    #gb-recent-history .pres-table .points {\r\n        display: block;\r\n    }\r\n\r\n    #gb-recent-history .pres-table .due-date {\r\n        display: block;\r\n        color: #cccccc;\r\n    }\r\n\r\n    #gb-recent-history .pres-table .percentage-slider {\r\n        position: relative;\r\n        display: inline-block;\r\n        min-width: 200px;\r\n        height: 32px;\r\n        vertical-align: middle;\r\n        border-left: 1px solid #cccccc;\r\n    }\r\n\r\n        #gb-recent-history .pres-table .percentage-slider > .background {\r\n            position: absolute;\r\n            display: inline-block;\r\n            left: 0;\r\n            top: 5px;\r\n            width: 100%;\r\n            bottom: 5px;\r\n            background-color: #ddd;\r\n        }\r\n\r\n        #gb-recent-history .pres-table .percentage-slider > .slider {\r\n            border-right: 2px solid #888888;\r\n            position: absolute;\r\n            display: inline-block;\r\n            left: 0;\r\n            top: 0;\r\n            bottom: 0;\r\n            max-width: 100%;\r\n        }\r\n\r\n            #gb-recent-history .pres-table .percentage-slider > .slider > .fill {\r\n                position: absolute;\r\n                display: inline-block;\r\n                margin: 5px 0;\r\n                left: 0;\r\n                top: 0;\r\n                bottom: 0;\r\n                width: 100%;\r\n            }\r\n\r\n    #gb-recent-history .pres-table .percentage {\r\n        display: inline-block;\r\n        vertical-align: middle;\r\n        font-size: 1.5em;\r\n        color: #888888;\r\n    }\r\n\r\n/*\r\n    TASKS AND MESSAGES\r\n*/\r\nbody.AccessibilityMode #gb-messages > .pres-table,\r\nbody:not(.AccessibilityMode) #gb-messages > .data-table {\r\n    display: none;\r\n    visibility: hidden;\r\n}\r\n\r\n#gb-messages .pres-table .course {\r\n    display: block;\r\n    color: #888888;\r\n}\r\n\r\n#gb-messages .pres-table a {\r\n    font-weight: bold;\r\n}\r\n\r\n#gb-messages .pres-table .course {\r\n    display: block;\r\n    color: #888888;\r\n}\r\n\r\n#gb-messages .pres-table .available {\r\n    display: block;\r\n}\r\n\r\n/*\r\n    UPCOMING ASSIGNMENTS\r\n*/\r\n#gb-assignments .table td,\r\n#gb-assignments .table th {\r\n    vertical-align: middle;\r\n}\r\n\r\n/*\r\n    GRADE BOOK WHAT IF\r\n*/\r\n#AssignmentsGrid .dx-datagrid-group-opened, #AssignmentsGrid .dx-datagrid-group-closed {\r\n    font-family: var(--fa-style-family,\"Font Awesome 6 Pro\");\r\n    font-size: 14px;\r\n    font-weight: 900;\r\n    -webkit-font-smoothing: antialiased;\r\n    display: inline-block;\r\n    font-style: normal;\r\n    font-variant: normal;\r\n    text-rendering: auto;\r\n    line-height: 1;\r\n}\r\n\r\n    #AssignmentsGrid .dx-datagrid-group-opened:before, #AssignmentsGrid .dx-datagrid-group-closed:before {\r\n        content: \"\\f1ec\";\r\n    }\r\n\r\n.gradebook-what-if-container {\r\n    text-align: center;\r\n    white-space: normal;\r\n}\r\n\r\n    .gradebook-what-if-container .what-if-text {\r\n        padding: 5px;\r\n        background-color: rgba(200,225,255,.4);\r\n    }\r\n\r\n    .gradebook-what-if-container .what-if-score {\r\n        font-size: 2em;\r\n        background-color: rgba(200,225,255,.2);\r\n        padding: 5px;\r\n    }\r\n\r\n    .gradebook-what-if-container .text-row {\r\n        margin-top: 20px;\r\n        background-color: rgba(200,225,255,.4);\r\n        padding: 10px;\r\n        margin-right: 0px;\r\n    }\r\n\r\n    .gradebook-what-if-container .control-container-row {\r\n        background-color: rgba(200,225,255,.2);\r\n        margin-right: 0px;\r\n    }\r\n\r\n    .gradebook-what-if-container .control-container {\r\n        padding: 15px 15px 20px 25px;\r\n    }\r\n\r\n    .gradebook-what-if-container .info-text {\r\n        font-size: 1.5em;\r\n    }\r\n\r\n.gradebook-what-if-slider {\r\n    font-size: 1.5em !important;\r\n}\r\n\r\n    .gradebook-what-if-slider .dx-slider-label {\r\n        top: -20px;\r\n    }\r\n\r\n.gradebook-what-if-group {\r\n    width: 100%;\r\n    overflow: visible;\r\n}\r\n\r\n    .gradebook-what-if-group .score-item {\r\n        font-size: 1.5em;\r\n    }\r\n\r\n.g-logo {\r\n    width: 20px;\r\n    height: 20px;\r\n    display: inline-block;\r\n    background-repeat: no-repeat;\r\n    background-image: url('data:image/png;base64,');\r\n}\r\n\r\n#category-graph > div > span.category-graph-icon {\r\n    color: #c0c0c0;\r\n}\r\n\r\n#category-graph > div > span.category-graph-icon.selected {\r\n    color: #333;\r\n    font-weight: bold;\r\n}\r\n\r\n.font-size-if-needed {\r\n    font-size: unset;\r\n}\r\n\r\n\r\n\r\n@media (max-width:767px) {\r\n    .course-content-header-link {\r\n        float: none;\r\n        text-align: end;\r\n    }\r\n\r\n    .gb-standards-grid-row-assignment-hd .gb-standards-assignment,\r\n    .gb-standards-grid-row-assignment-hd .gb-standards-assignment-type,\r\n    .gb-standards-grid-row-assignment-hd .gb-standards-assignment-date {\r\n        display: none;\r\n    }\r\n\r\n    .gb-standards-assignment-small-only {\r\n        float: left;\r\n        display: initial;\r\n    }\r\n\r\n    .gb-standards-assignment {\r\n        width: inherit;\r\n        float: none;\r\n    }\r\n\r\n    .gb-standards-assignment-type {\r\n        width: inherit;\r\n        float: none;\r\n    }\r\n\r\n    .gb-standards-assignment-date {\r\n        width: inherit;\r\n        float: none;\r\n    }\r\n\r\n\r\n}\r\n\r\n@media (max-width:480px) {\r\n    .gb-assigment-grid-always-show {\r\n        font-size: 12px;\r\n    }\r\n\r\n    .gb-standards-grid-cell,\r\n    .gb-standards-grid-cell-standard {\r\n        font-size: 12px;\r\n    }\r\n}\r\n\r\n@media (max-width:470px) {\r\n    .gb-class-row .padding {\r\n        display: none;\r\n    }\r\n\r\n    #gradebook-content .pres-table > div > .gb-class-row > div {\r\n        padding-left: 5px;\r\n        padding-right: 5px;\r\n    }\r\n}\r\n\r\n\r\n"
