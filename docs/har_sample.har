            "size": 1359,
            "text": "export default class SvueHallpassApi {\r\n  constructor() { }\r\n\r\n  async GetStudentHallPassData() {\r\n    return await callComponentApi.call(this, 'pxp', 'svue-hallpass', 'SvueHallPass', 'GetStudentHallPassData', {\r\n    });\r\n  }\r\n\r\n  async GetHallPassRooms() {\r\n    return await callComponentApi.call(this, 'pxp', 'svue-hallpass', 'SvueHallPass', 'GetHallPassRooms', {\r\n    });\r\n  }\r\n\r\n  async GetFuturePasses() {\r\n    return await callComponentApi.call(this, 'pxp', 'svue-hallpass', 'SvueHallPass', 'GetFuturePasses', {\r\n    });\r\n  }\r\n\r\n  async CreateHallPass(roomGU,minutes) {\r\n    return await callComponentApi.call(this, 'pxp', 'svue-hallpass', 'SvueHallPass', 'CreateHallPass', {\r\n      roomGU: roomGU,\r\n      minutes: minutes,\r\n    });\r\n  }\r\n\r\n  async DeleteHallPass(hallPassGU) {\r\n    return await callComponentApi.call(this, 'pxp', 'svue-hallpass', 'SvueHallPass', 'DeleteHallPass', {\r\n      hallPassGU: hallPassGU,\r\n    });\r\n  }\r\n\r\n  async CheckActivateQueuedHallPass(hallPassGU) {\r\n    return await callComponentApi.call(this, 'pxp', 'svue-hallpass', 'SvueHallPass', 'CheckActivateQueuedHallPass', {\r\n      hallPassGU: hallPassGU,\r\n    });\r\n  }\r\n\r\n  async RemoveFutureHallPass(hallPassGU) {\r\n    return await callComponentApi.call(this, 'pxp', 'svue-hallpass', 'SvueHallPass', 'RemoveFutureHallPass', {\r\n      hallPassGU: hallPassGU,\r\n    });\r\n  }\r\n}\r\n"
