              "value": "Mon, 02 Mar 2026 13:37:54 GMT"
            },
            {
              "name": "Server",
              "value": "Microsoft-IIS/10.0"
            },
            {
              "name": "X-AspNet-Version",
              "value": "4.0.30319"
            },
            {
              "name": "X-Powered-By",
              "value": "ASP.NET"
            },
            {
              "name": "Date",
              "value": "Mon, 30 Mar 2026 16:07:57 GMT"
            }
          ],
          "cookies": [],
          "content": {
            "mimeType": "application/javascript",
            "size": 10352,
            "text": "(function () {\r\n    if (window.ep_VideoConferencesForStudents) return;\r\n\r\n    var o = window.ep_VideoConferencesForStudents = function (element, options) {\r\n        if (!options) options = {};\r\n\r\n        if (!ST.VideoConferenceEnabled) {\r\n            return;\r\n        }\r\n\r\n        options.api = true; // This plugin may not even need a datasource server call\r\n        options.post = {}; // Pass in any datasource parameters\r\n        options.post.personGU = options.personGU;\r\n        ep_Plugin.call(this, 'ep_VideoConferencesForStudents', element, options);\r\n    }\r\n\r\n    ep_Inherit(o, ep_Plugin);\r\n    var p = o.prototype;\r\n\r\n    p.before_NewDataSource = function (dataSource) {\r\n        this.NowBellMeetings = ko.observableArray([]);\r\n        this.ShowUpcomingScheduled = ko.observable(false);\r\n        this.NowScheduledMeetings = [];\r\n        this.UpcomingScheduledMeetings = [];\r\n\r\n        for (var i = 0; i < dataSource.length; ++i) {\r\n            var row = dataSource[i];\r\n            var start = row.StartDate;\r\n            start = new Date(start.Year, start.Month - 1, start.Day, start.Hours, start.Minutes, start.Seconds);\r\n            var end = row.EndDate;\r\n            end = new Date(end.Year, end.Month - 1, end.Day, end.Hours, end.Minutes, end.Seconds);\r\n            row.StartDate = start;\r\n            row.EndDate = end;\r\n            var now = new Date();\r\n            var plus15 = new Date(now.getTime() + 15 * 60 * 1000);\r\n            if (start <= plus15 && end >= now) this.NowScheduledMeetings.push(row);\r\n            else if (start > now) this.UpcomingScheduledMeetings.push(row);\r\n        }\r\n\r\n        this.NowScheduledMeetings = ko.observableArray(this.NowScheduledMeetings);\r\n        this.UpcomingScheduledMeetings = ko.observableArray(this.UpcomingScheduledMeetings);\r\n    }\r\n\r\n    p.after_NewDataSource = function () {\r\n        // Anything you want to do after the dataSource is bound.\r\n\r\n        var self = this;\r\n        this.GetClassMeetingInfo(\r\n            function () {\r\n                self.GetPXPSource();\r\n            }\r\n        );\r\n    }\r\n\r\n    p.RecurText = function (meeting) {\r\n        return VideoConferenceAPI.RecurText(meeting.RecurOptions);\r\n    }\r\n\r\n    p.Refresh_click = function () {\r\n        this.Reset();\r\n    }\r\n\r\n    p.GetClassMeetingInfo = function (callback) {\r\n        var self = this;\r\n        VideoConferenceAPI.GetClassMeetingInfo(PXP.ChildOrgYearGU,\r\n            function (response) {\r\n                if (response.success) {\r\n                    self.ClassMeetingInfo = response.content;\r\n                    callback();\r\n                }\r\n            }\r\n        );\r\n    }\r\n\r\n    p.GetPXPSource = function () {\r\n        var self = this;\r\n        var isParent = this.options.parentVUE || this.options.parent;\r\n        VideoConferenceAPI.CallPromise('Service/PXP2WebCommonService.asmx/TodayScheduleInfo', { studentGU: this.options.personGU, isParent: isParent, orgYearGu: PXP.ChildOrgYearGU }).then(\r\n            function (response) {\r\n                // Build a list of just classes happening right now.\r\n                var active = [];\r\n\r\n                if (response.d) {\r\n                    for (var i = 0; i < response.d.Schools.length; ++i) {\r\n                        for (var j = 0; j < response.d.Schools[i].Classes.length; ++j) {\r\n                            var cl = response.d.Schools[i].Classes[j];\r\n                            if (cl.UsesVideoConference) active.push(cl);\r\n                        }\r\n                    }\r\n                }\r\n\r\n                self.NowBellMeetings(active);\r\n\r\n                if (self.NowScheduledMeetings().length > 0 || self.UpcomingScheduledMeetings().length > 0 || self.NowBellMeetings().length > 0) {\r\n                    var parent = self.Me.ep_closest('.pxp-student-summary');\r\n                    if (parent) parent.classList.add('HasMeetings');\r\n                }\r\n\r\n                $(self.Me).find('.pxp-switch').pxpSwitch();\r\n            },\r\n            function (response) {\r\n\r\n            }\r\n        );\r\n    }\r\n\r\n    p.JoinMeeting = function (vidConfGU) {\r\n        if (window.ST && ST.Impersonated && !ST.ImpersonateCanJoin) {\r\n            alert('Video Conferencing disabled while impersonating.');\r\n            return;\r\n        }\r\n\r\n        if (window.TXP && TXP.Impersonated && !TXP.ImpersonateCanJoin) {\r\n            alert('Video Conferencing disabled while impersonating.');\r\n            return;\r\n        }\r\n\r\n        var self = this;\r\n        VideoConferenceAPI.JoinStartMeeting(\r\n            {\r\n                vidConfGU: vidConfGU,\r\n                onMeetingEnded: function () {\r\n                    self.Reset();\r\n                }\r\n            }\r\n        );\r\n    }\r\n\r\n    p.ViewMessage = function (smMessagePersonGU) {\r\n\r\n        if (smMessagePersonGU) {\r\n            window.SMApp.viewMessage({\r\n                id: smMessagePersonGU,\r\n                isSystemMessage: false,\r\n                allowActions: false,\r\n            });\r\n        }\r\n\r\n    }\r\n\r\n    p.BellNow = function (classObj) {\r\n        var start = classObj.StartInfo;\r\n        start = new Date(start.Year, start.Month - 1, start.Day, start.Hours, start.Minutes, start.Seconds);\r\n        var end = classObj.EndInfo;\r\n        end = new Date(end.Year, end.Month - 1, end.Day, end.Hours, end.Minutes, end.Seconds);\r\n        var now = new Date();\r\n\r\n        if (classObj.StartTime === '12:00 AM' || classObj.EndTime === '12:00 AM') {\r\n            return false;\r\n        }\r\n        else if (start <= now && end >= now) {\r\n            return true;\r\n        }\r\n\r\n        return false;\r\n    }\r\n\r\n    p.HasBell = function (classObj) {\r\n        var start = classObj.StartInfo;\r\n        start = new Date(start.Year, start.Month - 1, start.Day, start.Hours, start.Minutes, start.Seconds);\r\n        var end = classObj.EndInfo;\r\n        end = new Date(end.Year, end.Month - 1, end.Day, end.Hours, end.Minutes, end.Seconds);\r\n        var now = new Date();\r\n\r\n        if (classObj.StartTime === '12:00 AM' || classObj.EndTime === '12:00 AM') {\r\n            return false;\r\n        }\r\n\r\n        return true;\r\n    }\r\n\r\n    p.JoinBellMeeting_bound = function (element, classObj) {\r\n        var classList = element.classList;\r\n\r\n        classList.add('StudentJoinMeetingButton');\r\n\r\n        var start = classObj.StartInfo;\r\n        start = new Date(start.Year, start.Month - 1, start.Day, start.Hours, start.Minutes, start.Seconds);\r\n        var end = classObj.EndInfo;\r\n        end = new Date(end.Year, end.Month - 1, end.Day, end.Hours, end.Minutes, end.Seconds);\r\n        var now = new Date();\r\n\r\n        if (!classObj.UsesVideoConference) {\r\n            classList.add('btn-default');\r\n            classList.add('disabled');\r\n            element.setAttribute('title', 'Your teacher has disabled class video meetings.');\r\n        }\r\n        else if (classObj.StartTime === '12:00 AM' || classObj.EndTime === '12:00 AM') {\r\n            classList.add('btn-primary');\r\n        }\r\n        else if (start > now || end < now) {\r\n            classList.add('btn-warning');\r\n            element.setAttribute('title', 'It may not be time for this meeting. You can still try to join.');\r\n        }\r\n        else if (ST.UserType === UserType.Parent) {\r\n            classList.add('btn-default');\r\n            classList.add('disabled');\r\n            element.setAttribute('title', 'Parents can not join from the student\\'s schedule.');\r\n        }\r\n        else {\r\n            classList.add('btn-success');\r\n        }\r\n\r\n        var self = this;\r\n        VideoConferenceAPI.GetCurrentMeetings(classObj.StaffGU,\r\n            function (response) {\r\n                if (response.success) {\r\n                    for (var i = 0; i < response.content.length; ++i) {\r\n                        var meetingID = response.content[i];\r\n                        for (var j = 0; j < self.ClassMeetingInfo.length; ++j) {\r\n                            var info = self.ClassMeetingInfo[j];\r\n                            if (info.MeetingID === meetingID && info.SectionGUs.indexOf(classObj.SectionGU.toLowerCase()) > -1) {\r\n                                var icon = document.ep_create('<i class=\"fa fa-chalkboard-teacher\" data-toggle=\"tooltip\" container=\"body\" title=\"Your teacher is in this class\" style=\"margin-right: 3px;\"></i>');\r\n                                element.parentElement.insertBefore(icon, element.parentElement.childNodes[0]);\r\n                                return;\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        );\r\n    }\r\n\r\n    p.JoinBellMeeting_click = function (classObj) {\r\n        if (window.ST && ST.Impersonated && !ST.ImpersonateCanJoin) {\r\n            alert('Video Conferencing disabled while impersonating.');\r\n            return;\r\n        }\r\n\r\n        if (window.TXP && TXP.Impersonated && !TXP.ImpersonateCanJoin) {\r\n            alert('Video Conferencing disabled while impersonating.');\r\n            return;\r\n        }\r\n\r\n        var start = classObj.StartInfo;\r\n        start = new Date(start.Year, start.Month - 1, start.Day, start.Hours, start.Minutes, start.Seconds);\r\n        var end = classObj.EndInfo;\r\n        end = new Date(end.Year, end.Month - 1, end.Day, end.Hours, end.Minutes, end.Seconds);\r\n        var now = new Date();\r\n\r\n        if (start.getHours() > 0 && end.getHours() > 0) {\r\n            if (start > now || end < now) {\r\n                if (!confirm('It looks like it is not time for this meeting yet. Are you sure you want to join?')) return;\r\n            }\r\n        }\r\n\r\n        VideoConferenceAPI.CallPromise('Service/PXP2WebCommonService.asmx/JoinBellMeeting', { sectionGU: classObj.SectionGU }).then(\r\n            function (response) {\r\n                if (!response.d.success) {\r\n                    if (response.d.code == 1) {\r\n                        alert('Your teacher has not set up their account yet. Ask them to join the meeting first.');\r\n                        return;\r\n                    }\r\n\r\n                    if (response.d.message) alert(response.d.message);\r\n                    return;\r\n                }\r\n\r\n                VideoConferenceAPI.JoinStartMeetingFromURL(response.d.content.WebURI);\r\n            },\r\n            function (response) {\r\n                if (response.d.message) alert(response.d.message);\r\n            }\r\n        );\r\n    }\r\n\r\n})();"
          },
          "redirectURL": "",
          "headersSize": 243,
          "bodySize": 10595
        },
