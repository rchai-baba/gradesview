          "httpVersion": "HTTP/1.1",
          "headers": [
            {
              "name": "Content-Length",
              "value": "78874"
            },
            {
              "name": "Content-Type",
              "value": "text/html"
            },
            {
              "name": "Last-Modified",
              "value": "Fri, 27 Feb 2026 15:27:10 GMT"
            },
            {
              "name": "Server",
              "value": "Microsoft-IIS/10.0"
            },
