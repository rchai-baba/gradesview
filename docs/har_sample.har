ce: nowrap\">\r\n            <span class=\"student-name\">Raymond</span>\r\n        </h2>\r\n        \r\n        <div class=\"school\">Herbert Henry Dow High School</div>\r\n        <div class=\"phone\">(989-923-5382)</div>\r\n    </div>\r\n</div>\r\n\r\n            \r\n        </div>\r\n        \r\n    </div>\r\n\r\n    <div></div>\r\n    <div class=\"pxp-navbar-container hide-for-print\" aria-label=\"System Links\" role=\"region\">\r\n        <ul class=\"pxp-navbar\">\r\n            <li id=\"ctl00_ctl00_MainContent_svueHallPassBtn\" class=\"hall-pass-container\">\r\n                <component-provider namespace=\"pxp\">\r\n                    <svue-hallpass></svue-hallpass>\r\n                </component-provider>\r\n            </li>\r\n            \r\n            \r\n            \r\n            <li id=\"ctl00_ctl00_MainContent_tabMyAccount\"><a href=\"PXP2_MyAccount.aspx?AGU=0\">My Account</a></li>\r\n            <li id=\"ctl00_ctl00_MainContent_tabHelp\"><a href=\"PXP2_Help.aspx?AGU=0\">Help</a></li>\r\n            \r\n            <li id=\"ctl00_ctl00_MainContent_tabLogout\"><a href=\"PXP2_Login_Student.aspx?Logout=1\">Logout</a></li>\r\n        </ul>\r\n    </div>\r\n\r\n    <div class=\"pull-right hide-for-print greeting-container\" style=\"position:relative\" aria-label=\"District announcements\" role=\"region\">\r\n        <span id=\"DistrictName\">\r\n            \r\n            Midland Public Schools\r\n        </span>\r\n        <span id=\"Greeting\"  style=\"color:var(--st-color-fg)\" >Good afternoon, Raymond Chai, 3/30/2026</span>\r\n    </div>\r\n</header>\r\n\r\n\r\n    \r\n<div class=\"tab-content\">\r\n    <div class=\"pxp-container home-selected\">\r\n        <div id=\"mainnav\" class=\"hide-for-print\" role=\"navigation\" aria-label=\"Menu\">\r\n            \r\n            <div class=\"list-group pxp-left-nav\" role=\"list\"></div>\r\n            \r\n        </div>\r\n        <div id=\"maincontent\">\r\n            <form name=\"aspnetForm\" method=\"post\" action=\"./Home_PXP2.aspx\" id=\"aspnetForm\">\r\n<div>\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"AqF4vtaIz8TIvMfu3VWatHdsN+rWSl1K4NOveudK1GLW4E2JSXO2pNGnh3L0q952ppLDQUDY1N2O05v3RJYawEt89SYwFilxzjGpYSoCHNo=\" />\r\n</div>\r\n\r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nwindow.LoadRemoteStyleSheet('schemes_font-awesome_min_css', '/schemes/font-awesome.min.css?2026-03-29T12%3a03%3a23.0000000');\r\nwindow.LoadRemoteStyleSheet('schemes_PXP_Form_css', '/schemes/PXP_Form.css?2026-03-29T12%3a03%3a23.0000000');\r\nwindow.LoadRemoteScript('js_ST_es6-promise_auto_min_js', '/js/ST/es6-promise.auto.min.js?2026-03-29T12%3a03%3a23.0000000');\r\nwindow.LoadRemoteScript('js_PXP_json2_min_js', '/js/PXP/json2.min.js?2026-03-29T12%3a03%3a23.0000000');\r\nwindow.LoadRemoteScript('GBResources_gbapp_pvue_js', '/resources/GBResources/gbapp_pvue.js?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteScript('GBResources_jquery_min_js', '/resources/GBResources/jquery_min.js?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteStyleSheet('GBResources_jquery_ui_min_css', '/resources/GBResources/jquery_ui_min.css?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteScript('GBResources_jquery_ui_min_js', '/resources/GBResources/jquery_ui_min.js?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteStyleSheet('GBResources_pnotify_min_css', '/resources/GBResources/pnotify_min.css?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteScript('GBResources_pnotify_min_js', '/resources/GBResources/pnotify_min.js?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteScript('GBResources_knockout_latest_js', '/resources/GBResources/knockout_latest.js?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteScript('GBResources_knockout_mapping_latest_js', '/resources/GBResources/knockout_mapping_latest.js?2026-03-02T08%3a37%3a54.0000000');\r\nwindow.LoadRemoteScript('js_PXP_PXP_jquery_ui_touch-punch_min_js', '/js/PXP/PXP_jquery.ui.touch-punc