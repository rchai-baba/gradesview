            "size": 4336,
            "text": "(function ($) {\r\n    $(function () {\r\n        gbapp.whenAvailable(\"window.COMPONENT_LOADER\", function () {\r\n\r\n            ST.LoadTemplate('templates/PXP/PXP2_StudentSummary.html')\r\n                .done(function () {\r\n                    window.studentSummary = new StudentSummaryVM();\r\n                    var $parent = $('.student-summary');\r\n                    ich['KO.StudentSummary']($parent, window.studentSummary);\r\n                });\r\n\r\n            if (ST.OpenVidConfGU) {\r\n                var meetingStartDate = new Date(new Date(ST.OpenVidConfMeetingStartDate) - 60000 * 15);\r\n\r\n                if (new Date() >= meetingStartDate) {\r\n                    VideoConferenceAPI.JoinStartMeeting({ vidConfGU: ST.OpenVidConfGU });\r\n                }\r\n\r\n                ST.OpenVidConfGU = null;\r\n            }\r\n\r\n        });\r\n    });\r\n\r\n    function Message(data) {\r\n        const self = this;\r\n\r\n        $.extend(self, data);\r\n\r\n        self.read$ = ko.observable(data.read);\r\n\r\n        self.messageTypeIcon$ = ko.pureComputed(function () {\r\n            if (self.module === 'GB' || self.module === 'Messages') {\r\n                var imageName = self.read$() ? 'Read' : 'Unread';\r\n                return 'Images/PXP/msg' + imageName + '.png';\r\n            }\r\n            else {\r\n                return 'Images/PXP/ModuleIcons/icon_' + self.module + '.png';\r\n            }\r\n        });\r\n\r\n        self.updateRead = function (read) {\r\n            if (read != self.read$()) {\r\n                self.read$(read);\r\n\r\n                if (read) {\r\n                    $('.SynergyMailUnread').each(function (idx, el) {\r\n                        var $msgBox = $(el);\r\n                        var count = (parseInt($msgBox.text().trim()) || 0) - 1;\r\n\r\n                        if (count <= 0) {\r\n                            $msgBox.remove();\r\n                        }\r\n                        else {\r\n                            $msgBox.html(count);\r\n                        }\r\n                    });\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    function Student(data) {\r\n        const self = this;\r\n\r\n        $.extend(self, data);\r\n\r\n        self.messages$ = ko.observableArray(data.messages.map(function (m) {\r\n            return new Message(m);\r\n        }));\r\n\r\n        self.assignments$ = ko.observableArray(data.assignments);\r\n\r\n        self.viewMessage = function (message) {\r\n            switch (message.module) {\r\n                case 'Messages':\r\n                case 'GB':\r\n                case 'StudentInfo':\r\n                    window.SMApp.viewMessage({\r\n                        id: message.id,\r\n                        allowActions: true,\r\n                        isSystemMessage: message.module !== 'Messages',\r\n                        noReply: message.module === 'StudentInfo',\r\n                        onDelete: function () {\r\n                            self.messages$.remove(message);\r\n                        },\r\n                        onSMTPReply: function () {\r\n                            SendEmail(message.email);\r\n                        }\r\n                    });\r\n\r\n                    if (!ST.Impersonated) {\r\n                        message.updateRead(true);\r\n                    }\r\n                    break;\r\n                default:\r\n                    if (message.link) {\r\n                        window.location.href = message.link;\r\n                    }\r\n            }\r\n        };\r\n    }\r\n\r\n    function StudentSummaryVM() {\r\n        const self = this;\r\n\r\n        self.loading$ = ko.observable(true);\r\n        self.showRecentAssignments = false;\r\n        self.showBadges = false;\r\n        self.students$ = ko.observableArray();\r\n        self.personGU = '';\r\n\r\n        self.loadStudents = function () {\r\n            ST.SendServerEvent(null, 'PXP_Get_StudentSummary', {})\r\n                .done(function (response) {\r\n                    self.personGU = response.personGU;\r\n                    self.loading$(false);\r\n                    self.showRecentAssignments = response.showRecentAssignments;\r\n                    self.showBadges = response.showBadges;\r\n                    self.students$(response.students.map(function (s) {\r\n                        return new Student(s);\r\n                    }));\r\n                });\r\n        };\r\n\r\n        self.loadStudents();\r\n    }\r\n})(jQuery);"
