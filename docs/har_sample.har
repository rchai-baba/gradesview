Drive_js\" src=\"/js/PXP/GoogleDrive.js?2026-03-29T12%3a03%3a23.0000000\" type=\"text/javascript\"></script><script id=\"ctl00_ctl00_js_PXP_OneDrive_js\" src=\"/js/PXP/OneDrive.js?2026-03-29T12%3a03%3a23.0000000\" type=\"text/javascript\"></script><script id=\"ctl00_ctl00_js_PXP_PXP2_DropBox_js\" src=\"/js/PXP/PXP2_DropBox.js?2026-03-29T12%3a03%3a23.0000000\" type=\"text/javascript\"></script><script id=\"ctl00_ctl00_GBResources_jquery_ddslick_min_js\" src=\"/resources/GBResources/jquery_ddslick_min.js?2026-03-02T08%3a37%3a54.0000000\" type=\"text/javascript\"></script><style id=\"ctl00_ctl00_PXPColorTheme\" type=\"text/css\">\r\n    .panel-default > .panel-heading,\r\n    .panel-default > .panel-footer,\r\n    .panel-default > .panel-footer a {\r\n        background-color: #196131;\r\n        color: #FFFFFF;\r\n    }\r\n    \r\n    # LoginHeading, \r\n    # LoginPVUE, \r\n    # LoginSVUE, \r\n    # DistrictName,\r\n    # Greeting,\r\n    .oen-nav-header,\r\n    body .container>h1 {\r\n        color: #000000 !important;\r\n    }\r\n    </style><script id=\"ctl00_ctl00_GBResources_exceljs_min_js\" src=\"/resources/GBResources/exceljs_min.js?2026-03-02T08%3a37%3a54.0000000\" type=\"text/javascript\"></script><script id=\"ctl00_ctl00_GBResources_FileSaver_min_js\" src=\"/resources/GBResources/FileSaver_min.js?2026-03-02T08%3a37%3a54.0000000\" type=\"text/javascript\"></script><link id=\"ctl00_ctl00_schemes_PXP2_PXP2_LanguageBar_css\" href=\"/schemes/PXP2/PXP2_LanguageBar.css?2026-03-29T12%3a03%3a23.0000000\" type=\"text/css\" rel=\"stylesheet\"></link><script id=\"ctl00_ctl00_js_PXP_PXP2_LanguageBar_js\" src=\"/js/PXP/PXP2_LanguageBar.js?2026-03-29T12%3a03%3a23.0000000\" type=\"text/javascript\"></script></head>\r\n\r\n<body id=\"ctl00_ctl00_MainBody\" class=\"browser-Firefox bver-150_0 ignore-theme\" data-theme=\"2\">\r\n    \r\n    \r\n\r\n     \r\n\r\n    <div id=\"ctl00_ctl00_DebugInfo\" class=\"DebugInfo\">04</div>\r\n\r\n    <div aria-label=\"Accessiblity Options\" class=\"sr-only\">\r\n        <a href=\"accessibility.html\" target=\"_blank\">Synergy Accessibility Tips</a>\r\n        <a href=\"#\" role=\"button\" id=\"AccessButton\" data-action=\"ToggleAccessibleMode\">Accessibility Mode</a>\r\n    </div>\r\n\r\n    <header id=\"ctl00_ctl00_MobileHeader\" class=\"mobile-header\"></header>\r\n\r\n    \r\n        <div class=\"PXPHeaderLogo\">\r\n            <img src=\"Photos/8D/8D749524-419B-4CB2-BEAE-134B947A853D_PXPHeaderLogo.PNG?637937553000000000\" alt=\"District Logo\" width=\"240\" height=\"70\" />\r\n        </div>\r\n    \r\n\r\n    <div class=\"container\">\r\n        <div id=\"USER_ERROR\"></div>\r\n\r\n        \r\n\r\n<header id=\"ctl00_ctl00_MainContent_PXPHeader\" class=\"pxp-main-header\">\r\n    \r\n    \r\n    <div id=\"ctl00_ctl00_MainContent_StudentSelector\" class=\"pxp-student-header hide-for-print\" aria-label=\"Student Selector\" role=\"region\">\r\n        <div class=\"current\" data-toggle=\"dropdown\">\r\n            \r\n\r\n<div class=\"student-info\" tabindex=\"0\" data-agu=\"0\" >\r\n    <div class=\"student-photo\">\r\n        <img alt=\"Student Photo\" src=\"Photos/80/809B951C-2CCD-4791-BCCE-B9411EB37B08_Photo.PNG\" width=\"40\" height=\"50\" />\r\n        <span class=\"student-id\">ID: 1025302</span>\r\n    </div>\r\n    <div class=\"student-details\">\r\n        <h2 style=\"white-space: nowrap\">\r\n            <span class=\"student-name\">Raymond</span>\r\n        </h2>\r\n        \r\n        <div class=\"school\">Herbert Henry Dow High School</div>\r\n        <div class=\"phone\">(989-923-5382)</div>\r\n    </div>\r\n</div>\r\n\r\n            \r\n        </div>\r\n        \r\n    </div>\r\n\r\n    <div></div>\r\n    <div class=\"pxp-navbar-container hide-for-print\" aria-label=\"System Links\" role=\"region\">\r\n        <ul class=\"pxp-navbar\">\r\n            <li id=\"ctl00_ctl00_MainContent_svueHallPassBtn\" class=\"hall-pass-container\">\r\n                <component-provider namespace=\"pxp\">\r\n                    <svue-hallpass></svue-hallpass>\r\n                </component-provider>\r\n            </li>\r\n            \r\n            \r\n            \r\n            <li id=\"ctl00_ctl00_MainContent_tabMyAccount\"><a href=\"PXP2_MyAccount.aspx?AGU=0\">My Account</a></li>\r\n            <li id=\"ctl00_ctl00_MainContent_tabHelp\"><a href=\"PXP2_Help.aspx?AGU=0\">Help</a></li>\r\n            \r\n            <li id=\"ctl00_ctl00_MainContent_tabLogout\"><a href=\"PXP2_Login_Student.aspx?Logout=1\">Logout</a></li>\r\n        </ul>\r\n    </div>\r\n\r\n    <div class=\"pull-right hide-for-print greeting-container\" style=\"position:relative\" aria-label=\"District announcements\" role=\"region\">\r\n        <span id=\"DistrictName\">\r\n            \r\n            Midland Public Schools\r\n        </span>\r\n        <span id=\"Greeting\"  style=\"color:var(--st-color-fg)\" >Good afternoon, Raymond Chai, 3/30/2026</span>\r\n    </div>\r\n</header>\r\n\r\n\r\n    \r\n<div class=\"tab-content\">\r\n    <div class=\"pxp-container \">\r\n        <div id=\"mainnav\" class=\"hide-for-print\" role=\"navigation\" aria-label=\"Menu\">\r\n            \r\n            <div class=\"list-group pxp-left-nav\" role=\"list\"></div>\r\n            \r\n        </div>\r\n        <div id=\"maincontent\">\r\n            <form name=\"aspnetForm\" method=\"post\" action=\"./PXP2_Gradebook.aspx?AGU=0&amp;studentGU=809B951C-2CCD-4791-BCCE-B9411EB37B08\" id=\"aspnetForm\">\r\n<div>\r\n<input type=\"hidden\" name=\"__EVENTTARGET\" id=\"__EVENTTARGET\" value=\"\" />\r\n<input type=\"hidden\" name=\"__EVENTARGUMENT\" id=\"__EVENTARGUMENT\" value=\"\" />\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"LKBv6pG4CAkcI1Y91oJhvXiYHWwavYeMSDxO5Gks16EQhNc9YvdODVGOYrVVI/lMeOvlY4m8jn+t55qBS2r/2xZPmFth5isCb6RdE3nKiy0=\" />\r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nvar theForm = document.forms['aspnetForm'];\r\nif (!theForm) {\r\n    theForm 