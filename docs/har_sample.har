sMinimumInterval: 1,\r\n                        fillColors: [\r\n                            PXP.ChartColors.Red,\r\n                            PXP.ChartColors.Yellow\r\n                        ],\r\n                        scaleOptions: {\r\n                            xAxis: {\r\n                                title: {\r\n                                    label: 'Period'\r\n                                }\r\n                            }\r\n                        }\r\n                    };\r\n\r\n                    this.chartData = new Chart(ctx).STStackedBar(data, config);\r\n                    $canvas.css('width', '');\r\n                }\r\n            }\r\n        });\r\n    };\r\n})(jQuery);\r\n\r\n// When hovering over the ring graph segment, highlight the associated rows.\r\n(function ($) {\r\n    function clearHighlights() {\r\n        $('.attendance-details').find('tr > td').css('background', '');\r\n    }\r\n\r\n    function highlightRows(types, color) {\r\n        $('.attendance-details')\r\n            .find('tr.att-course-details.expanded')\r\n            .find('tbody > tr')\r\n            .filter(function () {\r\n                var type = $(this).find('[data-type]').attr('data-type');\r\n                return types.indexOf(type) != -1;\r\n            })\r\n            .each(function () {\r\n                $(this).children().css('background-color', color);\r\n            });\r\n    }\r\n\r\n    $(document).delegate('.attendance-details .pxp-ring-chart', 'segment-mouseenter', function (ev, segment) {\r\n        switch (segment.data.label) {\r\n            case 'Tardy':\r\n                highlightRows(['TDY', 'TAR'], '#fffacd');\r\n                break;\r\n            case 'Absent':\r\n                highlightRows(['EXC', 'UNV'], '#fcb8b6');\r\n                break;\r\n        }\r\n    });\r\n\r\n    $(document).delegate('.attendance-details .pxp-ring-chart', 'segment-mouseleave', function (ev, segment) {\r\n        clearHighlights();\