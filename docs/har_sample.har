          "content": {
            "mimeType": "text/javascript",
            "size": 15779,
            "text": "\r\nlet app = null;\r\nlet DEFAULT_BTN_LABEL = 'Hall Pass';\r\nlet IN_QUEUE_MSG = 'Hall Pass in Queue';\r\nlet SHORT_PENDING_MSG = 'Hall Pass Approval Pending';\r\nlet LONG_PENDING_MSG = 'Hall Pass request is pending for approval';\r\nlet IN_QUEUE_REFRESH_MSG = 'You are in line. Refresh data in: [seconds]';\r\n\r\nexport default class SvueHallPassBtnVM extends KOBaseComponent {\r\n    constructor(params, componentInfo) {\r\n        super(params, componentInfo);\r\n\r\n        app = this;\r\n\r\n        this.hallPassSetup = ko.observable(false);\r\n\r\n        this.currentHallPass = ko.observable(null);\r\n        this.isStudent = ko.observable(false);\r\n        this.hasCurrentHallPass = ko.computed(() => (!!this.currentHallPass() && this.isStudent()));\r\n        this.hasActiveHallPass = ko.computed(() => (!!app.currentHallPass() && app.currentHallPass().status === 'A' && this.isStudent()));\r\n        this.hasQueueHallPass = ko.computed(() => (!!app.currentHallPass() && app.currentHallPass().status === 'Q' && this.isStudent()));\r\n        this.hasPendingHallPass = ko.computed(() => (!!app.currentHallPass() && app.currentHallPass().status === 'P' && this.isStudent()));\r\n\r\n        this.currentHallPassStatus = ko.observable('none');\r\n\r\n        this.pendingMsg = LONG_PENDING_MSG;\r\n\r\n        this.studentInQMsg = ko.observable(null);\r\n        this.queueRefreshDataMsg = ko.observable(null);\r\n\r\n        this.hallPassBtnLabel = ko.computed(() => {\r\n            var res = null;\r\n            var hallPass = app.currentHallPass();\r\n            if (hallPass && this.isStudent()) {\r\n                if (hallPass.status === 'A') {\r\n                    res = elvis_get(hallPass, 'room', 'roomName');\r\n                }\r\n                else if (hallPass.status === 'Q') {\r\n                    res = IN_QUEUE_MSG;\r\n                }\r\n                else if (hallPass.status === 'P') {\r\n                    res = SHORT_PENDING_MSG;\r\n                }\r\n            }\r\n\r\n            return res || DEFAULT_BTN_LABEL;\r\n        });\r\n        this.remainingTime = ko.observable('');\r\n        this.buttonInterval = null;\r\n\r\n        this.queueRefreshInterval = null;\r\n\r\n        this.dialogopen = ko.observable(false);\r\n        this.requestDialogOpen = ko.observable(false);\r\n\r\n        this.rooms = ko.observable([]);\r\n        this.futurePasses = ko.observable([]);\r\n\r\n        this.selectedRoom = ko.observable(null);\r\n        this.autoAdvance = ko.computed(() => !!this.selectedRoom());\r\n\r\n        this.timeValue = ko.observable(5);\r\n        this.timeMax = ko.computed(() => app.selectedRoom()?.maxTime || 10);\r\n\r\n        this.filterLockedOnly = ko.observable(false);\r\n        this.filterUnlockedOnly = ko.observable(false);\r\n        this.filterRoomName = ko.observable('');\r\n\r\n        this.timeValueDisplay = ko.computed(() => {\r\n            var mins = this.timeValue();\r\n            var s = mins == 1 ? '' : 's';\r\n            return mins + ' Minute' + s;\r\n        })\r\n\r\n        this.showNoRooms = ko.computed(() => app.rooms().filter(x => x.isVisible()).length === 0);\r\n\r\n        this.ssyGU = ko.observable('');\r\n\r\n\r\n        this.init(params, componentInfo);\r\n    }\r\n\r\n    async openHallPassDialog() {\r\n        app.dialogopen(true);\r\n    }\r\n\r\n    async openHallPassRequestDialog() {\r\n        try {\r\n            var roomData = await app.api.GetHallPassRooms();\r\n            app.rooms(roomData.map((x) => new RoomVM(x)));\r\n        \r\n        }\r\n        catch (err) {\r\n            $.pnotify_error(err);\r\n        }\r\n        app.selectedRoom(null);\r\n        app.timeValue(5);\r\n        app.requestDialogOpen(true);\r\n\r\n        app.filterLockedOnly(false);\r\n        app.filterUnlockedOnly(false);\r\n        app.filterRoomName('');\r\n    }\r\n\r\n    async init(params, componentInfo) {\r\n        this.setupButton(null);\r\n        this.loadHallPassData();\r\n\r\n        ST.ServerMessage.RegisterMessageHandler(\"SSE_HallpassUpdate_Svue\", (data) => {\r\n            app.loadHallPassData();\r\n        });\r\n    }\r\n\r\n    async loadHallPassData() {\r\n        try {\r\n            const data = await this.api.GetStudentHallPassData();\r\n\r\n            this.isStudent(data.isStudent == true);\r\n            this.studentInQMsg(data.studentInQMsg);\r\n\r\n            if (!data.noRoomsSetup) {\r\n                this.hallPassSetup(true);\r\n                this.setupButton(data.currentHallPass);\r\n                this.futurePasses(data.futureHallPasses);\r\n\r\n                this.ssyGU(data.ssyGU);\r\n            }\r\n\r\n\r\n        }\r\n        catch (err) {\r\n            $.pnotify_error(err);\r\n        }\r\n    }\r\n\r\n    setupButton(hallPass) {\r\n        this.remainingTime('');\r\n        this.currentHallPass(hallPass);\r\n        this.currentHallPassStatus('none');\r\n        clearInterval(this.buttonInterval);\r\n        clearInterval(this.queueRefreshInterval);\r\n\r\n        function getTimeSpanData(date1, date2, checkZero) {\r\n            var res = {};\r\n\r\n            var diff = date1.getTime() - date2.getTime();\r\n            if (diff <= 0 && checkZero) {\r\n                res.zero = true;\r\n            }\r\n            else {\r\n                res.negative = diff < 0;\r\n                if (res.negative) {\r\n                    diff *= - 1;\r\n                }\r\n                res.days = Math.floor(diff / (1000 * 60 * 60 * 24));\r\n                diff -= res.days * (1000 * 60 * 60 * 24);\r\n                res.hours = Math.floor(diff / (1000 * 60 * 60));\r\n                diff -= res.hours * (1000 * 60 * 60);\r\n                res.mins = Math.floor(diff / (1000 * 60));\r\n                diff -= res.mins * (1000 * 60);\r\n                res.seconds = Math.floor(diff / (1000));\r\n                diff -= res.seconds * (1000);\r\n            }\r\n            return res;\r\n        }\r\n\r\n        function formatTimeSpan(data) {\r\n            function formatVal(val, targetLength) {\r\n                return ('' + val).padStart(targetLength, '0');\r\n            }\r\n\r\n            var res = '';\r\n            if (data.negative) {\r\n                res += '-';\r\n            }\r\n            if (data.days > 0) {\r\n                res += data.days + '.';\r\n            }\r\n            if (data.days > 0 || data.hours > 0) {\r\n                res += formatVal(data.hours, data.days > 0 ? 2 : 0) + ':';\r\n            }\r\n            res += formatVal(data.mins, data.days > 0 || data.hours > 0 ? 2 : 0) + ':' + formatVal(data.seconds, 2);\r\n            return res;\r\n        }\r\n\r\n        function getNowUtc() {\r\n            return new Date(Date.now() + new Date().getTimezoneOffset() * 60000);\r\n        }\r\n\r\n        if (this.hasActiveHallPass() && this.isStudent()) {\r\n\r\n            if (hallPass.countUp) {\r\n                function setStopwatch() {\r\n                    var now = getNowUtc();\r\n                    var start = hallPass.startDateTime;\r\n                    if (start) {\r\n                        var date = new Date(start.year, start.month - 1, start.day, start.hour, start.minute, start.second);\r\n\r\n                        var data = getTimeSpanData(now, date);\r\n\r\n                        var time = formatTimeSpan(data);\r\n\r\n                        app.remainingTime(time);\r\n                    }\r\n\r\n                    var end = hallPass.endDateTime;\r\n                    if (end) {\r\n                        var date = new Date(end.year, end.month - 1, end.day, end.hour, end.minute, end.second);\r\n                        var data = getTimeSpanData(date, now);\r\n\r\n                        if (data.negative) {\r\n                            if (data.days > 0 || data.hours > 0 || data.mins >= 5) {\r\n                                app.currentHallPassStatus('expired');\r\n                            }\r\n                            else {\r\n                                app.currentHallPassStatus('little-expired');\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n                setStopwatch();\r\n                this.buttonInterval = setInterval(setStopwatch, 500);\r\n            }\r\n            else {\r\n                function setRemainingTime() {\r\n                    var end = hallPass.endDateTime;\r\n                    if (end) {\r\n                        var date = new Date(end.year, end.month - 1, end.day, end.hour, end.minute, end.second);\r\n                        var zeroText = 'Expired';\r\n                        var data = getTimeSpanData(date, getNowUtc(), true);\r\n                        if (data.zero) {\r\n                            clearInterval(app.buttonInterval);\r\n                            app.currentHallPass(null);\r\n                        }\r\n                        else {\r\n                            app.remainingTime(formatTimeSpan(data) + ' remaining');\r\n                        } \r\n                    }\r\n                }\r\n                setRemainingTime();\r\n                this.buttonInterval = setInterval(setRemainingTime, 500);\r\n            }\r\n        }\r\n        else if (this.hasQueueHallPass()) {\r\n            var refreshDate = new Date(new Date().getTime() + 60000);\r\n            function setQueueRefreshTime() {\r\n                var zeroText = 'Refreshing...';\r\n                var remaining = formatTimeSpan(refreshDate, new Date(), zeroText);\r\n                if (remaining === zeroText) {\r\n                    clearInterval(app.queueRefreshInterval);\r\n\r\n                    app.checkActivate();\r\n                }\r\n                else {\r\n                    remaining = IN_QUEUE_REFRESH_MSG.replace('[seconds]', remaining);\r\n                }\r\n                app.queueRefreshDataMsg(remaining);\r\n            }\r\n            setQueueRefreshTime();\r\n            this.queueRefreshInterval = setInterval(setQueueRefreshTime, 500);\r\n        }\r\n\r\n    }\r\n\r\n    async checkActivate() {\r\n        var hallPassGU = app.currentHallPass()?.hallPassGU;\r\n        if (hallPassGU) {\r\n            try {\r\n                var data = await app.api.CheckActivateQueuedHallPass(hallPassGU);\r\n                if (data.success) {\r\n                    if (data.status === 'Q') {\r\n                        app.setupButton(app.currentHallPass());\r\n                    }\r\n                    else if (data.status === 'A') {\r\n                        app.setupButton(data.currentHallPassData);\r\n                    }\r\n                }\r\n            }\r\n            catch (err) {\r\n                $.pnotify_error(err);\r\n            }\r\n        }\r\n    }\r\n\r\n    canAdvanceRoom() {\r\n        return !!app.selectedRoom();\r\n    }\r\n\r\n    async createHallPass() {\r\n        if (!app.creatingHallPass) {\r\n            app.creatingHallPass = true;\r\n\r\n            var room = app.selectedRoom();\r\n            if (!room) {\r\n                $.pnotify_error('No room selected');\r\n            }\r\n            else {\r\n                try {\r\n                    const data2 = await app.api.CreateHallPass(room.roomGU, app.timeValue());\r\n                    app.requestDialogOpen(false);\r\n                    app.setupButton(data2.currentHallPassData);\r\n\r\n                    var status = elvis_get(data2, 'currentHallPassData', 'status');\r\n                    switch (status) {\r\n                        case 'A':\r\n                            $.pnotify_success('Hall pass created successfully');\r\n                            break;\r\n                        case 'Q':\r\n                            $.pnotify_notice(app.studentInQMsg());\r\n                            break;\r\n                    }\r\n                }\r\n                catch (err) {\r\n                    $.pnotify_error(err);\r\n                }\r\n            }\r\n\r\n            app.creatingHallPass = false;\r\n        }\r\n    }\r\n\r\n    async removeHallPass() {\r\n        try {\r\n            var hallPassGU = app.currentHallPass()?.hallPassGU;\r\n            if (hallPassGU) {\r\n                const data3 = await app.api.DeleteHallPass(hallPassGU);\r\n                if (data3.success) {\r\n                    app.setupButton(null);\r\n                    $.pnotify_success('Hall Pass was removed');\r\n                }\r\n            }\r\n        }\r\n        catch (err) {\r\n            $.pnotify_error(err);\r\n        }\r\n    }\r\n\r\n    filterRoomsLocked() {\r\n        app.filterLockedOnly(!app.filterLockedOnly());\r\n        app.filterUnlockedOnly(false);\r\n    }\r\n\r\n    filterRoomsUnlocked() {\r\n        app.filterUnlockedOnly(!app.filterUnlockedOnly());\r\n        app.filterLockedOnly(false);\r\n    }\r\n\r\n    async removeFutureHallPass() {\r\n        try {\r\n            if (this.hallPassGU && window.confirm('Are you sure you want to remove this hall pass?')) {\r\n                const data = await app.api.RemoveFutureHallPass(this.hallPassGU);\r\n                if (data.success) {\r\n                    $.pnotify_success('Hall Pass has been removed');\r\n                }\r\n            }\r\n        }\r\n        catch (err) {\r\n            $.pnotify_error(err);\r\n        }\r\n    }\r\n}\r\n\r\nclass RoomVM {\r\n    constructor(room) {\r\n        Object.assign(this, room);\r\n\r\n        this.isSelectedRoom = ko.computed(() => this.roomGU === (app.selectedRoom() && app.selectedRoom().roomGU));\r\n\r\n        this.isVisible = ko.computed(() => {\r\n            var res = true;\r\n            var filterRoomName = app.filterRoomName();\r\n            if (filterRoomName) {\r\n                filterRoomName = filterRoomName.toLowerCase();\r\n                res = (this.roomName || '').toLowerCase().indexOf(filterRoomName) != -1;\r\n            }\r\n            if (res) {\r\n                res = (!app.filterLockedOnly() && !app.filterUnlockedOnly())\r\n                    || (app.filterLockedOnly() && this.approvalRequired)\r\n                    || (app.filterUnlockedOnly() && !this.approvalRequired);\r\n            }\r\n            return res;\r\n        });\r\n    }\r\n\r\n    roomClick() {\r\n        var current = app.selectedRoom();\r\n        app.selectedRoom(null);\r\n        app.selectedRoom(this);\r\n\r\n        if (!current || current.roomGU != this.roomGU) {\r\n            app.timeValue(Math.floor((1 + this.maxTime) / 2));\r\n        }\r\n    }\r\n\r\n  \r\n}\r\n\r\nko.bindingHandlers.slider = {\r\n\r\n    init: function (element, valueAccessor, allBindingsAccessor) {\r\n\r\n        //slider: { value: shdApp.timeValue, min: 1, max: shdApp.timeMax, step: 1 }\r\n\r\n        function setAttrValue(attrName, value) {\r\n            element.setAttribute(attrName, value);\r\n        }\r\n\r\n        function initAttribute(attrName, attr) {\r\n            if (ko.isObservable(attr)) {\r\n                setAttrValue(attrName, attr());\r\n                attr.subscribe((value) => setAttrValue(attrName, value));\r\n            }\r\n            else {\r\n                setAttrValue(attrName, attr);\r\n            }\r\n        }\r\n\r\n        var sliderOptions = ko.unwrap(valueAccessor()) || {};\r\n\r\n        // Set the initial value of the slider\r\n        var initialValue = ko.unwrap(valueAccessor());\r\n        var value = sliderOptions.value !== undefined ? sliderOptions.value : initialValue;\r\n\r\n        initAttribute('min', sliderOptions.min !== undefined ? sliderOptions.min : 0);\r\n        initAttribute('max', sliderOptions.max !== undefined ? sliderOptions.max : 100);\r\n        initAttribute('step', sliderOptions.step !== undefined ? sliderOptions.step : 1);\r\n\r\n        // Create the slider using vanilla JavaScript\r\n        element.type = \"range\";\r\n        element.value = value;\r\n\r\n        // Update the value whenever the slider is moved\r\n        element.addEventListener(\"input\", function (event) {\r\n            var observable = initialValue.value;\r\n            observable(event.target.value);\r\n        });\r\n\r\n        // Update the slider whenever the observable is updated\r\n        var updateSlider = function () {\r\n            element.value = ko.unwrap(initialValue.value);\r\n        };\r\n        initialValue.value.subscribe(updateSlider);\r\n    },\r\n    update: function (element, valueAccessor, allBindingsAccessor) {\r\n        var value = ko.unwrap(valueAccessor());\r\n        element.value = value;\r\n    }\r\n};\r\n"
