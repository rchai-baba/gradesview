          ],
          "cookies": [],
          "content": {
            "mimeType": "text/javascript",
            "size": 2708,
            "text": "/* Example:\r\n    <st-modal>\r\n      <template name=\"activator\">\r\n         <button @click=\"yourFunctionHere\">Click Me</button>\r\n      </template>\r\n      <div> The rest of the component </div>\r\n    </st-modal>\r\n*/\r\n\r\nexport default class StModalVM extends KOBaseComponent {\r\n    constructor(params, componentInfo) {\r\n        super(params, componentInfo);\r\n\r\n        this.isOpen = ko.isObservable(params.isOpen) ? params.isOpen : ko.observable(params.isOpen ?? false);\r\n        this.title = observableFromParam(params.title);\r\n        this.fixedHeight = observableFromParam(params.fixedHeight);\r\n    }\r\n\r\n    onClick(e) {\r\n        console.log(this);\r\n        if (!($.contains(this.$componentInfo.element.childNodes, e.target) || this.$componentInfo.element === e.target)) {\r\n            this.isOpen(false);\r\n        }\r\n    }\r\n\r\n    onKeyUp(e) {\r\n        if (e.key === 'Escape') {\r\n            this.isOpen(false);\r\n        }\r\n    }\r\n}\r\n\r\nconst modals = [];\r\n\r\ndocument.addEventListener('click', (e) => {\r\n    modals.forEach(modal => {\r\n        if (modal === e.target || modal.contains(e.target)) {\r\n            e.stopPropagation();\r\n        }\r\n        else if (modal.parentElement === e.target && modal.allowClickToDismiss) {\r\n            const viewModel = ko.dataFor(modal);\r\n            if (ko.isObservable(viewModel.isOpen)) {\r\n                viewModel.isOpen(false);\r\n            }\r\n        }\r\n    });\r\n});\r\n\r\ndocument.addEventListener('mousedown', (e) => {\r\n    modals.forEach(modal => {\r\n        if (modal === e.target || modal.contains(e.target)) {\r\n            e.stopPropagation();\r\n            modal.allowClickToDismiss = false;\r\n        }\r\n        else if (modal.parentElement === e.target) {\r\n            modal.allowClickToDismiss = true;\r\n        }\r\n    });\r\n});\r\n\r\ndocument.addEventListener('keyup', (e) => {\r\n    if (e.key === 'Escape') {\r\n        //isOpen(false);\r\n    }\r\n});\r\n\r\nfunction toggleModal(element, isOpen) {\r\n    const idx = modals.indexOf(element);\r\n\r\n    if (idx !== -1) {\r\n        modals.splice(idx, 1);\r\n    }\r\n\r\n    if (isOpen) {\r\n        modals.unshift(element);\r\n    }\r\n}\r\n\r\nko.bindingHandlers.modal = {\r\n    init: function (element, valueAccessor, allBindings, viewModel, bindingContext) {\r\n        ko.utils.domNodeDisposal.addDisposeCallback(element, function () {\r\n\r\n        })\r\n\r\n        const acc = valueAccessor();\r\n        if (ko.isObservable(acc)) {\r\n            acc.subscribe((isOpen) => toggleModal(element, isOpen));\r\n            toggleModal(element, acc());\r\n        }\r\n    },\r\n    update: function (element, valueAccessor, allBindings, viewModel, bindingContext) {\r\n        const isOpen = ko.unwrap(valueAccessor());\r\n        toggleModal(element, isOpen);\r\n    },\r\n}"
          },
