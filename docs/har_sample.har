          "content": {
            "mimeType": "text/html",
            "size": 24396,
            "text": "<script id=\"PXP.DataGrid.ImageColumn\" type=\"text/html\">\r\n    {{#src}}\r\n    <img src=\"{{.}}\" alt=\"{{title}}\" title=\"{{title}}\" data-toggle=\"tooltip\"\r\n         style=\"{{#width}}width:{{.}}px;{{/width}}{{#height}}height:{{.}}px{{/height}}\" />\r\n    {{/src}}\r\n    <div>\r\n        {{description}}\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.IconColumn\" type=\"text/html\">\r\n    {{#icon}}\r\n    <i class=\"{{{icon}}}\" aria-label=\"{{title}}\" title=\"{{title}}\" data-toggle=\"tooltip\"></i>\r\n    {{/icon}}\r\n    <span>\r\n        {{description}}\r\n    </span>\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.ButtonColumn\" type=\"text/html\">\r\n    {{#value}}\r\n    <button type=\"button\" class=\"btn btn-default\" data-action=\"{{dataAction}}\" {{#tooltip}} data-toggle=\"tooltip\" title=\"{{.}}\" {{/tooltip}} aria-label=\"{{.}}\" >\r\n        {{#glyph}}<i class=\"{{.}} glyph\" role=\"presentation\"></i>{{/glyph}}\r\n        <span>{{{value}}}</span>\r\n    </button>\r\n    {{/value}}\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.SelectColumn\" type=\"text/html\">\r\n    <div>\r\n        {{#hasValues}}\r\n        <select class=\"value form-control\" {{#onChangeAction}} data-action=\"{{.}}\" {{/onChangeAction}}>\r\n            {{#templateValues}}\r\n            <option value=\"{{code}}\">{{desc}}</option>\r\n            {{/templateValues}}\r\n        </select>\r\n        {{/hasValues}}\r\n        {{^hasValues}}\r\n        {{value}}\r\n        {{/hasValues}}\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.NumberColumn\" type=\"text/html\">\r\n    <div>\r\n        {{^editable}}\r\n        <span class=\"value\">{{value}}</span>\r\n        {{/editable}}\r\n        {{#editable}}\r\n        <input class=\"value\" type=\"text\"\r\n               aria-label=\"{{label}}\"\r\n               class=\"form-control\"\r\n               value=\"{{value}}\"\r\n               {{#onChangeAction}} data-action=\"{{.}}\" {{/onChangeAction}} />\r\n        {{/editable}}\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.NumberColumnEdit\" type=\"text/html\">\r\n    <input type=\"text\" aria-label=\"{{label}}\" class=\"form-control\" value=\"{{value}}\" />\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.CurrencyColumn\" type=\"text/html\">\r\n    <div>\r\n        {{^editable}}\r\n        <span class=\"value \">{{value}}</span>\r\n        {{/editable}}\r\n        {{#editable}}\r\n        <input class=\"value form-control\" type=\"text\"\r\n               aria-label=\"{{label}}\"\r\n               value=\"{{value}}\"\r\n               style=\"text-align: right\"\r\n               {{#onChangeAction}} data-action=\"{{.}}\" {{/onChangeAction}} />\r\n        {{/editable}}\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.LinkColumn\" type=\"text/html\">\r\n    <div>\r\n        {{#href}}\r\n        <a href=\"{{.}}\" {{{hrefAttributes}}}>\r\n            {{#glyph}}<i class=\"{{.}}\" role=\"presentation\"></i>{{/glyph}}\r\n            <span style=\"white-space: normal\">{{{value}}}</span>\r\n        </a>\r\n        {{/href}}\r\n        {{{description}}}\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.AssignmentColumnWithGoogleLink\" type=\"text/html\">\r\n    <div class=\"pxp-assignment\">\r\n        {{#googleAssignmentVisible}}\r\n        <a class=\"google-link\" target=\"_blank\" href=\"{{googleAssignmentLinkURL}}\"><span class=\"g-logo\"></span></a>\r\n        {{/googleAssignmentVisible}}\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.TeacherColumn\" type=\"text/html\">\r\n    <span class=\"pxp-teacher pxp-contact-info\">\r\n        {{#synergyMailVisible}}\r\n        {{#includeAdditionalStaffWhenEmailingTeachers}}\r\n        <a href='javascript:SMApp.composeEx({{synergyMailToInfo}})'>\r\n            <span class=\"name\">{{teacherName}}</span>\r\n        </a>\r\n        {{/includeAdditionalStaffWhenEmailingTeachers}}\r\n        {{^includeAdditionalStaffWhenEmailingTeachers}}\r\n        <a href='javascript:SMApp.compose(RecipientList.Staff, \"{{sgu}}\", \"{{orgYearGU}}\", \"{{emailSubject}}\")'>\r\n            <span class=\"name\">{{teacherName}}</span>\r\n        </a>\r\n        {{/includeAdditionalStaffWhenEmailingTeachers}}\r\n\r\n        {{#streamsVisible}}\r\n        <a href=\"PXP2_Streams.aspx?AGU={{agu}}&SGU={{sgu}}\"><img class=\"streamIcon\" src=\"images/PXP/streamPost.png\" alt=\"view stream\" /></a>\r\n        {{/streamsVisible}}\r\n\r\n\r\n        {{#includeAdditionalStaffWhenEmailingTeachers}}\r\n        <a href='javascript:SMApp.composeEx({{synergyMailToInfo}})'>\r\n            <span class=\"fa fa-envelope evelopeHandler\"></span><span class=\"sr-only\">Send Message</span>\r\n        </a>\r\n        {{/includeAdditionalStaffWhenEmailingTeachers}}\r\n\r\n        {{^includeAdditionalStaffWhenEmailingTeachers}}\r\n        <a href='javascript:SMApp.compose(RecipientList.Staff, \"{{sgu}}\", \"{{orgYearGU}}\", \"{{emailSubject}}\")'>\r\n            <span class=\"fa fa-envelope\"></span><span class=\"sr-only\">Send Message</span>\r\n        </a>\r\n        {{/includeAdditionalStaffWhenEmailingTeachers}}\r\n\r\n        {{/synergyMailVisible}}\r\n\r\n        {{^synergyMailVisible}}\r\n        {{#streamsVisible}}\r\n        <a class=\"AllTeacherInfo\" href=\"PXP2_Streams.aspx?AGU={{agu}}&SGU={{sgu}}\"><span class=\"name\">{{teacherName}}</span> <img class=\"streamIcon\" src=\"images/PXP/streamPost.png\" alt=\"view stream\" /></a>\r\n        {{/streamsVisible}}\r\n\r\n        {{^streamsVisible}}\r\n        <span class=\"name\">{{teacherName}}</span>\r\n        {{/streamsVisible}}\r\n        {{/synergyMailVisible}}\r\n    </span>\r\n</script>\r\n\r\n<script id=\"PXP.DataGrid.AdditionalStaffTeacherColumn\" type=\"text/html\">\r\n    {{#teacherNameAndTeacherEmailAndTeacherStaffGU}}\r\n    <span class=\"pxp-teacher pxp-contact-info\">\r\n        {{#synergyMailVisible}}\r\n        <a href='javascript:SMApp.compose(RecipientList.Staff, \"{{AdditionalStaffGU}}\", \"{{orgYearGU}}\", \"{{emailSubject}}\")'>\r\n            <span>{{AdditionalStaffName}}</span>\r\n        </a>\r\n        {{#streamsVisible}}\r\n        <a href=\"PXP2_Streams.aspx?AGU={{agu}}&SGU={{AdditionalStaffGU}}\"><img class=\"streamIcon\" src=\"images/PXP/streamPost.png\" alt=\"view stream\" /></a>\r\n        {{/streamsVisible}}\r\n        <a href='javascript:SMApp.compose(RecipientList.Staff, \"{{AdditionalStaffGU}}\", \"{{orgYearGU}}\", \"{{emailSubject}}\")'>\r\n            <span class=\"fa fa-envelope\"></span><span class=\"sr-only\">Send Message</span>\r\n        </a>\r\n        {{/synergyMailVisible}}\r\n\r\n        {{^synergyMailVisible}}\r\n        {{#streamsVisible}}\r\n        <a href=\"PXP2_Streams.aspx?AGU={{agu}}&SGU={{AdditionalStaffGU}}\"><span id=\"additionalStaffName\" class=\"name\">{{AdditionalStaffName}}</span> <img class=\"streamIcon\" src=\"images/PXP/streamPost.png\" alt=\"view stream\" /></a>\r\n        {{/streamsVisible}}\r\n\r\n        {{^streamsVisible}}\r\n        <span class=\"name\"> {{AdditionalStaffName}} </span>\r\n        {{/streamsVisible}}\r\n        {{/synergyMailVisible}}\r\n    </span>\r\n    {{/teacherNameAndTeacherEmailAndTeacherStaffGU}}\r\n</script>\r\n\r\n\r\n\r\n<script id=\"PXP.FlexCountModal\" type=\"text/html\">\r\n    <div class=\"title\">{{#Translate}}FlexCountModalTitle{{/Translate}}</div>\r\n\r\n    <div class=\"st-modal-content\">{{#Translate}}FlexCountModalContent{{/Translate}}</div>\r\n\r\n    <div class=\"controls\">\r\n        <button type=\"button\" class=\"btn btn-primary\" data-action=\"LoadFlexScheduling\">{{#Translate}}Yes{{/Translate}}</button>\r\n        <button type=\"button\" class=\"btn btn-default\" data-action=\"Modal.Close\">{{#Translate}}No{{/Translate}}</button>\r\n    </div>\r\n</script>\r\n\r\n\r\n<script id=\"PXP.SessionExpiring\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        Your session is about to expire\r\n    </div>\r\n\r\n    <div class=\"st-modal-content\">\r\n        <p>For your protection, you are about to be automatically logged out. If you would like to stay logged in, click \"Continue Working\".</p>\r\n        <p>Time Remaining: <span id=\"sessionExpirationSeconds\">60</span> seconds</p>\r\n    </div>\r\n\r\n    <div class=\"controls\">\r\n        <button id=\"keepAliveButton\" type=\"button\" class=\"btn btn-primary\" data-action=\"RequestKeepAlive\">Continue Working</button>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.GBMessage\" type=\"text/html\">\r\n    <div class=\"title\">\r\n        {{subject}}\r\n    </div>\r\n\r\n    <div class=\"st-modal-content\" id=\"PXPMessages\">\r\n        {{&messageText}}\r\n\r\n        {{#attachments}}\r\n        <span class=\"label label-primary attachment\" onclick=\"PXP.OpenAttachment('{{SmAttachmentGU}}')\">\r\n            <span class=\"fa fa-paperclip\"></span>\r\n            {{AttachmentName}}\r\n        </span>\r\n        {{/attachments}}\r\n    </div>\r\n\r\n    <div class=\"controls\">\r\n        <button type=\"button\" class=\"btn btn-primary\" data-action=\"Modal.Close\">Close</button>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.ATT.ReportAbsence.Badge\" type=\"text/html\">\r\n    {{#pastAttendanceData.length}}\r\n    <div class=\"pxp-badge\">{{.}}</div>\r\n    {{/pastAttendanceData.length}}\r\n</script>\r\n\r\n<script id=\"PXP.ATT.ReportAbsenceDialog\" type=\"text/html\">\r\n    {{#pastAttendanceData.length}}\r\n    {{>PXP.ATT.ReportPastAbsencesDialog}}\r\n    {{/pastAttendanceData.length}}\r\n    {{^pastAttendanceData.length}}\r\n    {{>PXP.ATT.ReportFutureAbsenceDialog}}\r\n    {{/pastAttendanceData.length}}\r\n</script>\r\n\r\n<script id=\"PXP.ATT.ReportPastAbsencesDialog\" type=\"text/html\">\r\n    <div class=\"modal att-abs-modal fade\" data-keyboard=\"true\" data-backdrop=\"true\" tabindex=\"-1\" role=\"dialog\" data-agu=\"{{agu}}\" input-type=\"past\">\r\n        <div class=\"modal-dialog modal-lg\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\"><span aria-hidden=\"true\">&times;</span></button>\r\n                    <h4 class=\"modal-title\">{{#Translate}}ReportAbsences{{/Translate}}&nbsp;- {{StudentFirstName}}</h4>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"alert alert-info\" style=\"padding: 5px;\">\r\n                        <i class=\"fas fa-info-circle\" role=\"presentation\"></i>\r\n                        {{#Translate}}PastAbsenceMessage{{/Translate}}\r\n                    </div>\r\n                    <table class=\"table pxp-absence-table\">\r\n                        <thead>\r\n                            <tr>\r\n                                <th scope=\"col\">{{#Translate}}Date{{/Translate}}</th>\r\n                                {{#ShowPeriodColumn}}\r\n                                <th scope=\"col\">{{#Translate}}Periods{{/Translate}}</th>\r\n                                {{/ShowPeriodColumn}}\r\n                                <th scope=\"col\">{{#Translate}}SelectAReason{{/Translate}}</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody>\r\n                            {{#pastAttendanceData}}\r\n                            <tr data-date=\"{{AttendanceDate}}\">\r\n                                <td>{{FormattedDate}}</td>\r\n                                {{#ShowPeriodColumn}}\r\n                                <td>{{AttendancePeriod}}</td>\r\n                                {{/ShowPeriodColumn}}\r\n                                <td>\r\n                                    {{>ATT.Dropdown.ReasonTypes}}\r\n                                </td>\r\n                            </tr>\r\n                            {{/pastAttendanceData}}\r\n                        </tbody>\r\n                    </table>\r\n                    <div class=\"flexbox horizontal middle\" style=\"flex-wrap: wrap\">\r\n                        <div class=\"auto\">\r\n                            <div style=\"padding: 5px; margin-top: 15px\" {{#NotesAreMandatory}} class=\"mandatory\" {{/NotesAreMandatory}}>\r\n                                <label>{{#Translate}}Note{{/Translate}}</label>\r\n                                <textarea class=\"form-control\" style=\"min-height: 100px\"></textarea>\r\n                            </div>\r\n                        </div>\r\n                        {{#showUploadControl}}\r\n                        <div>\r\n                            <div class=\"upload-control\">\r\n                                <form enctype=\"multipart/form-data\" action=\"POST\">\r\n                                    <div class=\"file-details\">\r\n                                        <button type=\"button\" class=\"btn btn-link\" data-action=\"ATT.RemoveNote\">\r\n                                            <span class=\"fa fa-minus-circle\"></span>\r\n                                            <span class=\"sr-only\">{{#Translate}}Remove{{/Translate}}</span>\r\n                                        </button>\r\n                                        <span class=\"filename\"></span>\r\n                                    </div>\r\n                                    <label class=\"btn btn-primary btn-upload\">\r\n                                        <input type=\"file\" name=\"absenceNote\" class=\"sr-only\" data-action=\"ATT.AttachNote\" />\r\n                                        {{#Translate}}UploadAbsenseNote{{/Translate}}\r\n                                    </label>\r\n                                </form>\r\n                            </div>\r\n                        </div>\r\n                        {{/showUploadControl}}\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <div class=\"flexbox horizontal padded\">\r\n                        <div class=\"auto\" style=\"text-align: start\">\r\n                            <div>\r\n                                <button type=\"button\" data-action=\"ATT.ToggleReportAbsenceType\" class=\"btn btn-default\">{{#Translate}}ReportForToday{{/Translate}}</button>\r\n                            </div>\r\n                        </div>\r\n                        <div>\r\n                            <button type=\"button\" class=\"btn btn-primary\" data-action=\"ATT.SavePastReportAbsence\">{{#Translate}}Save{{/Translate}}</button>\r\n                        </div>\r\n                        <div>\r\n                            <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">{{#Translate}}Close{{/Translate}}</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script id=\"PXP.ATT.ReportFutureAbsenceDialog\" type=\"text/html\">\r\n    <div class=\"modal att-abs-modal fade\" data-keyboard=\"true\" data-backdrop=\"true\" tabindex=\"-1\" role=\"dialog\" data-agu=\"{{agu}}\" input-type=\"future\">\r\n        <div class=\"modal-dialog modal-lg\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\"><span aria-hidden=\"true\">&times;</span></button>\r\n                    <h4 class=\"modal-title\">{{#Translate}}ReportAbsences{{/Translate}}&nbsp;- {{StudentFirstName}}</h4>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"alert alert-info\" style=\"padding: 5px;\">\r\n                        <i class=\"fas fa-info-circle\" role=\"presentation\"></i>\r\n                        {{#Translate}}Instructions{{/Translate}}\r\n                    </div>\r\n                    <div class=\"layout-table input-table\" style=\"width:100%\">\r\n                        <span class=\"layout-column middle\">\r\n                            <label class=\"ph-label\">\r\n                                <span>{{#Translate}}StartDate{{/Translate}}:</span>\r\n                                <input class=\"form-control date\" name=\"start_date\" size=\"12\" style=\"min-width: 120px; padding-right: 24px;\" />\r\n                            </label>\r\n                            <span class=\"date-addon\">\r\n                                <span class=\"glyphicon glyphicon-calendar\" role=\"presentation\"></span>\r\n                            </span>\r\n                        </span>\r\n                        <span class=\"layout-column middle\">\r\n                            <label class=\"ph-label\">\r\n                                <span>{{#Translate}}EndDate{{/Translate}}:</span>\r\n                                <input class=\"form-control date\" name=\"end_date\" size=\"12\" style=\"min-width: 120px; padding-right: 24px;\" />\r\n                            </label>\r\n                            <span class=\"date-addon\">\r\n                                <span class=\"glyphicon glyphicon-calendar\" role=\"presentation\"></span>\r\n                            </span>\r\n                        </span>\r\n                        <span class=\"layout-column middle\">\r\n                            {{>ATT.Dropdown.ReasonTypes}}\r\n                        </span>\r\n                    </div>\r\n                    <div class=\"layout-table middle\" style=\"width: 100%\">\r\n                        <div class=\"layout-column\">\r\n                            <div style=\"padding: 5px; margin-top: 15px\" {{#NotesAreMandatory}} class=\"mandatory\" {{/NotesAreMandatory}}>\r\n                                <label>{{#Translate}}Note{{/Translate}}</label>\r\n                                <textarea class=\"form-control\" style=\"min-height: 100px\"></textarea>\r\n                            </div>\r\n                        </div>\r\n                        {{#showUploadControl}}\r\n                        <div class=\"layout-column\">\r\n                            <div class=\"upload-control\">\r\n                                <form enctype=\"multipart/form-data\" action=\"POST\">\r\n                                    <div class=\"file-details\">\r\n                                        <button type=\"button\" class=\"btn btn-link\" data-action=\"ATT.RemoveNote\">\r\n                                            <span class=\"fa fa-minus-circle\"></span>\r\n                                            <span class=\"sr-only\">{{#Translate}}Remove{{/Translate}}</span>\r\n                                        </button>\r\n                                        <span class=\"filename\"></span>\r\n                                    </div>\r\n                                    <label class=\"btn btn-primary btn-upload\">\r\n                                        <input type=\"file\" name=\"absenceNote\" class=\"sr-only\" data-action=\"ATT.AttachNote\" />\r\n                                        {{#Translate}}UploadAbsenseNote{{/Translate}}\r\n                                    </label>\r\n                                </form>\r\n                            </div>\r\n                        </div>\r\n                        {{/showUploadControl}}\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <div class=\"flexbox horizontal padded\">\r\n                        <div class=\"auto\" style=\"text-align: start\">\r\n                            {{#pastAttendanceData.length}}\r\n                            <div>\r\n                                <button type=\"button\" data-action=\"ATT.ToggleReportAbsenceType\" class=\"btn btn-default\">{{#Translate}}ReportPast{{/Translate}}</button>\r\n                            </div>\r\n                            {{/pastAttendanceData.length}}\r\n                        </div>\r\n                        <div>\r\n                            <button type=\"button\" class=\"btn btn-primary\" data-action=\"ATT.SaveReportAbsence\">{{#Translate}}Save{{/Translate}}</button>\r\n                        </div>\r\n                        <div>\r\n                            <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">{{#Translate}}Close{{/Translate}}</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"ATT.Dropdown.ReasonTypes\">\r\n    {{#AttendanceReasonOpts}}\r\n    <div class=\"dropdown att-dropdown-reasontypes\">\r\n        <button type=\"button\" class=\"btn btn-default dropdown-toggle\" data-toggle=\"dropdown\">\r\n            <span class=\"btn-content\"><i>{{#Translate}}SelectAReason{{/Translate}}</i></span>\r\n            <span class=\"caret\" role=\"presentation\"></span>\r\n        </button>\r\n        <ul class=\"dropdown-menu\">\r\n            {{#Reasons}}\r\n            <li>\r\n                <a href=\"#\" class=\"layout-table\" data-action=\"ATT.SelectReasonType\" data-id=\"{{ReasonGU}}\">\r\n                    <span class=\"layout-column middle\">{{{Description}}}</span>\r\n                </a>\r\n            </li>\r\n            {{/Reasons}}\r\n        </ul>\r\n    </div>\r\n    {{/AttendanceReasonOpts}}\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"ATT.Calendar\">\r\n    <div>\r\n        <table class=\"table table-bordered att-calendar-table\">\r\n            <caption><span class=\"month\">{{month}}</span> <span class=\"year\">{{year}}</span></caption>\r\n            <thead>\r\n                <tr>\r\n                    <th aria-label=\"{{#Translate}}Sun{{/Translate}}\">S</th>\r\n                    <th aria-label=\"{{#Translate}}Mon{{/Translate}}\">M</th>\r\n                    <th aria-label=\"{{#Translate}}Tue{{/Translate}}\">T</th>\r\n                    <th aria-label=\"{{#Translate}}Wed{{/Translate}}\">W</th>\r\n                    <th aria-label=\"{{#Translate}}Thu{{/Translate}}\">T</th>\r\n                    <th aria-label=\"{{#Translate}}Fri{{/Translate}}\">F</th>\r\n                    <th aria-label=\"{{#Translate}}Sat{{/Translate}}\">S</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {{#rows}}\r\n                <tr>\r\n                    {{#days}}\r\n                    <td class=\"{{cssClass}} no-select\" {{#reason}} data-toggle=\"tooltip\" title=\"{{.}}\" {{/reason}} {{#action}} data-action=\"{{.}}\" role=\"button\" tabindex=\"0\" {{/action}} data-date=\"{{date}}\">\r\n                        <span>{{day}}</span>\r\n                        {{#reasonType}}\r\n                        {{#EMG}}<i class=\"fa fa-check-circle-o att-icon-excused att-icon\" data-type=\"EXC\"></i>{{/EMG}}\r\n                        {{#SUP}}<i class=\"fa fa-check-circle-o att-icon-excused att-icon\" data-type=\"EXC\"></i>{{/SUP}}\r\n                        {{#EXC}}<i class=\"fa fa-check-circle-o att-icon-excused att-icon\" data-type=\"EXC\"></i>{{/EXC}}\r\n                        {{#TAR}}<i class=\"fa fa-clock-o att-icon-tardy att-icon\" data-type=\"TDY\" style=\"color: red\"></i>{{/TAR}}\r\n                        {{#TDY}}<i class=\"fa fa-clock-o att-icon-tardy att-icon\" data-type=\"TDY\"></i>{{/TDY}}\r\n\r\n                        {{#UNX}}<i class=\"fa fa-times att-icon-unexcused att-icon\" data-type=\"UNE\"></i>{{/UNX}}\r\n                        {{#UNV}}<i class=\"fa fa-times att-icon-unexcused att-icon\" data-type=\"UNE\"></i>{{/UNV}}\r\n                        {{#EMX}}<i class=\"fa fa-check-circle-o att-icon-excused att-icon\" data-type=\"EXC\"></i>{{/EMX}}\r\n\r\n                        {{#ACT}}<i class=\"fa fa-flag-o att-icon-activity att-icon\" data-type=\"ACT\"></i>{{/ACT}}\r\n                        {{#HOL}}<i class=\"fa fa-ban att-icon-holiday att-icon\" data-type=\"HOL\"></i>{{/HOL}}\r\n                        {{#NS}}<i class=\"att-icon-ns\">N/S</i>{{/NS}}\r\n                        {{#NE}}<i style=\"display:block;\">&nbsp;</i>{{/NE}}\r\n                        {{#NA}}<i style=\"display:block;\">&nbsp;</i>{{/NA}}\r\n                        {{/reasonType}}\r\n                        {{^reasonType}}<i style=\"display:block;\">&nbsp;</i>{{/reasonType}}\r\n                    </td>\r\n                    {{/days}}\r\n                </tr>\r\n                {{/rows}}\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n</script>\r\n\r\n<script type=\"text/html\" id=\"ATT.DatePicker\">\r\n    <div class=\"att-datepicker no-select\" role=\"presentation\">\r\n        <div class=\"scroller prev-month\">\r\n            <button type=\"button\" class=\"btn btn-link\">\r\n                <span class=\"glyphicon glyphicon-chevron-left\"></span>\r\n            </button>\r\n        </div>\r\n        {{#months}}\r\n        <div class=\"att-dp-calendar\">\r\n            <table class=\"table table-bordered att-calendar-table\">\r\n                <caption><span class=\"month\">{{month}}</span> <span class=\"year\">{{year}}</span></caption>\r\n                <thead>\r\n                    <tr><th>S</th><th>M</th><th>T</th><th>W</th><th>T</th><th>F</th><th>S</th></tr>\r\n                </thead>\r\n                <tbody>\r\n                    {{#weeks}}\r\n                    <tr>\r\n                        {{#days}}\r\n                        <td data-date=\"{{date}}\" class=\"day {{disabled}}\"><span>{{day}}</span></td>\r\n                        {{/days}}\r\n                    </tr>\r\n                    {{/weeks}}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n    {{/months}}\r\n    <div class=\"scroller next-month\">\r\n        <button type=\"button\" class=\"btn btn-link\">\r\n            <span class=\"glyphicon glyphicon-chevron-right\"></span>\r\n        </button>\r\n    </div>\r\n</script>"
