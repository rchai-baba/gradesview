          "content": {
            "mimeType": "text/css",
            "size": 5619,
            "text": "svue-hallpass {\r\n    display: inline-block;\r\n    position: relative;\r\n    vertical-align: top;\r\n    margin-top: -4px;\r\n\r\n}\r\n\r\nsvue-hallpass .hallpass-btn {\r\n      z-index: 5;\r\n}\r\n\r\nsvue-hallpass .request-hallpass-btn { \r\n    border: 1px solid #cccccc;\r\n    border-radius: 0.5em;\r\n    background-color: #fff;\r\n    padding: 5px;\r\n    cursor: pointer;\r\n    color: #444;\r\n}\r\n\r\nsvue-hallpass .hall-pass-dialog {\r\n    background-color: #fff;\r\n    color: #444;\r\n}\r\n\r\n    svue-hallpass .hallpass-btn .remaining {\r\n        display: block;\r\n        color: black;\r\n\r\n    }\r\n\r\n    svue-hallpass .hallpass-btn[active='true'] {\r\n        display: flex;\r\n        flex-direction: column;\r\n        align-items: center;\r\n        background-color: yellow;\r\n        border: 1px solid #cccccc;\r\n        border-radius: 0.3em;\r\n        padding-left: 5px;\r\n        padding-right: 5px;\r\n    }\r\n\r\n\r\nsvue-hallpass .wizard-step-contents {\r\n    min-width: 500px;\r\n}\r\n\r\nsvue-hallpass .request-hallpass-btn {\r\n    max-width:140px;\r\n}\r\n\r\nsvue-hallpass .room-filters > * {\r\n    display: inline;\r\n    margin-left: 5px;\r\n    margin-right: 5px;\r\n}\r\n\r\n\r\nsvue-hallpass .room-lock-filter {\r\n    border: 1px solid gray;\r\n    border-radius: 3px;\r\n    padding: 5px;\r\n    text-align: center;\r\n}\r\n\r\n\r\nsvue-hallpass .room-lock-filter.locked {\r\n    padding-right: 3px;\r\n}\r\n\r\nsvue-hallpass .hall-pass-room {\r\n    position: relative;\r\n    border: 1px solid #cccccc;\r\n    border-radius: 0.5em;\r\n    display: inline-block;\r\n    padding: 10px;\r\n    padding-top: 20px;\r\n    text-align: center;\r\n    min-width: 190px;\r\n    min-height: 120px;\r\n    margin: 3px;\r\n    cursor: pointer;\r\n}\r\n\r\nsvue-hallpass .hall-pass-room[data-selected=\"true\"] {\r\n    outline: 3px solid #444;\r\n    outline-offset: 2px;\r\n}\r\n\r\n\r\nsvue-hallpass .hall-pass-room .room-icon {\r\n    height: 52px;\r\n}\r\n\r\nsvue-hallpass .hall-pass-room .location-name {\r\n    color: #fff;\r\n    display: block;\r\n    font-size: 16px;\r\n}\r\n\r\nsvue-hallpass .hall-pass-room .approval-required {\r\n    position: absolute;\r\n    right: 10px;\r\n    top: 5px;\r\n    color: #fff;\r\n}\r\n\r\nsvue-hallpass .selected-room {\r\n    border-radius: 5px;\r\n    padding: 10px;\r\n}\r\n\r\nsvue-hallpass .selected-room .room-icon {\r\n    height: 52px;\r\n}\r\n\r\nsvue-hallpass .selected-room .location-name {\r\n    margin-left: 20px;\r\n    color: #fff;\r\n    font-size: 22px;\r\n}\r\n\r\nsvue-hallpass .time-select .slider {\r\n    vertical-align: middle;\r\n    -webkit-appearance: none;\r\n    width: 100%;\r\n    height: 15px;\r\n    border-radius: 5px;\r\n    background: #d3d3d3;\r\n    outline: none;\r\n    opacity: 0.7;\r\n    -webkit-transition: .2s;\r\n    transition: opacity .2s;\r\n    margin-top: 4px;\r\n}\r\n\r\nsvue-hallpass .time-select .slider:hover {\r\n    opacity: 1;\r\n}\r\n\r\nsvue-hallpass .time-select .slider::-webkit-slider-thumb {\r\n    -webkit-appearance: none;\r\n    appearance: none;\r\n    width: 25px;\r\n    height: 25px;\r\n    border-radius: 50%;\r\n    background: var(--st-btn-primary-bg);\r\n    cursor: pointer;\r\n}\r\n\r\nsvue-hallpass .time-select .slider::-moz-range-thumb {\r\n    width: 25px;\r\n    height: 25px;\r\n    border-radius: 50%;\r\n    background: var(--st-btn-primary-bg);\r\n    cursor: pointer;\r\n}\r\n\r\nsvue-hallpass .time-select .slider-value {\r\n    font-size: 18px;\r\n    text-align: center;\r\n}\r\n\r\nsvue-hallpass .current-pass {\r\n    border-radius: 5px;\r\n    max-width: 400px;\r\n    padding: 10px;\r\n}\r\n\r\nsvue-hallpass .current-pass .current-pass-details {\r\n    display: inline-block;\r\n}\r\n\r\nsvue-hallpass .current-pass .location-name,\r\nsvue-hallpass .current-pass .date-time,\r\nsvue-hallpass .current-pass .remaining,\r\nsvue-hallpass .current-pass .queue-msg,\r\nsvue-hallpass .current-pass .pending-msg {\r\n    color: #fff;\r\n    display: block;\r\n}\r\n\r\nsvue-hallpass .current-pass .location-name,\r\nsvue-hallpass .current-pass .remaining {\r\n    font-size: 20px;\r\n}\r\n\r\nsvue-hallpass .current-pass .date-time,\r\nsvue-hallpass .current-pass .queue-msg,\r\nsvue-hallpass .current-pass .pending-msg {    \r\n    font-size: 14px;\r\n}\r\n\r\nsvue-hallpass .current-pass[status=\"little-expired\"] .remaining {\r\n    background-color: orange;\r\n    border: 1px solid red;\r\n    border-radius: 5px;\r\n    color: black;\r\n    padding: 3px;\r\n}\r\n\r\nsvue-hallpass .current-pass[status=\"expired\"] .remaining {\r\n    background-color: red;\r\n    border: 1px solid white;\r\n    border-radius: 5px;\r\n    padding: 3px;\r\n}\r\n\r\nsvue-hallpass .header-pending-msg,\r\nsvue-hallpass .queue-refresh-data-msg {\r\n    background-color: yellow;\r\n    color: #222;\r\n    font-weight: bold;\r\n    border-radius: 4px;\r\n    padding: 4px;\r\n    border: 1px solid #aaa;\r\n    margin-bottom: 5px;\r\n}\r\n\r\nsvue-hallpass .current-pass .current-pass-remove {\r\n    color: #fff;\r\n    font-size: 18px;\r\n    position: absolute;\r\n    right: 16px;\r\n    top: 12px;\r\n    cursor: pointer;\r\n}\r\n\r\nsvue-hallpass .current-pass .current-pass-remove:hover {\r\n    color: #bbb;\r\n}\r\n\r\nsvue-hallpass .scheduled-passes-label {\r\n    font-size: 20px;\r\n    margin-top: 12px;\r\n}\r\n\r\nsvue-hallpass .future-pass {\r\n    border-radius: 5px;\r\n    padding: 10px;\r\n    margin: 5px;\r\n    display: inline-block;\r\n    width: 300px;\r\n}\r\n\r\nsvue-hallpass .future-pass .room-icon {\r\n    width: 48px;\r\n}\r\n\r\nsvue-hallpass .future-pass .future-pass-details {\r\n    display: inline-block;\r\n    color: #fff;\r\n    font-size: 16px;\r\n    margin-left: 10px;\r\n    vertical-align: middle;\r\n}\r\n\r\nsvue-hallpass .future-pass .future-pass-details > * {\r\n    display: block;\r\n}\r\n\r\nsvue-hallpass .future-pass .remove-hall-pass {\r\n    color: #eee;\r\n}\r\n\r\nsvue-hallpass .room-lock-filter[data-selected] {\r\n    background-color: orange;\r\n}\r\n\r\nsvue-hallpass .no-rooms {\r\n    font-size: 16px;\r\n    font-weight: bold;\r\n}"
