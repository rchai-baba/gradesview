          "content": {
            "mimeType": "application/javascript",
            "size": 33256,
            "text": "var MIN_WIDTH_FOR_2X_CALENDAR = 768;\r\n\r\n$.extend(Namespace('PXP.ATT'), {\r\n    GetCurrentTermName: function () {\r\n        return $('#attendance-root')\r\n            .find('>.term-selector>.btn-group>[data-term-name]')\r\n            .attr('data-term-name');\r\n    },\r\n\r\n    SetTerm: function (termName) {\r\n        // Update the state of all term selectors\r\n        if (termName && !PXP.ATT.SettingTerm) {\r\n            PXP.ATT.SettingTerm = true;\r\n            $('.term-selector button[data-term-name]').each(function () {\r\n                var $currTermEl = $(this).closest('.term-selector').find('li[data-term-name=\"' + termName + '\"]');\r\n\r\n                this.setAttribute('data-term-name', termName);\r\n\r\n                var $btn = $(this);\r\n                $btn.html($currTermEl.children().html());\r\n\r\n                // Update the arrow visibility\r\n                $btn.siblings('button').first().css('visibility', $currTermEl.prev().length ? 'visible' : 'hidden');\r\n                $btn.siblings('button').last().css('visibility', $currTermEl.next().length ? 'visible' : 'hidden');\r\n            });\r\n\r\n            $('table > [data-term-name]').removeClass('hidden')\r\n                .not('[data-term-name=\"' + termName + '\"]')\r\n                .addClass('hidden');\r\n\r\n            // Refresh all of the containers\r\n            PXP.ATT.RefreshPeriodAttendanceChart();\r\n            PXP.ATT.RefreshCourseAttendanceChart();\r\n            PXP.ATT.RefreshAttendanceDetails();\r\n\r\n            PXP.ATT.SettingTerm = false;\r\n        }\r\n    },\r\n\r\n    InitializeCalendar: function () {\r\n        var attData = PXP.StudentAttendanceData?.attendanceData;\r\n\r\n        $('#calendar-container').empty().append(ich['ATT.ScrollingCalendar']());\r\n\r\n        // Store all months for the school year that are prior to or equal to the current month\r\n        var date = new Date();\r\n        date = new Date(date.getFullYear(), date.getMonth(), 1);\r\n        var firstMonths = [];\r\n\r\n        // For each month, create a calendar and insert it into the page\r\n        var endDate = new Date(attData.Calendar.endDate);\r\n        var startDate = new Date(attData.Calendar.startDate);\r\n        var startMonth = new Date(startDate.getFullYear(), startDate.getMonth(), 1);\r\n        var $calCont = $('#calendar-container').find('.inner');\r\n        /*$calCont.width($calCont.width());*/\r\n        while (startMonth <= endDate) {\r\n            var $cal = $('<div class=\"calendar-sm\"></div>').appendTo($calCont);\r\n            $cal.attCalendar(startMonth);\r\n\r\n            if (startMonth <= date || firstMonths.length < 3) {\r\n                firstMonths.push($cal);\r\n            }\r\n\r\n            startMonth = dateAdd(startMonth, 'm', 1);\r\n        }\r\n\r\n        // Make the current month - 1 the active month that will display to the far left\r\n        var idx = Math.max(firstMonths.length - 1, 0);\r\n        if ($(window).width() >= MIN_WIDTH_FOR_2X_CALENDAR) {\r\n            idx -= 1;\r\n        }\r\n\r\n        var $currMonth = firstMonths[idx] || $();\r\n        $currMonth.addClass('active');\r\n\r\n        // Update the scroll position of the calendars\r\n        PXP.ATT.RefreshCalendarPosition();\r\n    },\r\n\r\n    RefreshPeriodAttendanceChart: function() {\r\n        $('#attendance-by-period').pxpStackedBarGraph({\r\n            labelCol: 0,\r\n            valueCols: [1, 2]\r\n        });\r\n    },\r\n\r\n    RefreshCourseAttendanceChart: function () {\r\n        $('#attendance-by-course').pxpSummary({\r\n            popoverID: 'ATT.AttByPeriod.popover',\r\n            detailAction: 'ATT.ShowCourseDetailView',\r\n            tbodyFilter: '[data-term-name=\"' + PXP.ATT.GetCurrentTermName() + '\"]',\r\n            valueCols: [2, 3, 4]\r\n        });\r\n    },\r\n\r\n    RefreshAttendanceDetails: function () {\r\n    },\r\n\r\n    RefreshCalendarPosition: function (bImmediately) {\r\n        var $active = $('#calendar-container').find('.calendar-sm.active');\r\n        var offset = $active.offset();\r\n        if (offset) {\r\n            var scrollLeft = $active.parent().scrollLeft()\r\n                + offset.left\r\n                - $active.parent().offset().left;\r\n\r\n            if (bImmediately) {\r\n                $active.parent().stop().scrollLeft(scrollLeft);\r\n            }\r\n            else {\r\n                $active.parent().stop()\r\n                    .animate({\r\n                        scrollLeft: scrollLeft\r\n                    }, {\r\n\r\n                        duration: 250\r\n                    });\r\n            }\r\n        }\r\n    }\r\n});\r\n\r\n(function ($) {\r\n    $.extend(Namespace('PXP.Actions.ATT'), {\r\n        PrevTerm: function (ev) {\r\n            var currentTerm = PXP.ATT.GetCurrentTermName();\r\n            var $prevTermEl = $(this).siblings('ul')\r\n                .find('li[data-term-name=\"' + currentTerm + '\"]')\r\n                .prev()\r\n                .children();\r\n\r\n            if ($prevTermEl.length) {\r\n                PXP.Actions.ATT.SetTerm.apply($prevTermEl[0], arguments);\r\n            }\r\n        },\r\n\r\n        NextTerm: function (ev) {\r\n            var currentTerm = PXP.ATT.GetCurrentTermName();\r\n            var $nextTermEl = $(this).siblings('ul')\r\n                .find('li[data-term-name=\"' + currentTerm + '\"]')\r\n                .next()\r\n                .children();\r\n\r\n            if ($nextTermEl.length) {\r\n                PXP.Actions.ATT.SetTerm.apply($nextTermEl[0], arguments);\r\n            }\r\n        },\r\n\r\n        SetTerm: function (ev) {\r\n            PXP.ATT.SetTerm(this.parentNode.getAttribute('data-term-name'));\r\n        },\r\n\r\n        CloseDetailView: function (ev) {\r\n            var $attRoot = $('#attendance-root');\r\n\r\n            $attRoot.removeClass('show-details');\r\n        },\r\n\r\n        ShowPeriodDetailView: function (ev) {\r\n            var $attRoot = $('#attendance-root');\r\n            var $details = $attRoot.children('.attendance-details');\r\n            var $detailGrid = $('#attendance-by-period').children('.detail-grid').clone();\r\n\r\n            var $allPeriodRows = $detailGrid.find('tbody[data-term-name]')\r\n                .children('[data-guid]')\r\n                .removeClass('expanded');\r\n\r\n            // Check if a segment was clicked (show the current period\r\n            var segment = this.chart.activeSegment;\r\n            var data = segment && segment.data;\r\n            var currPeriod;\r\n            if (data) {\r\n                var tr = $('#attendance-by-period')\r\n                    .find('tr[data-guid]')\r\n                    .not('.empty-row')\r\n                    .not('.att-course-details')[data.column];\r\n                if (tr) {\r\n                    currPeriod = tr.getAttribute('data-guid');\r\n                }\r\n            }\r\n\r\n            if (currPeriod) {\r\n                // display the clicked period\r\n                $allPeriodRows\r\n                    .filter('[data-guid=\"' + currPeriod + '\"]')\r\n                    .addClass('expanded')\r\n            }\r\n\r\n            // remove all empty tbody elements and tables\r\n            var $emptyTbody = $detailGrid.find('tbody[data-term-name]')\r\n                .filter(function () { return $(this).children().length == 0; });\r\n            var $tables = $emptyTbody.parent();\r\n\r\n            $emptyTbody.remove();\r\n            $tables.filter(function () { return $(this).children('tbody').length == 0; })\r\n                .closest('.school-detail')\r\n                .remove();\r\n\r\n            // Add update the detail element and show it.\r\n            $details.empty()\r\n                .append(ich['ATT.PeriodDetailHeading']({\r\n                    subtitle: currPeriod ? 'Period ' + currPeriod : ''\r\n                }))\r\n                .append($detailGrid);\r\n            $attRoot.addClass('show-details');\r\n\r\n            // Append the term selector\r\n            var $terms = $('#attendance-root').children('.term-selector').clone();\r\n            var validTerms = {};\r\n\r\n            // Remove invalid terms for this course\r\n            $detailGrid.find('tbody[data-term-name]').each(function () {\r\n                validTerms[this.getAttribute('data-term-name')] = true;\r\n            });\r\n            $terms.find('li[data-term-name]')\r\n                .filter(function () { return !validTerms[this.getAttribute('data-term-name')]; })\r\n                .remove();\r\n\r\n            $details.children('h1').append($terms.addClass('pull-right'));\r\n\r\n            // Make sure the current term is valid\r\n            if (!validTerms[PXP.ATT.GetCurrentTermName()]) {\r\n                PXP.ATT.SetTerm($terms.find('li[data-term-name]').first().attr('data-term-name'));\r\n            }\r\n            else {\r\n                PXP.ATT.SetTerm(PXP.ATT.GetCurrentTermName());\r\n            }\r\n\r\n            $(document.body).animate({\r\n                scrollTop: 0\r\n            });\r\n        },\r\n\r\n        ShowCourseDetailView: function (ev) {\r\n            var $attRoot = $('#attendance-root');\r\n            var $details = $attRoot.children('.attendance-details');\r\n            var $detailGrid = $('#attendance-by-course').children('.detail-grid').clone();\r\n\r\n            // remove the other courses\r\n            var courseID = this.getAttribute('data-guid');\r\n            $detailGrid.fastFind('tbody[data-term-name]')\r\n                .children('[data-guid]')\r\n                .not('[data-guid=\"' + courseID + '\"]')\r\n                .remove();\r\n\r\n            // expand all of the nodes\r\n            $detailGrid.fastFind('tr.att-course-details').addClass('expanded');\r\n\r\n            $detailGrid.fastFind('.school-detail').each((i, sd) => {\r\n                let $sd = $(sd);\r\n                if ($sd.fastFind('tr.att-course-details').length === 0) {\r\n                    $sd.hide();\r\n                }\r\n            });\r\n\r\n            // remove all of the row toggle buttons\r\n            $detailGrid.fastFind('[data-action=\"ATT.ShowCourseDetails\"]').remove();\r\n\r\n            // remove all empty tbody elements and tables\r\n            var $emptyTbody = $detailGrid.find('tbody')\r\n                .filter(function () { return $(this).children().length == 0; });\r\n            var $tables = $emptyTbody.parent();\r\n\r\n            $emptyTbody.remove();\r\n            $detailGrid.find('table')\r\n                .filter(function () { return $(this).children('tbody').length == 0; })\r\n                .closest('tr,.school-detail')\r\n                .remove();\r\n\r\n            $details.empty()\r\n                .append(ich['ATT.DetailHeading']({\r\n                    subtitle: $(this).children('.title').text().trim()\r\n                }))\r\n                .append($detailGrid);\r\n            $attRoot.addClass('show-details');\r\n\r\n            // Append the term selector\r\n            var $terms = $('#attendance-root').children('.term-selector').clone();\r\n            var validTerms = {};\r\n\r\n            // Remove invalid terms for this course\r\n            $detailGrid.fastFind('tbody[data-term-name]').each(function () {\r\n                validTerms[this.getAttribute('data-term-name')] = true;\r\n            });\r\n            $terms.fastFind('li[data-term-name]')\r\n                .filter(function () { return !validTerms[this.getAttribute('data-term-name')]; })\r\n                .remove();\r\n\r\n            $details.children('h1').append($terms.addClass('pull-right'));\r\n\r\n            // Make sure the current term is valid\r\n            if (!validTerms[PXP.ATT.GetCurrentTermName()]) {\r\n                PXP.ATT.SetTerm($terms.fastFind('li[data-term-name]').first().attr('data-term-name'));\r\n            }\r\n            else {\r\n                PXP.ATT.SetTerm(PXP.ATT.GetCurrentTermName());\r\n            }\r\n\r\n            // Initialize the ring chart\r\n            var thRow = $detailGrid.fastFind('thead').not('[data-term-name]').children('tr')[0];\r\n            var tdRow = $detailGrid.fastFind('tbody > tr').not('.empty-row')[0];\r\n            var values = {};\r\n            for (var i = 2; i < 5; i++) {\r\n                if (tdRow && tdRow.cells[i]) {\r\n                    value = tdRow.cells[i].textContent.trim();\r\n                    values[thRow.cells[i].textContent] = parseInt(value) || 0;\r\n                }\r\n            }\r\n\r\n            $details.fastFind('.pxp-ring-chart').pxpRingChart({\r\n                values: values\r\n            });\r\n\r\n            window.scrollTo({\r\n                top: 0,\r\n                behavior: 'smooth'\r\n            })\r\n\r\n            $('.popover').remove();\r\n        },\r\n\r\n        ShowCourseDetails: function (ev) {\r\n            var $tr = $(this).closest('tr');\r\n\r\n            $tr.toggleClass('expanded')\r\n                .next('tr')\r\n                .toggleClass('expanded')\r\n                .siblings()\r\n                .not($tr)\r\n                .removeClass('expanded');\r\n        },\r\n\r\n        ToggleCalendarDetails: function (ev) {\r\n            var $panel = $('#attendance-root');\r\n            var $calDetails = $panel.find('.calendar-details');\r\n            var $calendar = $('.calendar-sm');\r\n\r\n            var $subTitle = $calDetails.find('>h1>.subtitle');\r\n            var $details = $calDetails.find('>.daily-details>.details');\r\n\r\n            var date = this.getAttribute('data-date');\r\n            var bIsNewDate = date && date != $calDetails.attr('data-date');\r\n\r\n            var showAttendanceNotes = !!(window.PXP && window.PXP.Security && window.PXP.Security.ShowAttendanceNotes);\r\n\r\n            $calDetails.attr('data-date', date);\r\n            $calendar.find('td.active').removeClass('active');\r\n\r\n            if ($calDetails.is(':visible') && !bIsNewDate) {\r\n                $calDetails.slideUp({\r\n                    complete: function () {\r\n                        $details.empty();\r\n                    }\r\n                });\r\n            }\r\n            else {\r\n                $calDetails.addClass('loading').slideDown();\r\n\r\n                $(this).addClass('active');\r\n\r\n                PXPCallWebMethod('AttGetCalendarDay',\r\n                    {\r\n                        agu: PXP.AGU,\r\n                        date: date\r\n                    })\r\n                    .done(function (response) {\r\n                        $subTitle.text(date);\r\n\r\n                        var dailyData = [];\r\n                        response.PeriodDailySummary.Schools\r\n                            .forEach(function (sch) {\r\n                                if (sch.Terms) {\r\n                                    sch.Terms.forEach(function (term) {\r\n                                        if (term.Rows) {\r\n                                            dailyData.push(term.Rows[0]);\r\n                                        }\r\n                                    });\r\n                                }\r\n                            });\r\n\r\n                        response.ShowAttendanceNotes = showAttendanceNotes;\r\n\r\n                        response.DailyData = function () {\r\n                            return dailyData.shift();\r\n                        };\r\n\r\n                        $details.replaceWith(ich['ATT.Calendar.Day'](response))\r\n                            .initEvents();\r\n\r\n                        $calDetails.find('tr')\r\n                            .not('.empty-row')\r\n                            .filter(function () { return $(this).children().length == 0; })\r\n                            .remove();\r\n\r\n                        $calDetails.removeClass('loading')\r\n                    })\r\n                    .fail(function () {\r\n                        $calDetails.slideUp();\r\n                        $calendar.find('td.active').removeClass('active');\r\n                    });\r\n            }\r\n        },\r\n\r\n        MoveCalendarLeft: function (ev) {\r\n            var $active = $('#calendar-container').find('.calendar-sm.active');\r\n\r\n            if ($active.prev().length) {\r\n                $active.removeClass('active')\r\n                    .prev()\r\n                    .addClass('active');\r\n\r\n                PXP.ATT.RefreshCalendarPosition();\r\n            }\r\n        },\r\n\r\n        MoveCalendarRight: function (ev) {\r\n            var $active = $('#calendar-container').find('.calendar-sm.active');\r\n\r\n            var canScroll = $active.parent()[0].scrollWidth - $active.parent().scrollLeft() > $active.parent().outerWidth();\r\n            if (canScroll && $active.next().length) {\r\n                $active.removeClass('active')\r\n                    .next()\r\n                    .addClass('active');\r\n\r\n                PXP.ATT.RefreshCalendarPosition();\r\n            }\r\n        },\r\n\r\n        MoveCalendarToday: function (ev) {\r\n            var today = new Date();\r\n            today = new Date(today.getFullYear(), today.getMonth(), 1);\r\n            today = formatDate(today);\r\n\r\n            var $active = $('.calendar-sm')\r\n                .find('td.day[data-date=\"' + today + '\"]')\r\n                .closest('.calendar-sm');\r\n\r\n            if ($active.prev().length && $(window).width() >= MIN_WIDTH_FOR_2X_CALENDAR) {\r\n                $active = $active.prev();\r\n            }\r\n\r\n            $active.addClass('active')\r\n                .siblings()\r\n                .removeClass('active');\r\n\r\n            PXP.ATT.RefreshCalendarPosition();\r\n        },\r\n\r\n        MoveCalendar: function (ev) {\r\n            var date = $(this).closest('li').attr('data-date');\r\n\r\n            var $active = $('.calendar-sm')\r\n                .find('td.day[data-date=\"' + date + '\"]')\r\n                .closest('.calendar-sm');\r\n\r\n            if ($active.prev().length && $(window).width() >= MIN_WIDTH_FOR_2X_CALENDAR) {\r\n                $active = $active.prev();\r\n            }\r\n\r\n            $active.addClass('active')\r\n                .siblings()\r\n                .removeClass('active');\r\n\r\n            PXP.ATT.RefreshCalendarPosition();\r\n        }\r\n    });\r\n})(jQuery);\r\n\r\n(function ($) {\r\n    function getMonths(attData, currDate) {\r\n        var endDate = new Date(attData.Calendar.endDate);\r\n        var startDate = new Date(attData.Calendar.startDate);\r\n        var startMonth = new Date(startDate.getFullYear(), startDate.getMonth(), 1);\r\n\r\n        var months = [];\r\n        var prevYear;\r\n\r\n        while (startMonth < endDate) {\r\n            var isActive = startMonth.getMonth() == currDate.getMonth()\r\n                && startMonth.getFullYear() == currDate.getFullYear();\r\n\r\n            months.push({\r\n                ddActive: isActive ? 'active' : '',\r\n                ddDate: startMonth,\r\n                ddMonth: PXP.MONTH_NAMES[startMonth.getMonth()],\r\n                ddYear: (prevYear != startMonth.getFullYear()) ? startMonth.getFullYear() : null\r\n            });\r\n            \r\n            prevYear = startMonth.getFullYear();\r\n            startMonth = dateAdd(startMonth, 'm', 1);\r\n        }\r\n\r\n        return months;\r\n    }\r\n\r\n    $.fn.attCalendar = function (date, options) {\r\n        options = $.extend({\r\n            dayAction: '',\r\n            dayReasonAction: 'ATT.ToggleCalendarDetails',\r\n            onSelectedDatesChanged: function (calendar) { },\r\n            attData: PXP.StudentAttendanceData?.attendanceData\r\n        }, options);\r\n\r\n        function createData(table, month, year) {\r\n            var undef;\r\n            var now = new Date();\r\n            var today = formatDate(now);\r\n\r\n            // default values\r\n            year = year || now.getFullYear();\r\n            month = (month == undef) ? now.getMonth() : month;\r\n\r\n            var thisMonth = new Date(year, month, 1);\r\n            var nextMonth = new Date(year, month + 1, 1);\r\n            this.date = thisMonth;\r\n\r\n            var endDate = new Date(options.attData.Calendar.endDate);\r\n            var startDate = new Date(options.attData.Calendar.startDate);\r\n            dataOffset = Math.floor(timeSpan(toUTC(thisMonth) - toUTC(startDate)).days);\r\n\r\n            var dayIdx = -thisMonth.getDay();\r\n            var rows = [{ days: [] }, { days: [] }, { days: [] }, { days: [] }, { days: [] }, { days: [] }];\r\n\r\n            for (var w = 0; w < 6; w++) {\r\n                var days = rows[w].days;\r\n                for (var d = 0; d < 7; d++) {\r\n                    var currDate = dateAdd(thisMonth, 'd', dayIdx);\r\n\r\n                    if (currDate < thisMonth) {\r\n                        days.push({\r\n                            day: currDate.getDate(),\r\n                            date: formatDate(currDate),\r\n                            cssClass: 'prev-month',\r\n                            action: 'ATT.PrevMonth'\r\n                        });\r\n                    }\r\n                    else if (currDate >= nextMonth) {\r\n                        days.push({\r\n                            day: currDate.getDate(),\r\n                            date: formatDate(currDate),\r\n                            cssClass: 'next-month',\r\n                            action: 'ATT.NextMonth'\r\n                        });\r\n                    }\r\n                    else {\r\n                        var tableData = options.attData.Calendar.attData[dataOffset + dayIdx];\r\n\r\n                        var day = {\r\n                            holType: tableData && tableData.HolType,\r\n                            day: currDate.getDate(),\r\n                            date: formatDate(currDate),\r\n                            pending: tableData && tableData.Pending,\r\n                            cssClass: 'day',\r\n                            reasonType: tableData && tableData.Type.toString(),\r\n                            reason: tableData && (tableData.Reason || tableData.HolType),\r\n                            hasReason: function () {\r\n                                return this.reasonType && this.reasonType !== 4 && !this.holType;\r\n                            }\r\n                        };\r\n                        \r\n                        if (day.pending) {\r\n                            day.cssClass += ' pending';\r\n                        }\r\n\r\n                        if (day.hasReason()) {\r\n                            day.action = options.dayReasonAction;\r\n                        }\r\n                        else if (options.dayAction) {\r\n                            day.action = options.dayAction;\r\n                        }\r\n\r\n                        //Unverified = 0,\r\n                        //Unexcused = 1,\r\n                        //ExcusedTardy = 2,\r\n                        //UnexcusedTardy = 3,\r\n                        //NonEnrollment = 4,\r\n                        //Positive = 5,\r\n                        //Excused = 6,\r\n                        //SchoolActivity = 7,\r\n                        //EmergencyApproved = 8,\r\n                        //EmergencyUnapproved = 9,\r\n                        //Supplemental = 10,\r\n                        //NONE = 11,\r\n                        var types = ['UNV', 'UNX', 'TDY', 'TAR', 'NE', 'P', 'EXC', 'ACT', 'EMG', 'EMX', 'SUP', 'NA'];\r\n                        if (day.holType) {\r\n                            day['HOL'] = true;\r\n                        }\r\n                        else if (day.reasonType && tableData && tableData.Type < types.length) {\r\n                            day[types[tableData.Type]] = true;\r\n                        }\r\n                        else {\r\n                            day.reasonType = null;\r\n                        }\r\n\r\n                        if (!day.reasonType || day.reasonType == 4 || day.holType) {\r\n                            day.cssClass += ' disabled';\r\n                        }\r\n\r\n                        if (day.date == today) {\r\n                            day.cssClass += ' today';\r\n                        }\r\n\r\n                        days.push(day);\r\n                    }\r\n\r\n                    dayIdx++;\r\n                }\r\n            }\r\n\r\n            return {\r\n                months: getMonths(options.attData, thisMonth),\r\n                month: PXP.MONTH_NAMES[thisMonth.getMonth()],\r\n                year: thisMonth.getFullYear(),\r\n                showPrevMonth: thisMonth > startDate,\r\n                showNextMonth: nextMonth < endDate,\r\n                showPrevYear: thisMonth.getFullYear() > startDate.getFullYear(),\r\n                showNextYear: nextMonth.getFullYear() < endDate.getFullYear(),\r\n                rows: rows,\r\n                Translate: function () {\r\n                    return function (text, render) {\r\n                        var translations = (PXP.Translations || ST.Translations);\r\n                        return translations.Calendar[text];\r\n                    }\r\n                }\r\n            };\r\n        }\r\n\r\n        function calendar(el) {\r\n            $.extend(this, {\r\n                el: el,\r\n                $calWidget: $(el).children('.att-calendar'),\r\n                dataTable: $(el).find('table')[0],\r\n\r\n                selectedDates: []\r\n            });\r\n\r\n            if (this.$calWidget.length == 0) {\r\n                this.$calWidget = $('<div class=\"att-calendar\"></div>').prependTo(el);\r\n                this.$calWidget.data('attCalendar', this);\r\n            }\r\n\r\n            this.setDate(date || new Date());\r\n\r\n            if (options.multiSelect) {\r\n                var inst = this;\r\n\r\n                inst.$selectableDays = inst.$calWidget.find('.day')\r\n                    .not('.disabled')\r\n                    .filter(function () {\r\n                        var el = $(this).children('i')[0];\r\n\r\n                        var cls = el.getAttribute('class') || '';\r\n                        return !(el && cls.indexOf('att-icon') != -1);\r\n                    })\r\n                    .addClass('selectable');\r\n\r\n\r\n                inst.$selectableDays.each(function () {\r\n                    $(this).on({\r\n                        mousedown: function (ev) {\r\n                            if ($(this).hasClass('active')) {\r\n                                $(this).addClass('unhighlight');\r\n                            }\r\n                            else {\r\n                                $(this).addClass('highlight');\r\n                            }\r\n\r\n                            inst.startCell = this;\r\n                        },\r\n\r\n                        mouseenter: function (ev) {\r\n                            if (inst.startCell) {\r\n                                inst.highlightRange(inst.startCell, this);\r\n                            }\r\n                        },\r\n\r\n                        mouseup: function (ev) {\r\n                            inst.$calWidget.find('.highlight').addClass('active');\r\n                            inst.$calWidget.find('.unhighlight').removeClass('active');\r\n\r\n                            inst.selectedDates = [];\r\n                            inst.$calWidget.find('.day.active').each(function () {\r\n                                inst.selectedDates.push(this.getAttribute('data-date'));\r\n                            });\r\n\r\n                            options.onSelectedDatesChanged(inst);\r\n                        }\r\n                    });\r\n                });\r\n            }\r\n        }\r\n\r\n        calendar.prototype = {\r\n            setDate: function (date) {\r\n                this.date = date;\r\n                var attData = createData(this.dataTable, date.getMonth(), date.getFullYear());\r\n\r\n                this.$calWidget.empty().append(ich['ATT.Calendar'](attData));\r\n            },\r\n\r\n            prevMonth: function () {\r\n                this.setDate(dateAdd(this.date, 'm', -1));\r\n            },\r\n\r\n            nextMonth: function () {\r\n                this.setDate(dateAdd(this.date, 'm', 1));\r\n            },\r\n\r\n            prevYear: function () {\r\n                this.setDate(dateAdd(this.date, 'y', -1));\r\n            },\r\n\r\n            nextYear: function () {\r\n                this.setDate(dateAdd(this.date, 'y', 1));\r\n            },\r\n\r\n            highlightRange: function (start, end) {\r\n                var bHighlightClass = $(start).hasClass('highlight') ? 'highlight' : 'unhighlight';\r\n                var bMarkDay = false;\r\n                var $days = this.$selectableDays || this.$calWidget.find('.day');\r\n\r\n                $days.not(start).removeClass(bHighlightClass);\r\n                $days.each(function () {\r\n                    if (bMarkDay || this === end || this === start) {\r\n                        $(this).addClass(bHighlightClass);\r\n                    }\r\n\r\n                    if (this === start || this === end) {\r\n                        bMarkDay = !bMarkDay;\r\n                    }\r\n                });\r\n            }\r\n        };\r\n\r\n        return this.each(function () {\r\n            this.calendar = new calendar(this);\r\n        });\r\n    };\r\n\r\n    $.fn.pxpStackedBarGraph = function (opts) {\r\n        function buildGraphDataFromTable($table) {\r\n            var res = {\r\n                labels: [],\r\n   