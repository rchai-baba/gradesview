            "text": "(function ($) {\r\n    var FORM_ID = 0;\r\n\r\n    $.extend(Namespace('PXP.Actions.ATT'), {\r\n        AttachNote: function (ev) {\r\n            var $form = $(this).closest('form');\r\n\r\n            $form.attr('ACTION', 'service/PXP2Communication.asmx/UploadDocument');\r\n            $form.attr('METHOD', 'POST');\r\n\r\n            var id = 'form' + FORM_ID++;\r\n            $form.attr('target', id);\r\n\r\n            var frameHTML = '<iframe name=\"' + id + '\" id=\"' + id + '\" width=\"0\" height=\"0\" frameborder=\"0\" src=\"ST_Loading.html\" style=\"position:absolute;visibility: hidden; left:-100px\"></iframe>';\r\n            var $iframe = $(frameHTML).appendTo(document.body);\r\n\r\n            // Get or create the xml input element\r\n            var jsonInput = $form.find('input[name=\"data\"]')[0] || $('<input type=\"hidden\" name=\"data\" />').appendTo($form)[0];\r\n            jsonInput.value = JSON.stringify({\r\n            });\r\n\r\n            var fileInput = this;\r\n            $iframe.on('load', function () {\r\n                $form.closest('.upload-control').addClass('uploaded');\r\n\r\n                var fname = $($iframe[0].contentDocument.documentElement).fastFind('FileName').text();\r\n                $form.fastFind('.filename').text(fname);\r\n\r\n                fileInput.value = '';\r\n                $iframe.remove();\r\n            });\r\n\r\n            setTimeout(function () {\r\n                $form.submit();\r\n            }, 0);\r\n        },\r\n\r\n        RemoveNote: function (ev) {\r\n            $(this).closest('.upload-control').removeClass('uploaded');\r\n            ST.SendServerEvent(null, 'PXP_Remove_Note', {});\r\n        },\r\n\r\n        CreateAndShowAbsenceDialog: function (templateId, attData, $aguElement) {\r\n            const today = new moment().format('MM/DD/YYYY');\r\n\r\n            if (attData.NotesAreMandatory === undefined && attData.attendanceReasonOptions) {\r\n                attData.NotesAreMandatory = attData.attendanceReasonOptions.NotesAreMandatory;\r\n            }\r\n\r\n            const templateData = $.extend({\r\n                agu: attData.agu || ($aguElement ? $aguElement.attr('data-agu') : undefined) || PXP.AGU,\r\n                today: today,\r\n                showUploadControl: PXP.AllowAbsenceNote,\r\n                ShowPeriodColumn: (attData.pastAttendanceData?.filter(ad => ad.AttendancePeriod !== 'Daily').length > 0),\r\n                StudentFirstName: attData.name,\r\n                AttendanceReasonOpts: attData.attendanceReasonOptions,\r\n                FormattedDate: function () {\r\n                    return new moment(this.AttendanceDate).format('MM/DD/YYYY');\r\n                },\r\n                Translate: function () {\r\n                    return function (text, render) {\r\n                        return (PXP.Translations.ReportAbsences[text] ?? text)\r\n                            .replace('@STUDENT_FIRST_NAME@', attData.name);\r\n                    };\r\n                }\r\n            }, attData);\r\n\r\n            const $dlg = ich[templateId](templateData);\r\n            $(document.body).append($dlg);\r\n\r\n            const $date = $dlg.find('.date');\r\n            $date.first().val(today);\r\n\r\n            $date.eq(0).attDatepicker({\r\n                inputStart: $date[0],\r\n                inputEnd: $date[1],\r\n                startDate: attData.attendanceReasonOptions?.StartDate,\r\n                endDate: attData.attendanceReasonOptions?.EndDate,\r\n                onClick: function (ev, datePicker) {\r\n                    if ($(this).hasClass('end')) {\r\n                        const reasonTypes = $('.att-dropdown-reasontypes');\r\n\r\n                        if (!reasonTypes.attr('data-value')) {\r\n                            setTimeout(function () {\r\n                                $('.att-dropdown-reasontypes').addClass('open');\r\n                            }, 0);\r\n                        }\r\n                    }\r\n                }\r\n            });\r\n            $date.trigger('change');\r\n\r\n            $dlg.data('attData', attData);\r\n            $dlg.modal();\r\n            $dlg.on('hidden.bs.modal', function () {\r\n                $dlg.remove();\r\n            });\r\n\r\n            return $dlg;\r\n        },\r\n\r\n        ShowAbsenceDialog: function (ev, attData) {\r\n            const $el = $(this).closest('[data-agu]');\r\n\r\n            if (!attData) {\r\n                attData = PXP.StudentAttendanceData?.stuAttendanceDetails ?? ko.dataFor($el[0]) ?? {};\r\n            }\r\n\r\n            PXP.Actions.ATT.CreateAndShowAbsenceDialog('PXP.ATT.ReportAbsenceDialog', attData, $el);\r\n        },\r\n\r\n        ToggleReportAbsenceType: function (ev) {\r\n            const $modal = $(this).closest('.modal');\r\n            const attData = $modal.data('attData') ?? (typeof ko !== 'undefined' ? ko.dataFor($modal[0]) : undefined) ?? {};\r\n            const type = $modal.attr('input-type') || '';\r\n            const closeBtn = $modal[0].querySelector('[data-dismiss=\"modal\"]');\r\n\r\n            if (closeBtn && type) {\r\n                closeBtn.click();\r\n\r\n                let tmpId;\r\n                if (type === 'future') {\r\n                    if (attData.pastAttendanceData?.length < 1) return;\r\n                    tmpId = 'PXP.ATT.ReportPastAbsencesDialog';\r\n                }\r\n                else {\r\n                    tmpId = 'PXP.ATT.ReportFutureAbsenceDialog';\r\n                }\r\n\r\n                PXP.Actions.ATT.CreateAndShowAbsenceDialog(tmpId, attData);\r\n            }\r\n        },\r\n\r\n        SelectReasonType: function (ev) {\r\n            const $dd = $(this).closest('.dropdown');\r\n\r\n            $dd.attr('data-value', this.getAttribute('data-id'));\r\n            $dd.find('.btn-content').html($(this).html());\r\n            $dd.trigger('change');\r\n            $dd.removeClass('open');\r\n        },\r\n\r\n        SavePastReportAbsence: function (ev) {\r\n            const $modal = $(this).closest('.modal');\r\n            const attData = $modal.data('attData');\r\n\r\n            const rows_to_remove = [];\r\n            const reasons = [];\r\n\r\n            $modal.fastFind('.pxp-absence-table tr').each(function () {\r\n                const date = this.getAttribute('data-date');\r\n                const reason = this.querySelector('.att-dropdown-reasontypes')?.getAttribute('data-value');\r\n\r\n                if (date && reason) {\r\n                    rows_to_remove.push(this);\r\n                    reasons.push({\r\n                        '@DATE': date,\r\n                        '@REASON': reason\r\n                    });\r\n                }\r\n            });\r\n\r\n            const $note = $modal.find('textarea');\r\n\r\n            function checkCondition(input, isValid, errMsg) {\r\n                if (isValid) {\r\n                    ST.ShowMessage(errMsg, PXP.Translations.ReportAbsences.Error)\r\n                        .done(function () {\r\n                            setTimeout(function () {\r\n                                input.focus();\r\n                            }, 0);\r\n                        });\r\n                }\r\n\r\n                return !isValid;\r\n            }\r\n\r\n            if (reasons.length === 0) {\r\n                ST.ShowMessage(PXP.Translations.ReportAbsences.ErrMissingReason);\r\n                return;\r\n            }\r\n\r\n            if (checkCondition($note, $note.parent().hasClass('mandatory')\r\n                && !$note.val().trim(), PXP.Translations.ReportAbsences.ErrMissingNote)\r\n            ) {\r\n                ST.SendServerEvent(null, 'PXP_Submit_Past_Absences',\r\n                    {\r\n                        '@AGU': $modal.attr('data-agu'),\r\n                        '@NOTE': $note.val(),\r\n                        'REASON': reasons,\r\n                    })\r\n                    .done(function (res) {\r\n                        res = res.documentElement;\r\n\r\n                        $(rows_to_remove).remove();\r\n                        const remainingRows = $modal.fastFind('.pxp-absence-table tr[data-date]').length;\r\n\r\n                        // remove these rows from the underlying data model\r\n                        if (attData?.pastAttendanceData) {\r\n                            const rows = rows_to_remove.map(r => r.getAttribute('data-date'));\r\n                            attData.pastAttendanceData = attData.pastAttendanceData\r\n                                .filter(ad => !rows.includes(ad.AttendanceDate))\r\n                        }\r\n\r\n                        if (remainingRows === 0) {\r\n                            $modal.modal('hide');\r\n                        }\r\n\r\n                        var msg = res.getAttribute('MESSAGE')\r\n                            || PXP.Translations.ReportAbsences.Saved;\r\n\r\n                        ST.ShowMessage(msg, PXP.Translations.ReportAbsences.ReportAbsences)\r\n                            .done(function () {\r\n                                if (PXP.OnReportAbsenceComplete && remainingRows === 0) {\r\n                                    PXP.OnReportAbsenceComplete();\r\n                                }\r\n                            });\r\n                    })\r\n                    .fail(function () {\r\n                        $.pnotify_error(PXP.Translations.ReportAbsences.ErrUnableToSave);\r\n                    });\r\n            }\r\n        },\r\n\r\n        SaveReportAbsence: function (ev) {\r\n            var $modal = $(this).closest('.modal');\r\n            var $date = $modal.find('input.date');\r\n\r\n            var $reasonTypes = $modal.find('.att-dropdown-reasontypes');\r\n            var reason = $reasonTypes.attr('data-value');\r\n            var $note = $modal.find('textarea');\r\n\r\n            function checkCondition(input, isValid, errMsg) {\r\n                if (isValid) {\r\n                    ST.ShowMessage(errMsg, PXP.Translations.ReportAbsences.Error)\r\n                        .done(function () {\r\n                            setTimeout(function () {\r\n                                input.focus();\r\n                            }, 0);\r\n                        });\r\n                }\r\n\r\n                return !isValid;\r\n            }\r\n\r\n            if (checkCondition($date.eq(0), !($date[0].value || $date[1].value), PXP.Translations.ReportAbsences.ErrMissingDate)\r\n                && checkCondition($reasonTypes.children('.btn'), !reason, PXP.Translations.ReportAbsences.ErrMissingReason)\r\n                && checkCondition($note, $note.parent().hasClass('mandatory') && !$note.val().trim(), PXP.Translations.ReportAbsences.ErrMissingNote)\r\n            ) {\r\n                ST.SendServerEvent(null, 'PXP_Submit_Absences',\r\n                    {\r\n                        '@AGU': $modal.attr('data-agu'),\r\n                        '@REASON': reason,\r\n                        '@NOTE': $note.val(),\r\n                        '@START_DATE': $date.eq(0).val(),\r\n                        '@END_DATE': $date.eq(1).val()\r\n                    })\r\n                    .done(function (res) {\r\n                        res = res.documentElement;\r\n\r\n                        $modal.modal('hide');\r\n\r\n                        var msg = res.getAttribute('MESSAGE')\r\n                            || PXP.Translations.ReportAbsences.Saved;\r\n\r\n                        ST.ShowMessage(msg, PXP.Translations.ReportAbsences.ReportAbsences)\r\n                            .done(function () {\r\n                                if (PXP.OnReportAbsenceComplete) {\r\n                                    PXP.OnReportAbsenceComplete();\r\n                                }\r\n                            });\r\n                    })\r\n                    .fail(function () {\r\n                        $.pnotify_error(PXP.Translations.ReportAbsences.ErrUnableToSave);\r\n                    });\r\n            }\r\n        },\r\n    });\r\n\r\n    ST.RegisterXMLParser('.*?/REV_DATA_ROOT', function (node) {\r\n    });\r\n})(jQuery);\r\n\r\n(function ($) {\r\n    function attDatepicker(opts) {\r\n        var inst = this;\r\n        this.options = opts = $.extend({\r\n            onClick: function (ev, datePicker) { }\r\n        }, opts);\r\n\r\n        this.currentMonth = 0;\r\n        this.el = opts.inputStart;\r\n        this.createElement();\r\n\r\n        var inst = this;\r\n        $(this.el).add(opts.inputEnd).on({\r\n            focus: function (ev) {\r\n                inst.show(this);\r\n            },\r\n            click: function (ev) {\r\n                inst.show(this);\r\n            },\r\n            change: function (ev) {\r\n                var val = $(this).val();\r\n                if (val) {\r\n                    val = new moment(val, \"MM/DD/YYYY\").format('MM/DD/YYYY');\r\n                    $(this).val(val);\r\n\r\n                    var $dt = inst.$dp.find('.day[data-date=\"' + val + '\"]');\r\n                    if ($dt.length) {\r\n                        if (this === opts.inputEnd) {\r\n                            inst.setEnd($dt[0]);\r\n                        }\r\n                        else {\r\n                            inst.setStart($dt[0]);\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        });\r\n    }\r\n\r\n    attDatepicker.prototype = {\r\n        createElement: function () {\r\n            var months = [];\r\n            var start = new moment(this.options.startDate, \"MM/DD/YYYY\").startOf('month');\r\n            var end = new moment(this.options.endDate, \"MM/DD/YYYY\").startOf('month');\r\n            while (start <= end) {\r\n                months.push(this.buildCalendar(start.format('MM/DD/YYYY')));\r\n                start.add(1, 'month');\r\n            }\r\n\r\n            var inst = this;\r\n            this.$dp = ich['ATT.DatePicker']({ months: months })\r\n                .addClass('hidden')\r\n                .on('mousedown', function (ev) {\r\n                    ev.stopPropagation();\r\n                })\r\n                .delegate('.day:not(.disabled)', 'click', function (ev) {\r\n                    if (inst.options.inputEnd) {\r\n                        if (inst.options.inputStart === inst.targetInput) {\r\n                            inst.setStart(this);\r\n\r\n                            setTimeout(function () {\r\n                                inst.show(inst.options.inputEnd);\r\n                                inst.options.inputEnd.focus();\r\n                            }, 0);\r\n                        }\r\n                        else if (inst.options.inputEnd === inst.targetInput) {\r\n                            inst.setEnd(this);\r\n\r\n                            setTimeout(function () {\r\n                                inst.hide();\r\n                            }, 0);\r\n                        }\r\n                    }\r\n                    else {\r\n                        $(this).toggleClass('sel');\r\n                    }\r\n\r\n                    inst.targetInput.value = this.getAttribute('data-date');\r\n                    inst.options.onClick.call(this, ev, inst);\r\n                })\r\n                .appendTo(document.body);\r\n\r\n            this.$months = this.$dp.children('.att-dp-calendar');\r\n\r\n            this.$prev = this.$dp.children('.scroller.prev-month');\r\n            this.$prev.on('click', function (ev) {\r\n                inst.selectMonth(inst.currentMonth - 1);\r\n            });\r\n\r\n            this.$next = this.$dp.children('.scroller.next-month');\r\n            this.$next.on('click', function (ev) {\r\n                inst.selectMonth(inst.currentMonth + 1);\r\n            });\r\n        },\r\n\r\n        show: function (input) {\r\n            this.targetInput = input;\r\n            $(document.body).find('.att-datepicker').addClass('hidden');\r\n\r\n            this.selectMonth(this.currentMonth || 0);\r\n            this.$dp.removeClass('hidden')\r\n                .position({\r\n                    my: 'left top',\r\n                    at: 'left bottom',\r\n                    of: input,\r\n                    collision: 'flip flip'\r\n                });\r\n        },\r\n\r\n        hide: function () {\r\n            if (this.$dp) {\r\n                this.$dp.addClass('hidden');\r\n            }\r\n        },\r\n\r\n        selectMonth: function (month) {\r\n            this.currentMonth = Math.min(this.$months.length - 1, Math.max(month, 0));\r\n\r\n            this.$months.eq(this.currentMonth).addClass('active').siblings('.active').removeClass('active');\r\n            this.$prev.toggleClass('active', this.currentMonth > 0);\r\n            this.$next.toggleClass('active', this.currentMonth < this.$months.length - 2);\r\n        },\r\n\r\n        setStart: function (el) {\r\n            var $days = this.$dp.find('.day');\r\n\r\n            $days.not(el).filter('.start').removeClass('start');\r\n            $(el).toggleClass('start');\r\n\r\n            this.selectRange();\r\n        },\r\n\r\n        setEnd: function (el) {\r\n            var $days = this.$dp.find('.day');\r\n\r\n            $days.not(el).filter('.end').removeClass('end');\r\n            $(el).toggleClass('end');\r\n\r\n            this.selectRange();\r\n        },\r\n\r\n        selectRange: function () {\r\n            var $days = this.$dp.find('.day');\r\n            $days.filter('.sel').removeClass('sel');\r\n\r\n            var start = $days.filter('.start')[0];\r\n            var end = $days.filter('.end')[0];\r\n            if (start && end && start !== end) {\r\n                var bSelecting = false;\r\n                $days.each(function () {\r\n                    if (this === start || this === end) {\r\n                        bSelecting = !bSelecting;\r\n                        $(this).addClass('sel');\r\n                    }\r\n                    else if (bSelecting) {\r\n                        $(this).addClass('sel');\r\n                    }\r\n                });\r\n            }\r\n        },\r\n\r\n        buildCalendar: function (date) {\r\n            var m = new moment(date, \"MM/DD/YYYY\").startOf('month');\r\n            var monthStart = new moment(date, \"MM/DD/YYYY\");\r\n\r\n            var dtStart = new moment(this.options.startDate, \"MM/DD/YYYY\");\r\n            var dtEnd = new moment(this.options.endDate, \"MM/DD/YYYY\");\r\n\r\n            var calendar = {\r\n                month: PXP.MONTH_NAMES ? PXP.MONTH_NAMES[m.month()] : m.format('MMMM'),\r\n                year: m.format('YYYY'),\r\n                weeks: []\r\n            };\r\n\r\n            var weekday = -m.isoWeekday();\r\n            m.add(weekday, 'day');\r\n\r\n            for (var w = 0; w < 6; w++) {\r\n                var week = { days: [] };\r\n                calendar.weeks.push(week);\r\n\r\n                for (var i = 0; i < 7; i++) {\r\n                    var disabled = '';\r\n                    if (m < dtStart || m > dtEnd) {\r\n                        disabled = 'disabled';\r\n                    }\r\n                    else if (m.month() !== monthStart.month()) {\r\n                        disabled = 'other-month';\r\n                    }\r\n\r\n                    week.days.push({\r\n                        day: m.date(),\r\n                        date: m.format('MM/DD/YYYY'),\r\n                        disabled: disabled\r\n                    });\r\n                    m.add(1, 'day');\r\n                }\r\n\r\n                if (m.month() !== monthStart.month()) {\r\n                    break;\r\n                }\r\n            }\r\n\r\n            return calendar;\r\n        }\r\n\r\n    };\r\n\r\n    $.fn.attDatepicker = function (opts) {\