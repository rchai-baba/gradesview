\":false,\"SecurityLevelMTSS\":false,\"RoleIds\":[],\"isTVUEAdmin\":false,\"SynergyUserGradeBookEditRights\":1,\"TVUEAdminAccess\":{\"Id\":null,\"Priority\":0,\"Name\":\"Default\"},\"ASMTBankFeedbackOptions\":false,\"ASMTDataAccess\":{\"Id\":null,\"Priority\":0,\"Name\":\"Default\"},\"GBShowAllStudentsForFocusedPivotReport\":false,\"GBAdditionalAccessCurrentYear\":{\"Id\":null,\"Priority\":0,\"Name\":\"Default\"},\"GBAdditionalAccessPreviousYears\":{\"Id\":null,\"Priority\":0,\"Name\":\"Default\"},\"GBReportCardMarksEditing\":false,\"GBThirdPartyAccessReadOnly\":false,\"LVCanEditElements\":false},\"application\":{\"isCurriculumModuleEnabled\":false,\"isAnalyticsModuleEnabled\":false,\"isStreamsEnabled\":false,\"isAssessmentModuleEnabled\":false,\"isLMSIntegrationEnabled\":true,\"isRTIModuleEnabled\":true},\"focus\":{\"gradingPeriodId\":309,\"gradeBookId\":0,\"studentId\":7384,\"FirstName\":null,\"LastName\":null,\"SchoolName\":\"Herbert Henry Dow High School\",\"ClassName\":\"(S2) Smallfield, J  AP Advanced Chemistry H (1 hr)(3) SEC:SC5422-1\",\"CurrentStudentName\":null,\"isSpecialist\":false,\"isTeacher\":false,\"isPrincipal\":false,\"isReadOnly\":false,\"readOnlyReason\":\"\"},\"requestAppToken\":\"StudentVUE\",\"pad\":{\"screenCaptureButtonVisible\":true,\"useNewPTCBeta\":true}};\r\n\r\n    gbapp.whenAvailable(\"window.COMPONENT_LOADER\", function() {\r\n        // all loaders should not display the component-injector because that will double up injected components. remove it from the DOM before binding so there are no subscriptions.\r\n        $(\".component-loader-container #component-injector-container:gt(0)\").remove();\r\n\r\n        //we are loading a second component loader on the page. the only thing we need to do is apply bindings to the new area.\r\n        if ($(\".component-loader-container[data-bound!='true']\").length > 0) {\r\n            ko.applyBindings(document.rootViewModel, $(\".component-loader-container[data-bound!='true']\").get(0));\r\n        }\r\n    });\r\n\r\n</script>\r\n\r\n<script data-main='/txpapp/scripts.require.config.js?2026-03-29T12%3a03%3a23.0000000' src='/txpapp/scripts.require.js?2026-03-29T12%3a03%3a23.0000000'></script>\r\n\r\n\r\n\r\n    </div>\r\n\r\n    <footer id=\"ctl00_ctl00_PXPFooter\" class=\"footer hide-for-print\" aria-label=\"Footer\">\r\n        <div class=\"action-bar\">\r\n            <div role=\"region\" aria-label=\"System links\" id=\"SystemLinks\">\r\n                <ul class=\"system-links\">\r\n                    \r\n                        <li><a href=\"Login_Student_PXP.aspx?Logout=1\" id=\"ctl00_ctl00_lnkLogin\">Logout</a></li>\r\n                    \r\n                    <li><a href=\"PXP2_Contact.aspx\" id=\"ctl00_ctl00_lnkContact\">Contact</a></li>\r\n                    <li><a href=\"PXP2_Privacy.aspx\" id=\"ctl00_ctl00_lnkPrivacy\">Privacy</a></li>\r\n                </ul>\r\n            </div>\r\n\r\n            \r\n\r\n\r\n<div id=\"ctl00_ctl00_ctl10_LanguagesDropDown\" class=\"languagesDropDown\" role=\"region\" aria-label=\"Languages\">\r\n    <div class=\"btn-group dropup\">\r\n        <button type=\"button\" class=\"btn btn-default dropdown-toggle\" data-toggle=\"dropdown\" onclick='handleLanguageDropDownClick(event)' aria-haspopup=\"true\" aria-expanded=\"false\">\r\n            <span>English</span>\r\n            <span class=\"fa fa-caret-down\" role=\"presentation\"></span>\r\n        </button>\r\n        <div class=\"dropdown-menu\" style=\"max-height:400px;overflow:auto;\">\r\n            <ul class=\"languageList list-group\" id=\"language-list\">\r\n            \r\n            <li data-selected=\"True\">\r\n                <a class=\"dropdown-item\" title=\"English\" onclick='handleLanguageChange(\"00\", event)'>English</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Arabic\" onclick='handleLanguageChange(\"ara\", event)'>Arabic</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Chinese\" onclick='handleLanguageChange(\"chi\", event)'>Chinese</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"French\" onclick='handleLanguageChange(\"fre\", event)'>Français</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"German\" onclick='handleLanguageChange(\"ger\", event)'>German</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Hindi\" onclick='handleLanguageChange(\"hin\", event)'>Hindi</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Korean\" onclick='handleLanguageChange(\"kor\", event)'>Korean</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Portuguese\" onclick='handleLanguageChange(\"por\", event)'>Portuguese</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Spanish\" onclick='handleLanguageChange(\"spa\", event)'>Spanish</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Albanian\" onclick='handleLanguageChange(\"alb\", event)'>Albanian</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Bengali\" onclick='handleLanguageChange(\"ben\", event)'>Bengali</a>\r\n            </li>\r\n            \r\n            <li data-selected=\"False\">\r\n                <a class=\"dropdown-item\" title=\"Bulgarian\" onclick='handleLanguageChange(\"b