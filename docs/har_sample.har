essage = function (msg, allowDelete, gradeBookId) {\r\n                        //show modal dialog with message and delete button.\r\n                        var $btn = $('<div>').dxButton({\r\n                            text: 'Delete',\r\n                            type: 'danger',\r\n                            icon: 'close',\r\n                            onClick: function () {\r\n                                app.alertInfo('Deleting Item...');\r\n                                app.call('gradebook.course.content.item', 'DeleteItem', { gradeBookId: gradeBookId })\r\n                                    .done(function () {\r\n                                        location.assign('gradebook/grid');\r\n                                    });\r\n                            }\r\n                        });\r\n                        var $content = $('<div>').html(msg).append('<div>').append($btn);\r\n                        var dlg = app.dialog('Confirm Delete', $content);\r\n                        dlg.open();\r\n                    };\r\n                    app.call('gradebook.grid2', 'menuCommand', { menuText: 'edit assignment', gradeBookId: courseItemVm.itemID }).done(function (data) {\r\n                        if (courseItemVm.action !== 'Edit Item') {\r\n                            var popup = new app.popup('Course Item Grades', 'gradebook.course.item.scores.grid', {\r\n                                config: { isRichContentEnabled: isRichContentEnabled }\r\n                            }, {\r\n                                onHidden: function (e) {\r\n                                    if (typeof closeCallback === 'function') {\r\n                                        closeCallback();\r\n                                    }\r\n                                },\r\n                                width: '100%',\r\n                                height: '100%'\r\n                            });\r\n                            popup.open();\r\n           