          "cookies": [],
          "content": {
            "mimeType": "text/html; charset=utf-8",
            "size": 74198,
            "text": "\r\n<!DOCTYPE html>\r\n\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\">\r\n<head><meta http-equiv=\"content-type\" content=\"text/html; charset=utf-8\" /><meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" /><meta name=\"viewport\" content=\"width=device-width, user-scalable=yes\" /><title>\r\n\tStudentVUE\r\n</title><meta content=\"en-US\" name=\"language\" /><meta content=\"private - general audiences\" name=\"rating\" /><meta content=\"2005 - Edupoint,Inc\" name=\"copyright\" /><meta content=\"Edupoint, LLC\" name=\"author\" /><link rel=\"Shortcut Icon\" href=\"synergy.ico\" /><link rel=\"stylesheet\" href=\"/schemes/ST/Themes/Light.css\" type=\"text/css\" id=\"CssTheme\"/>\r\n\r\n\r\n    <script type=\"text/javascript\">\r\n        var OEN = { Configurations: {} };\r\n        window.PXP = window.PXP || { Translations: {} };\r\n        window.ST = window.ST || {};\r\n        window.ST.Translations = window.ST.Translations || {};\r\n        ST.NFAList = ST.NFAGlobalList = '<REV_RETURN/>';\r\n\r\n        PXP.AGU = '';\n\tPXP.Translations.GBNoData = 'No Data';\n\tPXP.Translations.ReportAbsence = 'Report Absence';\n\tPXP.Translations.GBRecentHistory = 'Recent History';\n\tPXP.ChildOrgYearGU = '2973E8BD-AFFF-4AB0-BED3-882607415DCE';\n\tPXP.Translations.No = 'No';\n\tPXP.Translations.Yes = 'Yes';\n\tPXP.Translations.FlexCountModalTitle = 'Flex Scheduling';\n\tPXP.Translations.FlexCountModalContent = 'You are missing requests for some flex scheduling periods.  Would you like to make them now?';\n\tPXP.VerifyFlexCount = true;\n\tPXP.UseGoogleAPI = true;\n\tST.Impersonated = false;\n\tST.SessionLength = 20;\n\tPXP.SessionTimeout = 3600;\n\tST.ResourceCacheString = '2026-03-29T12%3a03%3a23.0000000';\n\tST.Authorization = {\r\n  \"access_token\": \"authorized\"\r\n};\n\tPXP.StreamsEnabled = false;\n\tPXP.IncludeAdditionalStaffWhenEmailingTeachers = true;\n\tapplicationRoot = '/';\n\tCURRENT_WEB_PORTAL = 'StudentVUE';\n\tPXP.Translation